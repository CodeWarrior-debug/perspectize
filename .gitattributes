# Normalize line endings repo-wide to LF; Git converts on checkin,
# working-tree files stay whatever the OS/editor uses.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.bat text eol=crlf

# Explicit binary types (also auto-detected, but pin them to be safe).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# gqlgen output stays tracked (builds need it) but is collapsed in PR diffs
# and left out of PR line counts so reviewers read only hand-written code.
backend/internal/adapters/graphql/generated/generated.go linguist-generated=true
backend/internal/adapters/graphql/model/models_gen.go linguist-generated=true
