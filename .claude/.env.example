# .claude/.env — local-only config for Claude Code self-verify tooling.
#
# Copy to .claude/.env (gitignored) and fill in real values. This template is
# tracked in a PUBLIC repo, so it must never contain real credentials.
#
# Consumed by .claude/scripts/sv-chrome.sh and by Claude when the persistent
# self-verify browser profile (.claude/sv-profile/) has no valid session and
# needs a fresh sign-in as the dedicated throwaway test user.

# Dedicated self-verify test user (Clerk dev instance — not a real person,
# no production data). Throwaway account; rotate freely.
SV_TEST_USER_EMAIL=you+clerktest@example.com
SV_TEST_USER_PASSWORD=

# Clerk dev-instance fixed email-code. Any dev instance accepts this constant;
# it is not a secret. Leave as-is unless the instance overrides it.
SV_TEST_USER_OTP=424242
