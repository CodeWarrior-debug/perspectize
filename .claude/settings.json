{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(kill:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(pkill:*)",
      "Bash(pwd:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(wc:*)",
      "Bash(yes:*)",
      "Bash(cd:*)",
      "Bash(rm -f:*)",
      "Bash(rm -rf .svelte-kit:*)",
      "Bash(rm -rf build:*)",
      "Bash(rm -rf dist:*)",
      "Bash(rm -rf frontend/.svelte-kit:*)",
      "Bash(rm -rf frontend/build:*)",
      "Bash(rm -rf frontend/dist:*)",
      "Bash(rm -rf frontend/node_modules:*)",
      "Bash(rm -rf frontend/.vite:*)",
      "Bash(rm -rf frontend/coverage:*)",
      "Bash(rm -rf node_modules:*)",
      "Bash(rm package-lock.json:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rm:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git tag:*)",
      "Bash(gh api:*)",
      "Bash(gh release:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(go build:*)",
      "Bash(go fmt:*)",
      "Bash(go mod:*)",
      "Bash(go run:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(make:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__click",
      "mcp__chrome-devtools__fill",
      "mcp__chrome-devtools__press_key",
      "mcp__chrome-devtools__evaluate_script",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__resize_page",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__hover",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__get_network_request"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.secret)",
      "Read(.claude/sv-profile/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/monthly-routine-check.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/deny-env-read.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/prettier-precommit.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/require-tests.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/require-session-reflection-before-pr.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/gsd-statusline.js"
  },
  "enabledPlugins": {
    "hookify@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true
  },
  "enabledMcpjsonServers": [
    "sevalla"
  ]
}
