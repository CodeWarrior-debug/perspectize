{
  "type": {
    "label": "Book",
    "enumValue": "BOOK",
    "icon": "book",
    "accent": "#8B5E3C"
  },
  "meta": {
    "date": "2026-11-09",
    "sources": [
      "docs/superpowers/specs/2026-11-09-book-content-type-discover-design.md",
      "Open Library search.json / trending/weekly.json, fetched live 2026-11-09"
    ],
    "note": "Proposed type; nothing is built. East of Eden, Atomic Habits, Make a zine! and Brainscan are real Open Library records fetched live 2026-11-09 (search.json for East of Eden/Make a zine!/Brainscan, trending/weekly.json for Atomic Habits). Perspective counts and 'otherPerspectives' are illustrative."
  },
  "columns": [
    {
      "id": "pz",
      "kind": "perspectize",
      "status": "shipped",
      "header": {
        "body": "Add or edit your perspective on this book. Filled when you already have one.",
        "src": "derived: perspectives WHERE content_id AND user_id"
      }
    },
    {
      "id": "item",
      "kind": "item",
      "label": "Book",
      "status": "proposed",
      "header": {
        "body": "Title with the Open Library cover, author underneath. No cover shows the type glyph. Sorts A to Z.",
        "src": "content.name + response.authorName[0] + response.coverId"
      }
    },
    {
      "id": "published",
      "kind": "num",
      "label": "Published",
      "status": "proposed",
      "header": {
        "body": "First publish year. Sorts oldest/newest; unknown sorts last.",
        "src": "response.firstPublishYear"
      },
      "cell": {
        "src": "response.firstPublishYear",
        "whenEmpty": "Open Library has no first-publish year on record."
      }
    },
    {
      "id": "pages",
      "kind": "num",
      "label": "Pages",
      "status": "proposed",
      "header": {
        "body": "Median page count across all editions Open Library has indexed for this work, not a specific printing.",
        "src": "response.pageCountMedian"
      },
      "cell": {
        "src": "response.pageCountMedian",
        "whenEmpty": "No page count across any indexed edition."
      }
    },
    {
      "id": "rating",
      "kind": "num",
      "label": "Rating",
      "status": "proposed",
      "header": {
        "body": "Open Library community rating out of 5. Muted under 5 ratings — this community's rating counts are far sparser than TMDB's, so the usual \"low sample\" dimming kicks in much earlier here.",
        "src": "response.ratingsAverage + response.ratingsCount",
        "extra": "Decision to confirm: dimming threshold is a guess, not measured."
      },
      "cell": {
        "src": "response.ratingsAverage",
        "whenEmpty": "No community ratings yet."
      }
    },
    {
      "id": "subjects",
      "kind": "tags",
      "label": "Subjects",
      "status": "proposed",
      "header": {
        "body": "Open Library's crowdsourced subject tags, as chips. An external-source tag set (like Movie's TMDB keywords) — overlaps issue #560 (separating source tags from user tags).",
        "src": "response.subjects[]"
      },
      "cell": {
        "src": "response.subjects[]",
        "whenEmpty": "No subjects recorded for this work."
      }
    }
  ],
