#!/bin/sh
# Pre-push hook: clean up comments that cite tickets or narrate history, so a push
# never ends on them. Activated by: git config core.hooksPath .hooks (make install-hooks).
#
# Scans the lines the pushed commits add (.hooks/comment-history-scan.sh). Ticket, PR and
# issue references (HARD) always block. History wording (SOFT) is judged by a headless
# `claude -p` run following .claude/skills/comment-hygiene/SKILL.md; a SOFT line the model
# leaves alone is its verdict and the push goes ahead.
#
# When the model edits comments, the fix lands as an amend (the tip commit alone introduced
# every hit) or as a separate `chore` commit, and THIS push is aborted: the pushed sha no
# longer matches. Review `git show`, then run `git push` again.
# Escape hatches: `history-ok: <reason>` on the line, or `git push --no-verify`.

[ -n "$PERSPECTIZE_COMMENT_HOOK" ] && exit 0

HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
ROOT=$(git rev-parse --show-toplevel)
SCAN="$HOOK_DIR/comment-history-scan.sh"
RUBRIC="$ROOT/.claude/skills/comment-hygiene/SKILL.md"
ZERO=0000000000000000000000000000000000000000
TIMEOUT_SECS=${COMMENT_HYGIENE_TIMEOUT:-240}
MODEL=${COMMENT_HYGIENE_MODEL:-sonnet}

# Commits the push adds: from the merge-base with the remote ref (or origin/main for a new branch).
range_base() {
    remote_sha=$1
    local_sha=$2
    if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        git merge-base "$remote_sha" "$local_sha" 2>/dev/null && return 0
    fi
    git merge-base origin/main "$local_sha" 2>/dev/null
}

list_hits() {
    printf '%s\n' "$1" | awk -F'\t' '{ printf "  %s:%s  %s\n", $2, $3, $4 }'
}

print_blocked() {
    echo "" >&2
    echo "Push blocked: comments cite a ticket or narrate history. A comment explains the" >&2
    echo "code as it stands and why; the story of a change belongs in the commit message." >&2
    list_hits "$1" >&2
    echo "" >&2
    echo "Fix them (rubric: .claude/skills/comment-hygiene/SKILL.md), or mark an intentional" >&2
    echo "line with a same-line 'history-ok: <reason>' comment, then push again." >&2
}

# Run the model on the flagged files with a watchdog (macOS has no `timeout`).
run_model() {
    prompt=$1
    out=$(mktemp)
    PERSPECTIZE_COMMENT_HOOK=1 claude -p \
        --model "$MODEL" \
        --allowed-tools "Read Edit" \
        --permission-mode acceptEdits \
        --settings '{"disableAllHooks":true}' \
        --no-session-persistence \
        --append-system-prompt "$(awk 'BEGIN{n=0} /^---$/ {n++; next} n>=2' "$RUBRIC")" \
        "$prompt" >"$out" 2>&1 &
    model_pid=$!
    ( sleep "$TIMEOUT_SECS"; kill "$model_pid" 2>/dev/null ) &
    watchdog_pid=$!
    wait "$model_pid"
    model_rc=$?
    kill "$watchdog_pid" 2>/dev/null
    wait "$watchdog_pid" 2>/dev/null
    rm -f "$out"
    return "$model_rc"
}

restore_changed() {
    git diff --name-only | while IFS= read -r f; do git checkout -- "$f"; done
}

# Verdict cache: a SOFT set the model already judged fine is not sent to it again.
cache_file() { printf '%s' "$(git rev-parse --git-dir)/comment-hygiene-judged"; }
soft_key() { printf '%s\n' "$1" | git hash-object --stdin; }

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue
    # Branch pushes only (tags carry no code review). `git push origin HEAD` reports local_ref as "HEAD".
    case "$remote_ref" in (refs/heads/*) ;; (*) continue ;; esac

    base=$(range_base "$remote_sha" "$local_sha") || continue
    [ -n "$base" ] || continue

    hits=$(sh "$SCAN" "$base" "$local_sha")
    [ -n "$hits" ] || continue
    hard=$(printf '%s\n' "$hits" | awk -F'\t' '$1 == "HARD"')
    soft=$(printf '%s\n' "$hits" | awk -F'\t' '$1 == "SOFT"')

    # A SOFT-only set already judged fine passes without another model call.
    if [ -z "$hard" ]; then
        key=$(soft_key "$soft")
        if grep -qx "$key" "$(cache_file)" 2>/dev/null; then continue; fi
    fi

    # The model can only fix what is checked out and committed, and only when the tree is clean.
    can_fix=1
    command -v claude >/dev/null 2>&1 || can_fix=0
    [ -f "$RUBRIC" ] || can_fix=0
    current_ref=$(git symbolic-ref -q HEAD)
    [ -n "$current_ref" ] || can_fix=0
    [ "$local_ref" = "$current_ref" ] || [ "$local_ref" = "HEAD" ] || can_fix=0
    [ "$local_sha" = "$(git rev-parse HEAD)" ] || can_fix=0
    [ -z "$(git status --porcelain --untracked-files=no)" ] || can_fix=0

    if [ "$can_fix" = 0 ]; then
        if [ -n "$hard" ]; then
            print_blocked "$hits"
            echo "(Automatic cleanup needs the claude CLI, a clean tree and the pushed branch checked out.)" >&2
            status=1
        else
            echo "Warning: comments that may narrate history (cleanup skipped, push continues):" >&2
            list_hits "$soft" >&2
        fi
        continue
    fi

    files=$(printf '%s\n' "$hits" | awk -F'\t' '{ print $2 }' | sort -u)
    prompt="Follow the comment-hygiene rubric in your system prompt. Flagged comments (TIER, file, line, text):

$(printf '%s\n' "$hits" | awk -F'\t' '{ printf "%s  %s:%s  %s\n", $1, $2, $3, $4 }')

Edit only these files: $(printf '%s' "$files" | tr '\n' ' ')"

    echo "Cleaning up flagged comments with claude (up to ${TIMEOUT_SECS}s)..." >&2
    if ! run_model "$prompt"; then
        echo "Comment cleanup did not finish; restoring the working tree." >&2
        restore_changed
        if [ -n "$hard" ]; then print_blocked "$hits"; status=1; fi
        continue
    fi

    changed=$(git diff --name-only)
    if [ -z "$changed" ]; then
        # The model left every comment as is: its verdict. HARD hits cannot be waved through.
        if [ -n "$hard" ]; then print_blocked "$hard"; status=1; else
            printf '%s\n' "$(soft_key "$soft")" >>"$(cache_file)"
        fi
        continue
    fi

    # Only the flagged files may change, and only their comments.
    outside=$(printf '%s\n' "$changed" | grep -vxF "$files")
    if [ -n "$outside" ] || ! sh "$SCAN" --verify; then
        echo "Comment cleanup changed code or unflagged files; discarding its edits." >&2
        restore_changed
        print_blocked "$hits"
        status=1
        continue
    fi

    git add -- $changed

    # Amend only when the tip commit alone introduced every hit; otherwise add an atomic commit.
    amend=0
    if ! git rev-parse -q --verify "$local_sha^2" >/dev/null; then
        tip_hits=$(sh "$SCAN" "$local_sha^" "$local_sha")
        [ "$tip_hits" = "$hits" ] && amend=1
    fi
    if [ "$amend" = 1 ]; then
        git commit -q --amend --no-edit
        how="amended the last commit"
    else
        git commit -q -m "chore: drop ticket and history references from comments"
        how="added a chore commit"
    fi

    remaining=$(sh "$SCAN" "$base" HEAD | awk -F'\t' '$1 == "HARD"')
    echo "" >&2
    echo "Push aborted: comment cleanup $how. Review it with 'git show', then push again." >&2
    if [ -n "$remaining" ]; then
        echo "These ticket references remain and need a manual fix:" >&2
        list_hits "$remaining" >&2
    fi
    status=1
done

exit $status
