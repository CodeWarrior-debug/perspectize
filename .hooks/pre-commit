#!/bin/sh
# Pre-commit hook: auto-format staged Go and Svelte/TS files
# Activated by: git config core.hooksPath .hooks (see Makefile setup target)

# --- Go: gofmt ---
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM -- 'backend/*.go')
if [ -n "$STAGED_GO" ]; then
    echo "$STAGED_GO" | while read -r file; do
        if [ -f "$file" ]; then
            gofmt -w "$file"
            git add "$file"
        fi
    done
fi

# --- Frontend: prettier ---
STAGED_FE=$(git diff --cached --name-only --diff-filter=ACM -- 'frontend/src/*.svelte' 'frontend/src/*.ts' 'frontend/src/*.js')
if [ -n "$STAGED_FE" ]; then
    if command -v pnpm >/dev/null 2>&1 && [ -f frontend/node_modules/.bin/prettier ]; then
        echo "$STAGED_FE" | while read -r file; do
            if [ -f "$file" ]; then
                pnpm --dir frontend exec prettier --write "$file" 2>/dev/null
                git add "$file"
            fi
        done
    fi
fi

# --- Frontend: block new raw hex/rgb colour literals in components/formatting.ts ---
# UI thoroughness checklist §3.3 (.docs/UI_THOROUGHNESS_CHECKLIST.md): renderers
# and components should use var(--color-*) theme tokens, not hardcoded hex/rgb,
# so they follow the theme picker and dark-preset overrides (see
# frontend/CLAUDE.md's "Grid colours come from theme tokens" gotcha).
# Only ADDED lines are checked, so this doesn't retroactively block the small
# number of pre-existing raw colours already in the codebase — it just stops
# new ones from landing. An intentional exception (e.g. a brand colour) can be
# allowlisted inline with a `hex-ok:` comment on the same line.
HEX_COLOR_SCOPE='frontend/src/lib/components/*.svelte frontend/src/lib/utils/formatting.ts'
STAGED_COLOR_FILES=$(git diff --cached --name-only --diff-filter=ACM -- $HEX_COLOR_SCOPE)
if [ -n "$STAGED_COLOR_FILES" ]; then
    HEX_HITS=""
    for file in $STAGED_COLOR_FILES; do
        [ -f "$file" ] || continue
        FILE_HITS=$(git diff --cached --unified=0 -- "$file" | {
            cur=0
            while IFS= read -r dline; do
                case "$dline" in
                    @@*)
                        newstart=$(printf '%s' "$dline" | sed -n 's/^@@ -[0-9,]* +\([0-9]*\).*/\1/p')
                        cur=$((newstart - 1))
                        ;;
                    +++*) ;;
                    +*)
                        cur=$((cur + 1))
                        content=$(printf '%s' "$dline" | cut -c2-)
                        case "$content" in
                            *hex-ok:*) ;;
                            *)
                                if printf '%s' "$content" | grep -qE "#[0-9a-fA-F]{3,8}\b|rgba?\("; then
                                    echo "$file:$cur: $content"
                                fi
                                ;;
                        esac
                        ;;
                esac
            done
        })
        if [ -n "$FILE_HITS" ]; then
            HEX_HITS="$HEX_HITS
$FILE_HITS"
        fi
    done
    if [ -n "$HEX_HITS" ]; then
        echo "Blocked commit: raw hex/rgb colour literal(s) added:"
        echo "$HEX_HITS"
        echo ""
        echo "Use a var(--color-*) theme token instead (see frontend/CLAUDE.md's"
        echo "'Grid colours come from theme tokens' gotcha). If this is an"
        echo "intentional exception (e.g. a brand colour), append a same-line"
        echo "comment containing 'hex-ok:' plus the reason to allowlist it."
        exit 1
    fi
fi

exit 0
