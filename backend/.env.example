# ============================================
# SECURITY CONFIGURATION
# ============================================
# See .docs/SECURITY.md for secret generation, rotation, and best practices
# NEVER commit .env to git — this file is gitignored
#
# This file is the source of truth for which variables exist. Copy it to
# backend/.env and fill in real values. Values are intentionally left blank —
# real secrets are entered by humans only, never committed here.

# Database connection (Sevalla - use external endpoint URL from "Networking", ?sslmode=disable at end)
DATABASE_URL=

# JWT Authentication (REQUIRED in production)
# Generate with: openssl rand -base64 64
# Minimum 32 bytes, recommended 64 bytes
# Rotate every 90 days
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15

# Clerk Authentication (REQUIRED in production)
# Get from Clerk Dashboard > API Keys
CLERK_SECRET_KEY=

# Clerk Webhook (required for user sync)
# Get from: Clerk Dashboard > Webhooks > Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=

# Rate Limiting
# Requests per minute per IP address
# Increase for high-traffic production, decrease for stricter limits
RATE_LIMIT_PER_MIN=100

# CORS (comma-separated origins)
# Development: http://localhost:5173
# Production: https://app.perspectize.com
# CRITICAL: Never use wildcard (*) with AllowCredentials in production
CORS_ORIGINS=*

# YouTube API (optional — metadata fetching will fail if not set)
# Generate at: Google Cloud Console > YouTube Data API v3 > Credentials
# Add API restrictions: YouTube Data API v3 only
# Add application restrictions: HTTP referrers or IP addresses
YOUTUBE_API_KEY=

# YouTube API response cache TTL, in seconds (in-memory only — not Postgres,
# resets on restart/deploy, not shared across replicas)
# Avoids re-spending YouTube API quota on repeat video metadata lookups.
# Default: 21600 (6 hours). Set to 0 to disable caching.
YOUTUBE_API_CACHE_TTL_SECONDS=21600

# Environment Mode
# production: HSTS enabled, introspection disabled, playground disabled
# development: HSTS disabled, introspection enabled, playground enabled
APP_ENV=development

# HTTPS / TLS (H-14)
# Sevalla handles TLS termination automatically for all deployed apps.
# No ListenAndServeTLS needed in Go code — use http.ListenAndServe.
# Sevalla provides free SSL certificates via Cloudflare integration.
# Verify HTTPS: curl -I https://api.perspectize.com (should return 200 with SSL)

# Sevalla deployment URLs
SEVALLA_BACKEND_URL=
