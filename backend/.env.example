# ============================================
# backend/.env.example — the list of every backend variable
# ============================================
# Copy to backend/.env and fill in real values by hand. .env is gitignored —
# NEVER commit it. Real secrets are entered by humans only, never here.
# See .docs/SECURITY.md for secret generation, rotation, and incident response.
#
# Legend:  REQUIRED = the app won't start (or is insecure) without it.
#          optional = has a default; the default is shown.

# ============================================
# DATABASE (Neon Postgres)
# ============================================

# REQUIRED. Neon connection string.
# Use the DIRECT string (Neon console > Connect, "Connection pooling" OFF; the
# host has no "-pooler"). Do not use the pooled string for the app: the realtime
# listener runs LISTEN/NOTIFY, which Neon's pooler (PgBouncer, transaction mode)
# does not support. Migrations and pg_dump/pg_restore also need the direct string.
# Keep sslmode=require (Neon rejects unencrypted connections). The
# channel_binding=require Neon adds by default works with the Go driver.
# Special characters in the password must be URL-encoded (# -> %23, @ -> %40).
DATABASE_URL=

# --- Connection pool (all optional) ---
# Neon free tier suspends the compute after ~5 min idle, so idle connections are
# closed server-side. Keep ConnMaxIdleTime below that, and keep MaxOpenConns
# within your compute's connection limit (Neon console > Settings > Compute).
# Max connections open at once (default: 25)
DB_MAX_OPEN_CONNS=10
# Max idle connections kept warm (default: 15)
DB_MAX_IDLE_CONNS=5
# Close idle connections after this long (default: 10m)
DB_CONN_MAX_IDLE_TIME=4m
# Recycle any connection after this long (default: 30m)
DB_CONN_MAX_LIFETIME=30m

# ============================================
# AUTHENTICATION
# ============================================

# REQUIRED in production (the server exits without it, min 32 bytes).
# Generate with: openssl rand -base64 64   (rotate every 90 days)
JWT_SECRET=
# optional (default: 15)
ACCESS_TOKEN_MINUTES=15

# REQUIRED in production. Clerk Dashboard > API Keys
CLERK_SECRET_KEY=

# REQUIRED for user sync. Clerk Dashboard > Webhooks > Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=

# ============================================
# SERVER & SECURITY
# ============================================

# development | production. production = HSTS on, GraphQL introspection and
# playground off. The server refuses DEMO_MODE=true together with production.
APP_ENV=development

# Comma-separated allowed origins.
#   Development: http://localhost:5173
#   Production:  your deployed frontend origin
# CRITICAL: never use * with credentials in production. (Code default is *)
CORS_ORIGINS=*

# Requests per minute per IP. (default: 100)
RATE_LIMIT_PER_MIN=100

# ============================================
# YOUTUBE
# ============================================

# optional — metadata fetching fails without it.
# Google Cloud Console > YouTube Data API v3 > Credentials. Restrict the key to
# the YouTube Data API v3 and add application restrictions (referrer or IP).
YOUTUBE_API_KEY=

# In-memory cache TTL for YouTube responses, in seconds (not shared across
# replicas, resets on restart/deploy). Saves API quota on repeat lookups.
# default: 21600 (6 hours); 0 disables caching.
YOUTUBE_API_CACHE_TTL_SECONDS=21600

# ============================================
# MESSAGING
# ============================================

# Keep only the newest N messages per thread. 0 / unset / invalid = unbounded
# (the retention sweep is off). Since migration 000018 the database no longer
# prunes messages itself, so this is the only pruner. (default: 0)
MESSAGE_RETENTION_MAX=0
# How often the sweep runs when enabled, in minutes. (default: 15)
MESSAGE_RETENTION_SWEEP_MINUTES=15

# ============================================
# DEMO MODE (local Docker demo stack only — see docker-compose.demo.yml)
# ============================================

# true: accept unsigned "Bearer demo.<persona>" tokens for personas seeded by
# `go run ./cmd/seed-demo`, and serve YouTube metadata from offline fixtures.
# Leave blank everywhere else. (default: off)
DEMO_MODE=

# ============================================
# DEPLOYMENT (Sevalla hosts the backend app; the database is on Neon)
# ============================================
# Sevalla terminates TLS for deployed apps — no ListenAndServeTLS needed.

# Deployed backend URL (documentation/tooling only; not read by the Go server).
SEVALLA_BACKEND_URL=

# Reported by GET /version (see .docs/LOCAL_DEVELOPMENT.md "Version Info").
# SVL_DEPLOYMENT_COMMIT_SHA / SVL_DEPLOYMENT_BRANCH are injected by Sevalla —
# do not set them here. BUILD_TAG is not: Sevalla has no committer-date
# variable, so the backend can't derive its own v<date>-<sha> tag. Leave blank
# to report "unknown", or set it to the tag .github/workflows/tag-main.yml
# pushed for this commit.
BUILD_TAG=
