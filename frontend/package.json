{
	"name": "fe",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/strip-sourcemaps.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest --project unit",
		"test:run": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"test:browser:watch": "vitest --project browser",
		"test:all": "vitest run",
		"test:coverage": "vitest run --project unit --coverage",
		"mutate": "stryker run --force",
		"mutate:incremental": "stryker run --incremental",
		"mutate:chunked": "node stryker-chunked.mjs",
		"test:duplication": "jscpd src/ tests/ --min-lines 3 --min-tokens 25 --reporters html --output coverage/duplication",
		"demo:test": "playwright test -c demo/playwright.config.ts --project e2e",
		"demo:record": "playwright test -c demo/playwright.config.ts --project record",
		"perf:lighthouse": "pnpm run build && lhci autorun",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"cap:sync": "cap sync",
		"cap:open:ios": "cap open ios",
		"cap:open:android": "cap open android",
		"mobile:build": "vite build && node scripts/strip-sourcemaps.mjs && cap sync"
	},
	"devDependencies": {
		"@capacitor/android": "^8.5.2",
		"@capacitor/cli": "^8.5.2",
		"@capacitor/ios": "^8.5.2",
		"@grafana/faro-rollup-plugin": "0.13.0",
		"@internationalized/date": "^3.12.4",
		"@lhci/cli": "^0.15.1",
		"@lucide/svelte": "^1.49.0",
		"@playwright/test": "1.63.0",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "~2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/svelte": "^5.4.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser": "^4.1.11",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"bits-ui": "^2.19.3",
		"jscpd": "^5.4.0",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^7.3.6",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@ag-grid-community/client-side-row-model": "32.3.9",
		"@ag-grid-community/core": "32.3.9",
		"@ag-grid-community/theming": "32.3.9",
		"@capacitor/core": "^8.5.2",
		"@capacitor/haptics": "^8.0.2",
		"@grafana/faro-web-sdk": "2.12.1",
		"@grafana/faro-web-tracing": "2.12.1",
		"@jaames/iro": "^5.5.2",
		"@tanstack/svelte-form": "^1.33.5",
		"@tanstack/svelte-query": "^6.3.0",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-image": "^3.31.4",
		"@tiptap/extension-link": "^3.31.4",
		"@tiptap/extension-placeholder": "^3.31.4",
		"@tiptap/extension-table": "^3.31.4",
		"@tiptap/extension-table-cell": "^3.31.4",
		"@tiptap/extension-table-header": "^3.31.4",
		"@tiptap/extension-table-row": "^3.31.4",
		"@tiptap/extension-underline": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"ag-grid-svelte5": "^1.0.3",
		"clsx": "^2.1.1",
		"culori": "^4.0.2",
		"dompurify": "^3.4.16",
		"graphql": "^16.14.2",
		"graphql-request": "^7.4.0",
		"graphql-ws": "^6.3.0",
		"svelte-clerk": "^1.2.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0"
	}
}
