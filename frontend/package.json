{
	"name": "fe",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/strip-sourcemaps.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"test": "vitest --project unit",
		"test:run": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"test:browser:watch": "vitest --project browser",
		"test:all": "vitest run",
		"test:coverage": "vitest run --project unit --coverage",
		"mutate": "stryker run --force",
		"mutate:incremental": "stryker run --incremental",
		"mutate:chunked": "node stryker-chunked.mjs",
		"test:duplication": "jscpd src/ tests/ --min-lines 3 --min-tokens 25 --reporters html --output coverage/duplication",
		"demo:test": "playwright test -c demo/playwright.config.ts --project e2e",
		"demo:record": "playwright test -c demo/playwright.config.ts --project record",
		"perf:lighthouse": "pnpm run build && lhci autorun",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:arch": "eslint src && depcruise src --config .dependency-cruiser.cjs --ignore-known",
		"lint:arch:update": "eslint src --suppress-all && depcruise src --config .dependency-cruiser.cjs --output-type baseline > .dependency-cruiser-known-violations.json"
	},
	"devDependencies": {
		"@grafana/faro-rollup-plugin": "0.13.2",
		"@internationalized/date": "^3.12.4",
		"@lhci/cli": "^0.16.1",
		"@lucide/svelte": "^1.77.0",
		"@playwright/test": "1.65.1",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "~3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/svelte": "^5.4.2",
		"@typescript-eslint/parser": "^8.73.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser": "^4.1.12",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"bits-ui": "^2.22.0",
		"dependency-cruiser": "^18.8.0",
		"eslint": "^9.39.5",
		"jscpd": "^5.4.3",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.10.1",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.8",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@ag-grid-community/client-side-row-model": "32.3.9",
		"@ag-grid-community/core": "32.3.9",
		"@ag-grid-community/theming": "32.3.9",
		"@grafana/faro-web-sdk": "2.14.0",
		"@grafana/faro-web-tracing": "2.14.0",
		"@jaames/iro": "^5.5.2",
		"@tanstack/svelte-form": "^1.33.5",
		"@tanstack/svelte-query": "^6.4.4",
		"@tiptap/core": "^3.35.0",
		"@tiptap/extension-bubble-menu": "3.35.0",
		"@tiptap/extension-heading": "3.35.0",
		"@tiptap/extension-image": "^3.35.0",
		"@tiptap/extension-link": "^3.35.0",
		"@tiptap/extension-placeholder": "^3.35.0",
		"@tiptap/extension-table": "^3.35.0",
		"@tiptap/extension-table-cell": "^3.35.0",
		"@tiptap/extension-table-header": "^3.35.0",
		"@tiptap/extension-table-row": "^3.35.0",
		"@tiptap/extension-typography": "3.35.0",
		"@tiptap/extension-underline": "^3.35.0",
		"@tiptap/extensions": "3.35.0",
		"@tiptap/starter-kit": "^3.35.0",
		"@tiptap/suggestion": "3.35.0",
		"ag-grid-svelte5": "^1.0.3",
		"clsx": "^2.1.1",
		"culori": "^4.0.2",
		"dompurify": "^3.4.18",
		"graphql": "^16.15.0",
		"graphql-request": "^7.4.0",
		"graphql-ws": "^6.4.3",
		"svelte-clerk": "^1.3.0",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.1"
	}
}
