# This file is the source of truth for which variables exist. Copy it to
# frontend/.env and fill in real values. Values are intentionally left blank —
# real keys are entered by humans only, never committed here.

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=

# GraphQL API
VITE_GRAPHQL_URL=http://localhost:8080/graphql

# YouTube Data API v3 (Discover page: search + trending)
VITE_YOUTUBE_API_KEY=

# Grafana Faro RUM (errors, web vitals, fetch tracing). Blank = telemetry off.
VITE_FARO_URL=
# Environment reported to Faro (e.g. production). Blank = Vite mode.
VITE_APP_ENV=
