# This file is the source of truth for which variables exist. Copy it to
# frontend/.env and fill in real values. Values are intentionally left blank —
# real keys are entered by humans only, never committed here.

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=

# Demo mode: replace Clerk sign-in with a picker of seeded demo personas.
# Needs a backend running with DEMO_MODE=true. Leave blank for real builds.
VITE_DEMO_MODE=

# GraphQL API
VITE_GRAPHQL_URL=http://localhost:8080/graphql

# Onboarding videos (guest landing "Watch how it works", in-app coach steps).
# Leave blank to hide the corresponding video slot. Point at a hosted file
# (e.g. /onboarding/guest-product.webm served from frontend/static/onboarding/,
# or a CDN URL). Record with `make demo-record` (frontend/demo/out/videos/*.webm).
VITE_ONBOARDING_VIDEO_GUEST_PRODUCT=
VITE_ONBOARDING_VIDEO_HOW_ADD_VIDEO=
VITE_ONBOARDING_VIDEO_HOW_PERSPECTIVE=

# No YouTube key here: Discover's Trending feed comes from the backend
# (youtubeTrending query), and search hands off to youtube.com.
