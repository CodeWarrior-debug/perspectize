# Demo-mode frontend (used by docker-compose.demo.yml at the repo root).
# VITE_* values are baked in at build time: demo mode swaps Clerk for the
# seeded persona picker, so no Clerk key is needed.
FROM node:22-alpine AS builder

ARG VITE_GRAPHQL_URL=http://localhost:8081/graphql
ENV VITE_DEMO_MODE=true \
    VITE_GRAPHQL_URL=$VITE_GRAPHQL_URL

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm exec svelte-kit sync && pnpm run build

FROM nginx:1.29-alpine
COPY demo/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build /usr/share/nginx/html
EXPOSE 80
