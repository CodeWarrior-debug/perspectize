{
  "type": {
    "label": "Movie",
    "enumValue": "MOVIE",
    "icon": "film",
    "accent": "#0F9D8C",
    "serifTitles": false,
    "serifText": false
  },
  "meta": {
    "date": "2026-10-07",
    "sources": [
      "docs/superpowers/specs/2026-10-07-movie-content-type-design.md",
      "frontend/src/lib/components/ActivityTable.svelte",
      "backend/schema.graphql",
      "tools/content-type-designer/src/catalog.ts"
    ],
    "note": "Rebuilt from the amended spec and the implemented columns; the details view is planned (the app modal has no Movie fields yet). The app also has a Tags column (TMDB keywords, 11 columns in total); this preview tool caps at 10, so keywords show in the details view instead. Film facts and scores are illustrative and not re-checked against TMDB."
  },
  "columns": [
    {
      "id": "pz",
      "kind": "perspectize",
      "status": "shipped",
      "header": {
        "body": "Add or edit your perspective on this film. Filled when you already have one.",
        "src": "derived: perspectives WHERE content_id AND user_id"
      }
    },
    {
      "id": "item",
      "kind": "item",
      "label": "Film",
      "status": "shipped",
      "header": {
        "body": "Film title with its TMDB poster and release year. Sorts by title A to Z. The shipped grid header still reads Item for every type; a per-type Film label is planned, not built.",
        "src": "content.name + response.poster_path + response.release_date year"
      }
    },
    {
      "id": "genre",
      "kind": "pill",
      "label": "Genre",
      "status": "shipped",
      "header": {
        "body": "TMDB genre names; the first genre is shown. Not sortable and has no value-list filter yet; TMDB uses Science Fiction for movies where TV uses Sci-Fi and Fantasy.",
        "src": "response.genres[]"
      },
      "cell": {
        "src": "response.genres[0]",
        "whenEmpty": "TMDB lists no genre for this film."
      }
    },
    {
      "id": "rated",
      "kind": "text",
      "label": "Rated",
      "status": "shipped",
      "header": {
        "body": "US age rating (G, PG, PG-13, R, NC-17) stored as a string. Sorts by rating rather than A to Z with unrated last. There is no value-list filter yet, so it is sort-only.",
        "src": "response.certification",
        "extra": "Illustrative: certification values here are what TMDB usually holds, not re-checked per film."
      },
      "cell": {
        "src": "response.certification",
        "whenEmpty": "TMDB has no US certification for this film; blank is not Unrated."
      }
    },
    {
      "id": "cast",
      "kind": "tags",
      "label": "Cast",
      "status": "shipped",
      "header": {
        "body": "Directors lead, marked dir., then the top cast in billing order; the cell shows three and a count. Only the top 15 cast are searchable, and search can be scoped to Cast or Director. Not sortable.",
        "src": "response.directors[] then response.cast[] (top 15)",
        "extra": "personId filter exists in the backend but has no UI yet."
      },
      "cell": {
        "src": "response.directors[].name + response.cast[].name",
        "whenEmpty": "TMDB lists neither director nor cast for this film."
      }
    },
    {
      "id": "duration",
      "kind": "text",
      "label": "Duration",
      "status": "shipped",
      "header": {
        "body": "Runtime to the minute; TMDB gives no seconds, so the seconds are always :00. Shown h:mm:ss from one hour up (2:22:00) and m:ss below (45:00). Sorts with YouTube videos by length; numeric filter.",
        "src": "content.length (seconds) = response.runtimeMinutes x 60"
      },
      "cell": {
        "src": "content.length",
        "whenEmpty": "TMDB has no runtime for this film."
      }
    },
    {
      "id": "released",
      "kind": "date",
      "label": "Released",
      "status": "shipped",
      "header": {
        "body": "Release date from TMDB, shown as the date string. Not sortable and not filterable yet.",
        "src": "response.release_date"
      },
      "cell": {
        "src": "response.release_date",
        "whenEmpty": "TMDB has no release date for this film."
      }
    },
    {
      "id": "box",
      "kind": "text",
      "label": "Box office",
      "status": "shipped",
      "header": {
        "body": "Worldwide gross in compact dollars, with the exact figure in the tooltip. TMDB reports 0 for unknown, which is stored as null and shown as a dash. Sorts with unknown last.",
        "src": "response.revenue (0 -> null)"
      },
      "cell": {
        "src": "response.revenue",
        "whenEmpty": "TMDB reports 0 revenue, meaning unknown, not a flop."
      }
    },
    {
      "id": "vs",
      "kind": "text",
      "label": "Vs. budget",
      "status": "shipped",
      "header": {
        "body": "Revenue divided by budget as a percent, the multiple of the budget it grossed (3,455%). The tooltip shows the net as well. It ignores marketing and studio share, so under 100% is not necessarily a loss. Sorts with unknown last.",
        "src": "response.revenue / response.budget"
      },
      "cell": {
        "src": "response.revenue / response.budget",
        "whenEmpty": "Needs both budget and revenue; TMDB reports 0 for unknown."
      }
    },
    {
      "id": "score",
      "kind": "text",
      "label": "TMDB Score",
      "status": "shipped",
      "header": {
        "body": "TMDB community average out of 10, one decimal (8.2), not a percent. Muted under 50 votes. Not sortable yet.",
        "src": "response.vote_average (vote_count)",
        "extra": "Illustrative: scores drift as TMDB users vote."
      },
      "cell": {
        "src": "response.vote_average",
        "whenEmpty": "TMDB has no votes for this film."
      }
    }
  ],
