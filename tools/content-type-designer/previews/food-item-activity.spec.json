{
  "type": {
    "label": "Food & drink",
    "enumValue": "FOOD_ITEM",
    "icon": "food",
    "accent": "#C2410C",
    "serifTitles": false,
    "serifText": false
  },
  "meta": {
    "date": "2026-11-01",
    "sources": [
      "docs/superpowers/specs/2026-11-01-food-item-content-type-design.md",
      "tools/content-type-designer/previews/movie-activity.html (renderer)"
    ],
    "note": "Proposed type; nothing is built. Ten default columns (the preview tool's crowding cap); Sodium and Tags move to the column picker and details view. Nutella's per-100 g figures, Nutri-Score and allergen tag come from a live Open Food Facts call on 2026-11-01; every other figure is illustrative and not re-checked against USDA or Open Food Facts. Images are glyphs because artifacts block remote images."
  },
  "columns": [
    {
      "id": "pz",
      "kind": "perspectize",
      "status": "shipped",
      "header": {
        "body": "Add or edit your perspective on this food or drink. Filled when you already have one.",
        "src": "derived: perspectives WHERE content_id AND user_id"
      }
    },
    {
      "id": "item",
      "kind": "item",
      "label": "Item",
      "status": "proposed",
      "header": {
        "body": "Name with the Open Food Facts front image, brand and Food/Drink under it. Generic foods (USDA) have no brand or image and show the type glyph. Sorts A to Z.",
        "src": "content.name + response.brand + response.kind + response.imageUrl"
      }
    },
    {
      "id": "serving",
      "kind": "text",
      "label": "Serving",
      "status": "proposed",
      "header": {
        "body": "Serving size as on the label, gram/ml weight first, household measure in brackets. Blank when the source has none; nutrients then fall back to per 100 g/ml and say so.",
        "src": "response.serving {amount, unit, label}"
      },
      "cell": {
        "src": "response.serving",
        "whenEmpty": "No serving size on record; nutrients shown per 100 g."
      }
    },
    {
      "id": "kcal",
      "kind": "text",
      "label": "Calories",
      "status": "proposed",
      "header": {
        "body": "Energy per serving, the number on the label. The header toggle switches every nutrient column to per 100 g/ml for a fair comparison. When there is no serving, the cell shows per-100 with a /100g suffix, never silently a different basis. Sorts with unknown last.",
        "src": "response.perServing.energyKcal | response.per100.energyKcal",
        "extra": "Basis toggle: Per serving ⇄ Per 100 g/ml (grid state nutritionBasis). Mixing solids and liquids on per-100 raises the mixed-units alert."
      },
      "cell": {
        "src": "response.perServing.energyKcal",
        "whenEmpty": "Neither source reports energy for this item."
      }
    },
    {
      "id": "protein",
      "kind": "text",
      "label": "Protein",
      "status": "proposed",
      "header": {
        "body": "Grams per serving (or per 100 on the toggle). Protein per 100 kcal is in the column picker for comparing protein density.",
        "src": "response.perServing.protein (FDC 203 / OFF proteins_100g)"
      },
      "cell": {
        "src": "response.perServing.protein",
        "whenEmpty": "Not reported by the source. Unknown, not 0."
      }
    },
    {
      "id": "carbs",
      "kind": "text",
      "label": "Carbs",
      "status": "proposed",
      "header": {
        "body": "Total carbohydrate in grams. US labels include fiber; EU labels do not. Open Food Facts keeps whatever the label says, so the tooltip names the likely convention.",
        "src": "response.perServing.carbohydrate (FDC 205 / OFF carbohydrates_100g)"
      },
      "cell": {
        "src": "response.perServing.carbohydrate",
        "whenEmpty": "Not reported by the source."
      }
    },
    {
      "id": "fat",
      "kind": "text",
      "label": "Fat",
      "status": "proposed",
      "header": {
        "body": "Total fat in grams; saturated and trans fat are in the column picker and the tooltip.",
        "src": "response.perServing.fat (FDC 204 / OFF fat_100g)"
      },
      "cell": {
        "src": "response.perServing.fat",
        "whenEmpty": "Not reported by the source."
      }
    },
    {
      "id": "sugars",
      "kind": "text",
      "label": "Sugars",
      "status": "proposed",
      "header": {
        "body": "Total sugars in grams; added sugars (often missing outside the US) are in the tooltip and the picker. Sugar % of calories is in the picker.",
        "src": "response.perServing.sugars (FDC 269 / OFF sugars_100g)"
      },
      "cell": {
        "src": "response.perServing.sugars",
        "whenEmpty": "Not reported by the source."
      }
    },
    {
      "id": "nutri",
      "kind": "pill",
      "label": "Nutri-Score",
      "status": "proposed",
      "header": {
        "body": "Open Food Facts' A–E front-of-pack score (EU method, not a USDA rating). Sorts A first, unknown last. Not computed for generic foods, alcoholic drinks or items with too little data.",
        "src": "response.nutriScore (OFF nutriscore_grade)",
        "extra": "Decision to confirm: default column vs column-picker only for a US-first audience."
      },
      "cell": {
        "src": "response.nutriScore",
        "whenEmpty": "No Nutri-Score: not computed for this item."
      }
    },
    {
      "id": "allergens",
      "kind": "tags",
      "label": "Allergens",
      "status": "proposed",
      "header": {
        "body": "Allergens listed on the label, as chips; 'may contain' traces are listed separately in the tooltip. The filter is 'Hide items listing…', never 'Safe for…', and it also hides rows with no allergen data, because unknown is not none.",
        "src": "response.allergens[] (OFF allergens_tags, en: stripped)",
        "extra": "From the product label and public databases. May be incomplete or out of date. Always check the package if you have an allergy."
      },
      "cell": {
        "src": "response.allergens[]",
        "whenEmpty": "No allergen data on record. Unknown, not allergen-free."
      }
    }
  ],
