+package services_test
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/CodeWarrior-debug/perspectize/backend/internal/core/domain"
+	"github.com/CodeWarrior-debug/perspectize/backend/internal/core/services"
+)
+
+func TestImportService_NormalizeMovieLink(t *testing.T) {
+	// The method needs no repository, lister or content creator: it makes no call.
+	svc := services.NewImportService(nil, nil, nil)
+
+	t.Run("a TMDB movie link becomes the canonical movie URL", func(t *testing.T) {
+		for name, raw := range map[string]string{
+			"slug and query":         "https://www.themoviedb.org/movie/603-the-matrix?language=en",
+			"slug only":              "https://www.themoviedb.org/movie/603-the-matrix",
+			"already canonical":      "https://www.themoviedb.org/movie/603",
+			"trailing slash":         "https://www.themoviedb.org/movie/603/",
+			"sub-page":               "https://www.themoviedb.org/movie/603/cast",
+			"query and no slug":      "https://www.themoviedb.org/movie/603?language=en",
+			"fragment":               "https://www.themoviedb.org/movie/603#cast",
+			"no scheme":              "themoviedb.org/movie/603-the-matrix",
+			"upper case host":        "HTTPS://WWW.THEMOVIEDB.ORG/movie/603-the-matrix",
+			"surrounding whitespace": "  https://www.themoviedb.org/movie/603-the-matrix\n",
+		} {
+			t.Run(name, func(t *testing.T) {
+				got, err := svc.NormalizeMovieLink(raw)
+				require.NoError(t, err)
+				assert.Equal(t, "https://www.themoviedb.org/movie/603", got)
+			})
+		}
+	})
+
+	t.Run("different movies stay different", func(t *testing.T) {
+		got, err := svc.NormalizeMovieLink("https://www.themoviedb.org/movie/27205-inception")
+		require.NoError(t, err)
+		assert.Equal(t, "https://www.themoviedb.org/movie/27205", got)
+	})
+
+	t.Run("anything else is invalid input and returns no URL", func(t *testing.T) {
+		for name, raw := range map[string]string{
+			"imdb link":           "https://www.imdb.com/title/tt0133093/",
+			"imdb link with path": "https://www.imdb.com/title/tt0133093/?ref_=fn_al_tt_1",
+			"bare imdb id":        "tt0133093",
+			"bare imdb id, upper": "TT0133093",
+			"tmdb tv link":        "https://www.themoviedb.org/tv/1396-breaking-bad",
+			"tmdb person link":    "https://www.themoviedb.org/person/6384",
+			"tmdb movie no id":    "https://www.themoviedb.org/movie/the-matrix",
+			"tmdb movie id zero":  "https://www.themoviedb.org/movie/0",
+			"youtube link":        "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
+			"bare number":         "603",
+			"plain text":          "the matrix",
+			"empty":               "",
+			"whitespace":          "   ",
+		} {
+			t.Run(name, func(t *testing.T) {
+				got, err := svc.NormalizeMovieLink(raw)
+				require.Error(t, err)
+				assert.ErrorIs(t, err, domain.ErrInvalidInput)
+				assert.Empty(t, got)
+			})
+		}
+	})
+}
