 	return resolvedSource{lister: lister, resolved: *r}, true
 }
 
+// NormalizeMovieLink returns the canonical movie URL for a pasted TMDB movie
+// link (https://www.themoviedb.org/movie/603-the-matrix?language=en becomes
+// https://www.themoviedb.org/movie/603), the form the content service stores and
+// dedupes on. It makes no network call, so anything that is not a TMDB movie
+// link, an IMDb link or id included, is ErrInvalidInput.
+func (s *ImportService) NormalizeMovieLink(raw string) (string, error) {
+	return canonicalTMDBMovieURL(raw)
+}
