 	return created, nil
 }
 
+// canonicalTMDBMovieURL turns a pasted TMDB movie link into the canonical URL
+// CreateFromMovie stores, using the same parser and URL builder. It makes no TMDB
+// call, so an IMDb link or id, which needs a lookup to find its TMDB id, is
+// refused along with anything else that is not a TMDB movie link. Every refusal
+// is ErrInvalidInput.
+func canonicalTMDBMovieURL(rawURL string) (string, error) {
+	tmdbID, _, err := tmdb.ParseMovieInput(rawURL)
+	if err != nil {
+		return "", fmt.Errorf("%w: %v", domain.ErrInvalidInput, err)
+	}
+	if tmdbID == 0 {
+		return "", fmt.Errorf("%w: an IMDb title is not a TMDB movie link", domain.ErrInvalidInput)
+	}
+	return tmdb.CanonicalMovieURL(tmdbID), nil
+}
