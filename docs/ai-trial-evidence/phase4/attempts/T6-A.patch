diff --git a/frontend/src/lib/utils/omittedVerses.ts b/frontend/src/lib/utils/omittedVerses.ts
new file mode 100644
index 00000000..90e276d5
--- /dev/null
+++ b/frontend/src/lib/utils/omittedVerses.ts
@@ -0,0 +1,12 @@
+/**
+ * A verse the BSB prints no text for (its content sits in footnotes), so the stored text is empty.
+ * Whitespace-only counts as empty. Callers show a marker instead of inventing text.
+ */
+export function isOmittedVerse(verse: { text: string }): boolean {
+	return verse.text.trim() === '';
+}
+
+/** True when there is at least one verse and every one of them is omitted. */
+export function isOmittedPassage(verses: readonly { text: string }[]): boolean {
+	return verses.length > 0 && verses.every(isOmittedVerse);
+}
