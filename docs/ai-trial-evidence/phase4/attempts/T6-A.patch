diff --git a/frontend/tests/unit/omittedVerses.test.ts b/frontend/tests/unit/omittedVerses.test.ts
new file mode 100644
index 00000000..14ec1fdf
--- /dev/null
+++ b/frontend/tests/unit/omittedVerses.test.ts
@@ -0,0 +1,27 @@
+import { describe, it, expect } from 'vitest';
+import { isOmittedPassage, isOmittedVerse } from '$lib/utils/omittedVerses';
+
+describe('isOmittedVerse', () => {
+	it('is true for empty and whitespace-only text', () => {
+		expect(isOmittedVerse({ text: '' })).toBe(true);
+		expect(isOmittedVerse({ text: ' \n\t ' })).toBe(true);
+	});
+
+	it('is false once there is any text', () => {
+		expect(isOmittedVerse({ text: 'In the beginning' })).toBe(false);
+		expect(isOmittedVerse({ text: ' x ' })).toBe(false);
+	});
+});
+
+describe('isOmittedPassage', () => {
+	it('is true only when every verse is omitted', () => {
+		expect(isOmittedPassage([{ text: '' }])).toBe(true);
+		expect(isOmittedPassage([{ text: '' }, { text: ' ' }])).toBe(true);
+		expect(isOmittedPassage([{ text: '' }, { text: 'text' }])).toBe(false);
+		expect(isOmittedPassage([{ text: 'text' }])).toBe(false);
+	});
+
+	it('is false for no verses, so an empty response is not reported as omitted', () => {
+		expect(isOmittedPassage([])).toBe(false);
+	});
+});
