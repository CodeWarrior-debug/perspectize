+<script lang="ts">
+	import { typeSwitchOptions } from '$lib/utils/grid-config';
+
+	let {
+		typeFilter,
+		onSwitch,
+	}: {
+		/** The `f.type` URL value. Shown only while it names exactly one known type. */
+		typeFilter: string | undefined;
+		/** Called with the chosen type's lowercase value (a CONTENT_TYPE_OPTIONS value). */
+		onSwitch: (type: string) => void;
+	} = $props();
+
+	const options = $derived(typeSwitchOptions(typeFilter));
+
+	/**
+	 * Float the row above the grid card, top right (#activity-callout-slot in the page), where the
+	 * "select one type" note sits while several types show. The two never show together. Without
+	 * the slot (tests, other pages) it simply stays where it was rendered.
+	 */
+	function moveToCalloutSlot(node: HTMLElement) {
+		document.getElementById('activity-callout-slot')?.appendChild(node);
+	}
+</script>
+
+{#if options.length > 0}
+	<div
+		role="group"
+		aria-label="Switch content type"
+		data-testid="type-switcher"
+		use:moveToCalloutSlot
+		class="flex min-w-0 flex-wrap items-center justify-end gap-1.5 pb-1.5 text-xs md:text-sm text-muted-foreground"
+	>
+		<span>Switch to</span>
+		{#each options as option (option.value)}
+			<button
+				type="button"
+				onclick={() => onSwitch(option.value)}
+				class="border-border bg-background text-foreground hover:bg-accent hover:text-accent-foreground rounded-full border px-2.5 py-0.5 transition-colors"
+			>
+				{option.label}
+			</button>
+		{/each}
+	</div>
+{/if}
