 	return selectedTypes(typeFilter).length !== 1;
 }
 
+/**
+ * The one-click switches offered while the `f.type` URL value names exactly one known type: every
+ * other type, in CONTENT_TYPE_OPTIONS order. Empty when it names none or several (the callout above
+ * covers that case), or a value the server would ignore (every type is showing, so nothing is being
+ * switched from). Bookmarked `youtube` URLs mean `youtube_video`, as in `parseSetValue`.
+ */
+export function typeSwitchOptions(typeFilter: string | undefined): { value: string; label: string }[] {
+	const solo = soloTypeFilter(typeFilter);
+	const current = solo === 'youtube' ? 'youtube_video' : solo;
+	if (!current || !CONTENT_TYPE_OPTIONS.some((o) => o.value === current)) return [];
+	return CONTENT_TYPE_OPTIONS.filter((o) => o.value !== current);
+}
