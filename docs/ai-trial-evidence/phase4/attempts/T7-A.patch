+// ---------------------------------------------------------------------------
+// paramsForTypeSwitch
+// ---------------------------------------------------------------------------
+
+describe('paramsForTypeSwitch', () => {
+	const roundTrip = (state: ReturnType<typeof paramsForTypeSwitch>) =>
+		parseGridParams(new URLSearchParams(serializeGridParams(state)));
+
+	it('replaces the type filter and returns to page 1', () => {
+		const result = paramsForTypeSwitch({ ...GRID_DEFAULTS, page: 4 }, 'movie');
+		expect(result.filters).toEqual({ type: 'movie' });
+		expect(result.page).toBe(1);
+		expect(serializeGridParams(result)).toBe('f.type=movie');
+	});
+
+	it('keeps the search text, sort, mode and page size', () => {
+		const from = {
+			...GRID_DEFAULTS,
+			mode: 'all' as const,
+			pageSize: 25,
+			q: 'nolan',
+			sorts: [{ col: 'views', dir: 'asc' as const }],
+		};
+		const result = paramsForTypeSwitch(from, 'book');
+		expect(result).toMatchObject({ mode: 'all', pageSize: 25, q: 'nolan', sorts: from.sorts });
+	});
+
+	it('keeps the User filter ("Mine") and drops every other column filter', () => {
+		const from = {
+			...GRID_DEFAULTS,
+			filters: { type: 'movie', user: 'alice', rated: 'pg-13', genre: 'sci', person: '525:cast' },
+		};
+		expect(paramsForTypeSwitch(from, 'book').filters).toEqual({ type: 'book', user: 'alice' });
+	});
+
+	it('omits the URL filter when switching back to the default type with nothing else kept', () => {
+		const from = { ...GRID_DEFAULTS, filters: { type: 'movie', rated: 'r' } };
+		const result = paramsForTypeSwitch(from, 'youtube_video');
+		expect(result.filters).toEqual(GRID_DEFAULTS.filters);
+		expect(serializeGridParams(result)).toBe('');
+	});
+
+	it('does not mutate its input', () => {
+		const from = { ...GRID_DEFAULTS, page: 3, filters: { type: 'movie', rated: 'r' } };
+		paramsForTypeSwitch(from, 'book');
+		expect(from.page).toBe(3);
+		expect(from.filters).toEqual({ type: 'movie', rated: 'r' });
+	});
+
+	describe('search scopes', () => {
+		it('switching to Movie turns Cast and Director on when the scopes were the defaults', () => {
+			const result = paramsForTypeSwitch(GRID_DEFAULTS, 'movie');
+			expect(result.qFields).toEqual(['title', 'desc', 'channel', 'tags', 'cast', 'director']);
+			expect(serializeGridParams(result)).toBe('f.type=movie');
+		});
+
+		it('switching away from Movie drops Cast and Director from the default scopes', () => {
+			const from = parseGridParams(new URLSearchParams('f.type=movie'));
+			const result = paramsForTypeSwitch(from, 'book');
+			expect(result.qFields).toEqual(['title', 'desc', 'channel', 'tags']);
+			expect(serializeGridParams(result)).toBe('f.type=book');
+		});
+
+		it('keeps a customised pick, minus scopes the new type no longer offers', () => {
+			const from = parseGridParams(new URLSearchParams('f.type=movie&qf=title,cast'));
+			expect(from.qFields).toEqual(['title', 'cast']);
+			const result = paramsForTypeSwitch(from, 'book');
+			expect(result.qFields).toEqual(['title']);
+			expect(roundTrip(result).qFields).toEqual(['title']);
+		});
+
+		it('falls back to the new defaults when nothing of a customised pick survives', () => {
+			const from = parseGridParams(new URLSearchParams('f.type=movie&qf=cast,director'));
+			const result = paramsForTypeSwitch(from, 'book');
+			expect(result.qFields).toEqual(['title', 'desc', 'channel', 'tags']);
+		});
+
+		it('keeps a customised pick as is when the new type offers all of it', () => {
+			const from = parseGridParams(new URLSearchParams('qf=title'));
+			const result = paramsForTypeSwitch(from, 'claim');
+			expect(result.qFields).toEqual(['title']);
+			expect(roundTrip(result).qFields).toEqual(['title']);
+		});
+	});
+});
