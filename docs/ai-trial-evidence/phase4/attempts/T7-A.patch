@@ -225,6 +225,32 @@ function sameScopes(a: SearchScopeKey[], b: SearchScopeKey[]): boolean {
 	return a.length === b.length && a.every((s) => b.includes(s));
 }
 
+/** `f.*` keys that mean the same on every content type (the User column, which "Mine" sets). A type switch keeps them. */
+const CROSS_TYPE_FILTER_KEYS = ['user'];
+
+/**
+ * The grid state after a one-click switch to `type` (a CONTENT_TYPE_OPTIONS value): the type filter
+ * is replaced and back to page 1, and the search text, sort and mode carry over. Column filters
+ * other than the cross-type ones are dropped, since most belong to the old type's columns (Rated,
+ * Author, Duration) and would empty the new view behind a chip. The search scopes follow the new
+ * type: untouched defaults become the new type's defaults (Cast and Director join in for Movie),
+ * and a customised pick keeps whichever of its scopes the new type still offers.
+ */
+export function paramsForTypeSwitch(params: GridParams, type: string): GridParams {
+	const filters: Record<string, string> = { type };
+	for (const key of CROSS_TYPE_FILTER_KEYS) {
+		if (params.filters[key]) filters[key] = params.filters[key];
+	}
+
+	let qFields = searchScopesFor(filters);
+	if (!sameScopes(params.qFields, searchScopesFor(params.filters))) {
+		const kept = qFields.filter((s) => params.qFields.includes(s));
+		if (kept.length > 0) qFields = kept;
+	}
+
+	return { ...params, filters, qFields, page: 1 };
+}
+
