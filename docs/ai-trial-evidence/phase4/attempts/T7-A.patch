@@ -0,0 +1,53 @@
+import { describe, it, expect } from 'vitest';
+import { CONTENT_TYPE_OPTIONS, showColumnRelevanceCallout, typeSwitchOptions } from '$lib/utils/grid-config';
+
+const values = (typeFilter: string | undefined) => typeSwitchOptions(typeFilter).map((o) => o.value);
+
+describe('typeSwitchOptions', () => {
+	it('offers every other type, in the Type filter order, when one type shows', () => {
+		expect(values('youtube_video')).toEqual(['claim', 'bible_passage', 'movie', 'book', 'web_page']);
+		expect(values('movie')).toEqual(['youtube_video', 'claim', 'bible_passage', 'book', 'web_page']);
+	});
+
+	it('never offers the type already showing, and carries the display labels', () => {
+		const options = typeSwitchOptions('book');
+		expect(options.map((o) => o.value)).not.toContain('book');
+		expect(options.find((o) => o.value === 'web_page')?.label).toBe('Webpage');
+		expect(options).toHaveLength(CONTENT_TYPE_OPTIONS.length - 1);
+	});
+
+	it('treats case, spaces and repeats of one type as that one type', () => {
+		expect(values('Movie')).toEqual(values('movie'));
+		expect(values(' movie ')).toEqual(values('movie'));
+		expect(values('movie,movie')).toEqual(values('movie'));
+	});
+
+	it('reads a bookmarked `youtube` as youtube_video', () => {
+		expect(values('youtube')).toEqual(values('youtube_video'));
+		expect(values('youtube')).not.toContain('youtube_video');
+	});
+
+	it('offers nothing with no type filter', () => {
+		expect(values(undefined)).toEqual([]);
+		expect(values('')).toEqual([]);
+		expect(values(' , ')).toEqual([]);
+	});
+
+	it('offers nothing with two or more types', () => {
+		expect(values('youtube_video,movie')).toEqual([]);
+		expect(values('youtube_video, movie ,bible_passage')).toEqual([]);
+	});
+
+	it('offers nothing for a value the server would ignore (every type is showing)', () => {
+		expect(values('podcast')).toEqual([]);
+	});
+
+	it('is the counterpart of the column-relevance callout for every known type', () => {
+		for (const { value } of CONTENT_TYPE_OPTIONS) {
+			expect(showColumnRelevanceCallout(value)).toBe(false);
+			expect(typeSwitchOptions(value).length).toBeGreaterThan(0);
+		}
+		expect(showColumnRelevanceCallout('youtube_video,movie')).toBe(true);
+		expect(typeSwitchOptions('youtube_video,movie')).toEqual([]);
+	});
+});
