+import { describe, it, expect, vi } from 'vitest';
+import { render, screen, fireEvent } from '@testing-library/svelte';
+import TypeSwitcher from '$lib/components/TypeSwitcher.svelte';
+
+describe('TypeSwitcher', () => {
+	it('offers a button for every type except the one showing', () => {
+		render(TypeSwitcher, { props: { typeFilter: 'youtube_video', onSwitch: vi.fn() } });
+		const names = screen.getAllByRole('button').map((b) => b.textContent?.trim());
+		expect(names).toEqual(['Claim', 'Bible Passage', 'Movie', 'Book', 'Webpage']);
+		expect(screen.queryByRole('button', { name: 'YouTube Video' })).not.toBeInTheDocument();
+	});
+
+	it('hands the clicked type up as its lowercase filter value', async () => {
+		const onSwitch = vi.fn();
+		render(TypeSwitcher, { props: { typeFilter: 'youtube_video', onSwitch } });
+
+		await fireEvent.click(screen.getByRole('button', { name: 'Webpage' }));
+		expect(onSwitch).toHaveBeenCalledTimes(1);
+		expect(onSwitch).toHaveBeenCalledWith('web_page');
+
+		await fireEvent.click(screen.getByRole('button', { name: 'Movie' }));
+		expect(onSwitch).toHaveBeenLastCalledWith('movie');
+	});
+
+	it('names the group for assistive tech', () => {
+		render(TypeSwitcher, { props: { typeFilter: 'movie', onSwitch: vi.fn() } });
+		expect(screen.getByRole('group', { name: 'Switch content type' })).toBeInTheDocument();
+	});
+
+	it.each([
+		['no type filter', undefined],
+		['an empty type filter', ''],
+		['two types', 'youtube_video,movie'],
+		['an unknown type', 'podcast'],
+	])('renders nothing for %s', (_label, typeFilter) => {
+		render(TypeSwitcher, { props: { typeFilter, onSwitch: vi.fn() } });
+		expect(screen.queryByTestId('type-switcher')).not.toBeInTheDocument();
+		expect(screen.queryByRole('button')).not.toBeInTheDocument();
+	});
+
+	it('follows the filter: switching the shown type swaps which buttons are offered', async () => {
+		const { rerender } = render(TypeSwitcher, { props: { typeFilter: 'youtube_video', onSwitch: vi.fn() } });
+		expect(screen.getByRole('button', { name: 'Movie' })).toBeInTheDocument();
+		expect(screen.queryByRole('button', { name: 'YouTube Video' })).not.toBeInTheDocument();
+
+		await rerender({ typeFilter: 'movie', onSwitch: vi.fn() });
+		expect(screen.queryByRole('button', { name: 'Movie' })).not.toBeInTheDocument();
+		expect(screen.getByRole('button', { name: 'YouTube Video' })).toBeInTheDocument();
+
+		await rerender({ typeFilter: 'movie,book', onSwitch: vi.fn() });
+		expect(screen.queryByTestId('type-switcher')).not.toBeInTheDocument();
+	});
+
+	it('moves itself into the page slot above the table when one exists', () => {
+		const slot = document.createElement('div');
+		slot.id = 'activity-callout-slot';
+		document.body.appendChild(slot);
+		try {
+			render(TypeSwitcher, { props: { typeFilter: 'movie', onSwitch: vi.fn() } });
+			expect(slot.contains(screen.getByTestId('type-switcher'))).toBe(true);
+		} finally {
+			slot.remove();
+		}
+	});
+});
