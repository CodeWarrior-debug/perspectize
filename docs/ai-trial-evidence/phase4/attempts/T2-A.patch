+// TestList_LikeCountSortGuardsTheCast pins that a LIKE_COUNT sort never feeds a stored
+// likeCount to a bare ::BIGINT cast: YouTube stores "" for hidden likes and Postgres
+// rejects that cast, failing the whole list. The guard must be in the selected sort
+// column and in the ORDER BY, which the paginator builds from the same expression.
+func TestList_LikeCountSortGuardsTheCast(t *testing.T) {
+	guarded := regexp.QuoteMeta("CASE WHEN (response->'items'->0->'statistics'->>'likeCount') ~ '^[0-9]+$' " +
+		"THEN (response->'items'->0->'statistics'->>'likeCount')::BIGINT END")
+
+	for _, order := range []domain.SortOrder{domain.SortOrderAsc, domain.SortOrderDesc} {
+		t.Run(string(order), func(t *testing.T) {
+			db, mock := newMockDB(t)
+			first := 1
+			// Selected column, then the paginator's COALESCE(...) in ORDER BY.
+			mock.ExpectQuery(`SELECT content\.\*, \(` + guarded + `\) AS like_count .*ORDER BY COALESCE\(` + guarded + `, '0'\) ` + string(order)).
+				WillReturnRows(computedRows("like_count", nil))
+
+			_, err := NewGormContentRepository(db).List(context.Background(), domain.ContentListParams{
+				First: &first, SortBy: domain.ContentSortByLikeCount, SortOrder: order,
+			})
+			require.NoError(t, err)
+			assertAllExpectationsMet(t, mock)
+		})
+	}
+}
