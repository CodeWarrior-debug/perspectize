+// FailQueued mirrors the SQL: only rows of the job among ids that are still queued change.
+func (r *fakeImportRepo) FailQueued(_ context.Context, jobID int, ids []int, detail string) ([]int, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.failQueuedCalls = append(r.failQueuedCalls, failQueuedCall{jobID: jobID, ids: append([]int(nil), ids...), detail: detail})
+	if r.failQueuedErr != nil {
+		return nil, r.failQueuedErr
+	}
+	out := []int{}
+	for _, id := range ids {
+		it, ok := r.items[id]
+		if !ok || it.Item.JobID != jobID {
+			continue
+		}
+		if st := it.Item.ImportStatus; st != nil && *st == domain.ImportItemStatusQueued {
+			failed := domain.ImportItemStatusFailed
+			it.Item.ImportStatus, it.Item.ImportError = &failed, &detail
+			out = append(out, id)
+		}
+	}
+	return out, nil
+}
