+// FailQueued is one UPDATE scoped to the job, the named rows and the queued
+// status: rows already finished, rows not named and other jobs' rows are left alone.
+func TestImportJobIntegration_FailQueued(t *testing.T) {
+	f := newImportJobFixture(t)
+	ctx := context.Background()
+	job := f.newJob(t)
+	other := f.newJob(t)
+	require.NoError(t, f.repo.UpsertItems(ctx, []*domain.ImportItemWithDetails{f.videoItem(job, 1), f.videoItem(job, 2), f.videoItem(job, 3), f.videoItem(job, 4)}))
+	require.NoError(t, f.repo.UpsertItems(ctx, []*domain.ImportItemWithDetails{f.videoItem(other, 5)}))
+	items, err := f.repo.ListItems(ctx, job.ID)
+	require.NoError(t, err)
+	otherItems, err := f.repo.ListItems(ctx, other.ID)
+	require.NoError(t, err)
+
+	// Rows 0, 1 and 3 and the other job's row are queued; row 2 is queued and then imported.
+	_, err = f.repo.MarkQueued(ctx, job.ID, []int{items[0].ID, items[1].ID, items[2].ID, items[3].ID})
+	require.NoError(t, err)
+	_, err = f.repo.MarkQueued(ctx, other.ID, []int{otherItems[0].ID})
+	require.NoError(t, err)
+	require.NoError(t, f.repo.RecordOutcome(ctx, items[2].ID, domain.ImportItemStatusImported, nil, nil))
+
+	c := querycount.Attach(t, f.db)
+	failed, err := f.repo.FailQueued(ctx, job.ID, []int{items[0].ID, items[1].ID, items[2].ID, otherItems[0].ID}, "ran out of time")
+	require.NoError(t, err)
+	c.AssertExactly(t, 1)
+	assert.ElementsMatch(t, []int{items[0].ID, items[1].ID}, failed, "the imported row, the other job's row and the unnamed row are not failed")
+
+	listed, err := f.repo.ListItems(ctx, job.ID)
+	require.NoError(t, err)
+	for _, i := range []int{0, 1} {
+		assert.Equal(t, domain.ImportItemStatusFailed, *listed[i].ImportStatus)
+		require.NotNil(t, listed[i].ImportError)
+		assert.Equal(t, "ran out of time", *listed[i].ImportError)
+	}
+	assert.Equal(t, domain.ImportItemStatusImported, *listed[2].ImportStatus)
+	assert.Equal(t, domain.ImportItemStatusQueued, *listed[3].ImportStatus, "a row that was not named stays queued")
+	otherListed, err := f.repo.ListItems(ctx, other.ID)
+	require.NoError(t, err)
+	assert.Equal(t, domain.ImportItemStatusQueued, *otherListed[0].ImportStatus, "another job's row is untouched")
+
+	c.Reset()
+	none, err := f.repo.FailQueued(ctx, job.ID, nil, "ran out of time")
+	require.NoError(t, err)
+	assert.Empty(t, none)
+	c.AssertExactly(t, 0)
+
+	again, err := f.repo.FailQueued(ctx, job.ID, []int{items[0].ID}, "ran out of time")
+	require.NoError(t, err)
+	assert.Empty(t, again, "a row that is no longer queued is not failed twice")
+
+	// A failed row can be queued again.
+	requeued, err := f.repo.MarkQueued(ctx, job.ID, []int{items[0].ID})
+	require.NoError(t, err)
+	assert.Equal(t, []int{items[0].ID}, requeued)
+}
