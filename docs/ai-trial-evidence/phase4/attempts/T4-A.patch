+// FailQueued fails the named rows of a job that are still queued and returns
+// the ids it changed. The status is in the WHERE clause so a row that finished
+// since the caller last looked keeps its outcome.
+func (r *GormImportJobRepository) FailQueued(ctx context.Context, jobID int, ids []int, detail string) ([]int, error) {
+	if len(ids) == 0 {
+		return []int{}, nil
+	}
+	var changed []ImportItemModel
+	result := r.db.WithContext(ctx).
+		Model(&changed).
+		Clauses(clause.Returning{Columns: []clause.Column{{Name: "id"}}}).
+		Where("job_id = ? AND id = ANY(CAST(? AS bigint[])) AND import_status = 'queued'", jobID, intsToArray(ids)).
+		Updates(map[string]any{"import_status": "failed", "import_error": detail})
+	if result.Error != nil {
+		return nil, fmt.Errorf("failed to fail queued import items: %w", result.Error)
+	}
+	out := make([]int, len(changed))
+	for i := range changed {
+		out[i] = changed[i].ID
+	}
+	return out, nil
+}
