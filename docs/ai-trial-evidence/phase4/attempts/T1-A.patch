+	// id 1 = 5 views, 2 = 1000 views, 3 = "", 4 = "n/a", 5 = no statistics.
+	table := fmt.Sprintf(`(VALUES
+			(1, '%s'::jsonb),
+			(2, '%s'::jsonb),
+			(3, '%s'::jsonb),
+			(4, '%s'::jsonb),
+			(5, '%s'::jsonb)
+		) AS content(id, response)`,
+		statsJSON(`"5"`, ""),
+		statsJSON(`"1000"`, ""),
+		statsJSON(`""`, ""),
