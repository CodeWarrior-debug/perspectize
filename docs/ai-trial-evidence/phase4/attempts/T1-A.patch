+// statsRows is a VALUES list of stored responses. "" is how a hidden count can appear and
+// "n/a" stands for any other non-numeric value; a bare ::BIGINT cast rejects both and
+// fails the whole query.
+func statsRows(rows ...string) string {
+	out := ""
+	for i, r := range rows {
+		if i > 0 {
+			out += ",\n\t\t\t"
+		}
+		out += fmt.Sprintf("('%s'::jsonb)", r)
+	}
+	return out
+}
+
+func statsJSON(views, likes string) string {
+	stats := ""
+	add := func(key, val string) {
+		if val == "" {
+			return
+		}
+		if stats != "" {
+			stats += ","
+		}
+		stats += fmt.Sprintf(`"%s":%s`, key, val)
+	}
+	add("viewCount", views)
+	add("likeCount", likes)
+	return fmt.Sprintf(`{"items":[{"statistics":{%s}}]}`, stats)
+}
+
+func scanNullInt64s(t *testing.T, got []sql.NullInt64) (values []int64, nulls int) {
+	t.Helper()
+	for _, v := range got {
+		if v.Valid {
+			values = append(values, v.Int64)
+		} else {
+			nulls++
+		}
+	}
+	return values, nulls
+}
