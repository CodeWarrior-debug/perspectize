index 00000000..833047b4
--- /dev/null
+++ b/frontend/src/lib/queries/perspectives/useFeelingStats.ts
@@ -0,0 +1,47 @@
+import { createQuery } from '@tanstack/svelte-query';
+import { graphqlRequest } from '../client';
+import { GET_FEELING_STATS, type FeelingStats, type FeelingStatsResponse } from './index';
+import { queryKeys } from '../keys';
+
+/**
+ * Other people's perspectives move these counts only slowly, and this viewer's own writes evict the
+ * entry through `content.detail(id)` (see `queryKeys.content.feelingStats`), so re-opening the editor
+ * on the same feeling within five minutes costs no request. Deliberate, not the default 0.
+ */
+export const FEELING_STATS_STALE_TIME_MS = 5 * 60 * 1000;
+
+export interface FeelingStatsArgs {
+	contentId: number;
+	emoji: string;
+	/** Omitted from the request, and the key, when empty: the feeling has no label to narrow by. */
+	label?: string | null;
+}
+
+/**
+ * How many of one content item's perspectives carry a feeling (`feelingStats`).
+ *
+ * `getArgs` returns `null` while there is no feeling to look up, which disables the query so no
+ * request is sent. Must be called during component init.
+ */
+export function useFeelingStats(getArgs: () => FeelingStatsArgs | null) {
+	return createQuery(() => {
+		// Read the args synchronously, so the key and the request always agree on them.
+		const args = getArgs();
+		const label = args?.label || null;
+		return {
+			queryKey: queryKeys.content.feelingStats(String(args?.contentId ?? ''), args?.emoji ?? '', label),
+			queryFn: async (): Promise<FeelingStats | null> => {
+				if (args === null) return null;
+				// `undefined` drops the variable from the request instead of sending a null label.
+				const res = await graphqlRequest<FeelingStatsResponse>(GET_FEELING_STATS, {
+					contentID: args.contentId,
+					emoji: args.emoji,
+					label: label ?? undefined,
+				});
+				return res.feelingStats ?? null;
+			},
+			enabled: args !== null,
+			staleTime: FEELING_STATS_STALE_TIME_MS,
+		};
+	});
+}
