+/**
+ * The "N of M perspectives felt ..." line under the feel wheel in PerspectivePopover.
+ *
+ * Unlike PerspectivePopover.test.ts (which mocks every query hook and renders without a
+ * QueryClient), this file runs the real `useFeelingStats` hook against a real QueryClient and
+ * mocks only the network (`graphqlRequest`), so what is asserted is the request that would go over
+ * the wire and what the viewer sees while it is in flight, after it fails, and once it lands.
+ */
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { render, screen, fireEvent } from '@testing-library/svelte';
+import { tick } from 'svelte';
+import PerspectivePopover from '#lib/components/PerspectivePopover.svelte';
+import { GET_FEELING_STATS } from '#lib/queries/perspectives/index.js';
+import { queryKeys } from '#lib/queries/keys.js';
+import TestWrapper from '../helpers/TestWrapper.svelte';
+import { makeClient } from '../helpers/queryBudget';
+import { warmUp } from '../helpers/warmUp';
+
+const mocks = vi.hoisted(() => ({
+	graphqlRequest: vi.fn<(document: string, variables?: Record<string, unknown>) => Promise<unknown>>(),
+}));
+
+vi.mock('#lib/queries/client.js', () => ({ graphqlRequest: mocks.graphqlRequest }));
+
+// Everything else the popover calls at init that needs a network or a Tiptap editor.
+vi.mock('#lib/queries/userTodos/useFetchUserTodos.js', () => ({
+	useFetchUserTodos: vi.fn(() => vi.fn(async () => [])),
+}));
+vi.mock('#lib/queries/userTodos/useUpdateUserTodo.js', () => ({
+	useUpdateUserTodo: vi.fn(() => ({ mutateAsync: vi.fn(), isPending: false })),
+}));
+vi.mock('#lib/queries/perspectives/useCreatePerspective.js', () => ({
+	useCreatePerspective: vi.fn(() => ({ mutateAsync: vi.fn(), isPending: false })),
+}));
+vi.mock('#lib/queries/perspectives/useUpdatePerspective.js', () => ({
+	useUpdatePerspective: vi.fn(() => ({ mutateAsync: vi.fn(), isPending: false })),
+}));
+vi.mock('#lib/queries/perspectives/useDeletePerspective.js', () => ({
+	useDeletePerspective: vi.fn(() => ({ mutate: vi.fn(), isPending: false })),
+}));
+vi.mock('#lib/utils/toast.js', () => ({ toastWithAction: vi.fn() }));
+vi.mock('#lib/utils/perspectiveDraft.js', () => ({
+	draftKey: (contentId: number, userId: number) => `draft:${contentId}:${userId}`,
+	saveDraft: vi.fn(),
+	loadDraft: vi.fn(() => null),
+	clearDraft: vi.fn(),
+}));
+vi.mock('#lib/components/CommentsEditor.svelte', async () => {
+	const mod = await import('../helpers/FakeCommentsEditor.svelte');
+	return { default: mod.default };
+});
+vi.mock('svelte-sonner', () => ({ toast: { success: vi.fn(), error: vi.fn(), info: vi.fn() } }));
+
+const CONTENT_ID = 21;
+
+/** Numbers the fake backend reports, by emoji. */
+const STATS: Record<string, { count: number; totalPerspectives: number }> = {
+	'🥰': { count: 3, totalPerspectives: 12 },
+	'😄': { count: 5, totalPerspectives: 12 },
+	'🫠': { count: 1, totalPerspectives: 4 },
+};
+
+function deferred<T>() {
+	let resolve!: (value: T) => void;
+	const promise = new Promise<T>((r) => (resolve = r));
+	return { promise, resolve };
+}
+
+function renderPopover(props: Record<string, unknown> = {}) {
+	const queryClient = makeClient();
+	render(TestWrapper, {
+		props: {
+			queryClient,
+			component: PerspectivePopover,
+			props: { contentId: CONTENT_ID, contentName: 'Test Content', userId: 42, onClose: vi.fn(), open: true, ...props },
+		},
+	});
+	return queryClient;
+}
+
+/** An existing perspective carrying the given feelings, so the popover opens with them picked. */
+function perspectiveWith(feelings: { emoji: string; label: string | null }[]) {
+	return {
+		id: '4',
+		quality: null,
+		agreement: null,
+		importance: null,
+		confidence: null,
+		like: null,
+		feelings: feelings.map((f) => ({ ...f, intensity: 7000, note: null })),
+	};
+}
+
+const wheelButton = (label: string) => screen.getByRole('button', { name: label });
+const statsLine = () => screen.queryByTestId('feeling-stats');
+const lineText = () => statsLine()?.textContent;
+/** What `graphqlClient.request` would put in the JSON body: `undefined` variables are dropped. */
+const sentVariables = (call: number) => JSON.parse(JSON.stringify(mocks.graphqlRequest.mock.calls[call][1]));
+const settle = async () => {
+	await new Promise<void>((resolve) => setTimeout(resolve, 0));
+	await tick();
+};
+
+// Pay the popover's first-render cost before any test, not inside the first one (#728).
+warmUp(() => renderPopover());
+
+describe('PerspectivePopover: feeling stats under the wheel', () => {
+	beforeEach(() => {
+		mocks.graphqlRequest.mockReset();
+		mocks.graphqlRequest.mockImplementation(async (_doc, variables) => ({
+			feelingStats: STATS[String(variables?.emoji)] ?? { count: 0, totalPerspectives: 0 },
+		}));
+	});
+
+	it('shows nothing, and sends no request, until a feeling is picked', async () => {
+		renderPopover();
+		await settle();
+		expect(statsLine()).not.toBeInTheDocument();
+		expect(mocks.graphqlRequest).not.toHaveBeenCalled();
+	});
+
+	it('after picking a feeling, asks for it scoped to the content being edited and shows "N of M perspectives felt <emoji> <label>"', async () => {
+		renderPopover();
+		await fireEvent.click(wheelButton('Love'));
+
+		expect(await screen.findByTestId('feeling-stats')).toBeInTheDocument();
+		expect(lineText()).toBe('3 of 12 perspectives felt 🥰 Love');
+		expect(mocks.graphqlRequest).toHaveBeenCalledTimes(1);
+		expect(mocks.graphqlRequest.mock.calls[0][0]).toBe(GET_FEELING_STATS);
+		expect(sentVariables(0)).toEqual({ contentID: CONTENT_ID, emoji: '🥰', label: 'Love' });
+	});
+
+	it('places the line under the wheel, inside the wheel column', async () => {
+		renderPopover();
+		await fireEvent.click(wheelButton('Love'));
+		const line = await screen.findByTestId('feeling-stats');
+		expect(screen.getByTestId('feel-wheel-column')).toContainElement(line);
+		expect(wheelButton('Love').compareDocumentPosition(line) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+	});
+
+	it('shows nothing while the numbers load, then the line once they arrive', async () => {
+		const pending = deferred<unknown>();
+		mocks.graphqlRequest.mockImplementation(() => pending.promise);
+		renderPopover();
+		await fireEvent.click(wheelButton('Love'));
+		await vi.waitFor(() => expect(mocks.graphqlRequest).toHaveBeenCalledTimes(1));
+		await settle();
+		expect(statsLine()).not.toBeInTheDocument();
+
+		pending.resolve({ feelingStats: STATS['🥰'] });
+		expect(await screen.findByTestId('feeling-stats')).toHaveTextContent('3 of 12 perspectives felt 🥰 Love');
+	});
+
+	it('shows nothing when the request fails', async () => {
+		mocks.graphqlRequest.mockRejectedValue(new Error('network down'));
+		const queryClient = renderPopover();
+		await fireEvent.click(wheelButton('Love'));
+		const loveKey = queryKeys.content.feelingStats(String(CONTENT_ID), '🥰', 'Love');
+		await vi.waitFor(() => expect(queryClient.getQueryState(loveKey)?.status).toBe('error'));
+		await settle();
+		expect(statsLine()).not.toBeInTheDocument();
+		// The picked feeling is untouched: a failed lookup never blocks the editor.
+		expect(screen.getByRole('button', { name: 'Remove Love' })).toBeInTheDocument();
+	});
+
+	it('hides a line it was already showing when a later refetch fails, rather than keep showing old numbers', async () => {
+		const queryClient = renderPopover();
+		await fireEvent.click(wheelButton('Love'));
+		await screen.findByTestId('feeling-stats');
+
+		mocks.graphqlRequest.mockRejectedValue(new Error('network down'));
+		const loveKey = queryKeys.content.feelingStats(String(CONTENT_ID), '🥰', 'Love');
+		await queryClient.invalidateQueries({ queryKey: loveKey });
+		await vi.waitFor(() => expect(queryClient.getQueryState(loveKey)?.status).toBe('error'));
+		// TanStack keeps the last good data on a failed refetch; the line must not.
+		expect(queryClient.getQueryData(loveKey)).toEqual(STATS['🥰']);
+		await settle();
+		expect(statsLine()).not.toBeInTheDocument();
+	});
+
+	it('omits the label, in the request and in the line, when the feeling has none', async () => {
+		renderPopover({ existingPerspective: perspectiveWith([{ emoji: '🫠', label: null }]) });
+
+		expect(await screen.findByTestId('feeling-stats')).toBeInTheDocument();
+		expect(sentVariables(0)).toEqual({ contentID: CONTENT_ID, emoji: '🫠' });
+		expect(lineText()).toBe('1 of 4 perspectives felt 🫠');
+	});
+
+	it('treats an empty label as no label', async () => {
+		renderPopover({ existingPerspective: perspectiveWith([{ emoji: '🥰', label: '' }]) });
+
+		expect(await screen.findByTestId('feeling-stats')).toBeInTheDocument();
+		expect(sentVariables(0)).toEqual({ contentID: CONTENT_ID, emoji: '🥰' });
+		expect(lineText()).toBe('3 of 12 perspectives felt 🥰');
+	});
+
+	it('edit mode: feelings the perspective already carries count as picked', async () => {
+		renderPopover({ existingPerspective: perspectiveWith([{ emoji: '😄', label: 'Joyful' }]) });
+
+		expect(await screen.findByTestId('feeling-stats')).toBeInTheDocument();
+		expect(lineText()).toBe('5 of 12 perspectives felt 😄 Joyful');
+	});
+
+	it('describes only the first picked feeling, and moves to the next one when it is removed', async () => {
+		renderPopover();
+		await fireEvent.click(wheelButton('Love'));
+		await screen.findByTestId('feeling-stats');
+
+		// A second pick neither changes the line nor costs a request.
+		await fireEvent.click(wheelButton('Joyful'));
+		await settle();
+		expect(lineText()).toBe('3 of 12 perspectives felt 🥰 Love');
+		expect(mocks.graphqlRequest).toHaveBeenCalledTimes(1);
+
+		// Removing the first leaves Joyful first: its numbers load, and Love's never show against it.
+		const joyful = deferred<unknown>();
+		mocks.graphqlRequest.mockImplementation(() => joyful.promise);
+		await fireEvent.click(screen.getByRole('button', { name: 'Remove Love' }));
+		await vi.waitFor(() => expect(mocks.graphqlRequest).toHaveBeenCalledTimes(2));
+		await settle();
+		expect(statsLine()).not.toBeInTheDocument();
+		expect(sentVariables(1)).toEqual({ contentID: CONTENT_ID, emoji: '😄', label: 'Joyful' });
+
+		joyful.resolve({ feelingStats: STATS['😄'] });
+		await screen.findByTestId('feeling-stats');
+		expect(lineText()).toBe('5 of 12 perspectives felt 😄 Joyful');
+	});
+
+	it('goes away when the last feeling is removed', async () => {
+		renderPopover();
+		await fireEvent.click(wheelButton('Love'));
+		await screen.findByTestId('feeling-stats');
+
+		await fireEvent.click(screen.getByRole('button', { name: 'Remove Love' }));
+		await settle();
+		expect(statsLine()).not.toBeInTheDocument();
+	});
+
+	it('editing the picked feeling (a note) neither refetches nor hides the line', async () => {
+		renderPopover();
+		await fireEvent.click(wheelButton('Love'));
+		await screen.findByTestId('feeling-stats');
+
+		await fireEvent.input(screen.getByPlaceholderText(/Why \/ nuance/), { target: { value: 'it was lovely' } });
+		await settle();
+		expect(lineText()).toBe('3 of 12 perspectives felt 🥰 Love');
+		expect(mocks.graphqlRequest).toHaveBeenCalledTimes(1);
+	});
+});
