+func TestHub_IdleKeysAreBoundedAndTheOldestGoFirst(t *testing.T) {
+	h := newTestHub(time.Hour, time.Now)
+	const extra = 10
+
+	for i := 0; i < maxIdleKeys+extra; i++ {
+		touchIdle(h, idleKey(i), i+1)
+	}
+
+	assert.Equal(t, maxIdleKeys, h.keyCount(), "no more than maxIdleKeys idle keys are kept")
+	assert.Equal(t, maxIdleKeys, h.idleKeyCount())
+	for i := 0; i < extra; i++ {
+		assert.False(t, h.hasKey(idleKey(i)), "key %d went idle first and is evicted", i)
+	}
+	for i := extra; i < maxIdleKeys+extra; i++ {
+		assert.True(t, h.hasKey(idleKey(i)), "key %d is among the newest idle keys and is kept", i)
+	}
+}
