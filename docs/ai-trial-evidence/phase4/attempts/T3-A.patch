+func TestHub_UpdatingAnIdleKeyThatStaysIdleDoesNotRestartItsIdleTime(t *testing.T) {
+	h := newTestHub(time.Hour, time.Now)
+	for i := 0; i < maxIdleKeys; i++ {
+		touchIdle(h, idleKey(i), i)
+	}
+
+	touchIdle(h, idleKey(0), 99) // changes state, but it never stopped being idle
+	touchIdle(h, idleKey(maxIdleKeys), 0)
+
+	assert.False(t, h.hasKey(idleKey(0)), "it has been idle since before the others")
+	assert.True(t, h.hasKey(idleKey(1)))
+}
