+func TestHub_ASubscribedKeyIsNeverEvicted(t *testing.T) {
+	h := newTestHub(time.Hour, time.Now)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	ch := h.subscribe(ctx, "watched") // the oldest key by far
+	recvHub(t, ch)
+
+	for i := 0; i < 2*maxIdleKeys; i++ {
+		touchIdle(h, idleKey(i), i)
+	}
+
+	require.True(t, h.hasKey("watched"), "a key with a subscriber outlives any number of idle ones")
+	assert.Equal(t, maxIdleKeys+1, h.keyCount(), "the bound counts idle keys only")
+	h.update("watched", setCounter(7, false, publishNow))
+	assert.Equal(t, 7, recvHub(t, ch).N, "its subscriber still gets what is published")
+
+	// Once its last subscriber leaves it is just another idle key: the newest,
+	// so it pushes the oldest idle key out rather than itself.
+	cancel()
+	require.Eventually(t, func() bool { return h.keyCount() == maxIdleKeys }, time.Second, 5*time.Millisecond)
+	assert.True(t, h.hasKey("watched"))
+	assert.False(t, h.hasKey(idleKey(maxIdleKeys)), "the oldest idle key made room")
+}
+
+func TestHub_ARunningKeyIsNeverEvicted(t *testing.T) {
+	h := newTestHub(10*time.Millisecond, time.Now)
+	h.update("running", setCounter(1, true, keep)) // the oldest key, with a ticker
+
+	for i := 0; i < 2*maxIdleKeys; i++ {
+		touchIdle(h, idleKey(i), i)
+	}
+
+	require.True(t, h.hasKey("running"), "a key with work in flight outlives any number of idle ones")
+	assert.True(t, h.isTicking("running"))
+	assert.Equal(t, maxIdleKeys+1, h.keyCount(), "the bound counts idle keys only")
+
+	// Finished, it becomes the newest idle key and pushes the oldest one out.
+	stopTicking(t, h, "running")
+	assert.True(t, h.hasKey("running"))
+	assert.Equal(t, maxIdleKeys, h.keyCount())
+	assert.False(t, h.hasKey(idleKey(maxIdleKeys)), "the oldest idle key made room")
+}
