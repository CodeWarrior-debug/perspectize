+func TestHub_AnEvictedKeyStartsFromFreshStateAndAKeptOneKeepsIt(t *testing.T) {
+	h := newTestHub(time.Hour, time.Now)
+	for i := 0; i <= maxIdleKeys; i++ { // one more than fits: key 0 is evicted
+		touchIdle(h, idleKey(i), i+100)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	evicted := recvHub(t, h.subscribe(ctx, idleKey(0)))
+	kept := recvHub(t, h.subscribe(ctx, idleKey(1)))
+
+	assert.Equal(t, 0, evicted.N, "an evicted key is rebuilt from newState")
+	assert.Equal(t, 101, kept.N, "a kept idle key still holds its last state")
+}
+
+func TestHub_EvictsTheKeyThatWentIdleLongestAgoNotTheOldestCreated(t *testing.T) {
+	h := newTestHub(time.Hour, time.Now)
+	for i := 0; i < maxIdleKeys; i++ {
+		touchIdle(h, idleKey(i), i)
+	}
+	// Key 0 was created first, but it is busy for a while and then goes idle
+	// again, so it is now the key that went idle most recently.
+	ctx, cancel := context.WithCancel(context.Background())
+	h.subscribe(ctx, idleKey(0))
+	require.Equal(t, maxIdleKeys-1, h.idleKeyCount(), "a subscribed key is not idle")
+	cancel()
+	require.Eventually(t, func() bool { return h.idleKeyCount() == maxIdleKeys }, time.Second, 5*time.Millisecond)
+
+	touchIdle(h, idleKey(maxIdleKeys), 0) // one over the limit
+
+	assert.True(t, h.hasKey(idleKey(0)), "the key that went idle again most recently survives")
+	assert.False(t, h.hasKey(idleKey(1)), "the key that has been idle longest is the one evicted")
+	assert.Equal(t, maxIdleKeys, h.keyCount())
+}
