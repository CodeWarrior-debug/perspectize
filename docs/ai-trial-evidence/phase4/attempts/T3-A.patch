+// now. Call it after anything that can change that: an update, a ticker
+// stopping, a subscriber arriving or leaving. An entry joins the back of the
+// list when it goes idle and leaves it when it stops being idle, so the front
+// is the entry that went idle longest ago; joining past maxIdleKeys evicts from
+// the front. An evicted entry has no subscriber and no ticker, so nothing else
+// holds it.
+func (h *latestHub[K, V, S]) settleLocked(key K, e *hubEntry[V, S]) {
+	idle := !e.ticking && len(e.subs) == 0 && !h.active(e.state)
