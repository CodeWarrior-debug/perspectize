+func TestProgress_FinishedJobsAreBoundedButARunningOneIsKept(t *testing.T) {
+	tr := newImportProgressTracker(5*time.Millisecond, time.Now)
+	tr.begin(1, 10) // still running when every other job has finished
+	t.Cleanup(func() { tr.end(1) })
+
+	for id := 2; id < 2+2*maxIdleKeys; id++ {
+		tr.begin(id, 1)
+		tr.record(id, domain.ImportItemStatusImported)
+		tr.end(id)
+	}
+
+	// Once the finished jobs' tickers have wound down, only maxIdleKeys of them
+	// are left besides the running one.
+	require.Eventually(t, func() bool {
+		return tr.keyCount() == maxIdleKeys+1 && tr.idleKeyCount() == maxIdleKeys
+	}, 3*time.Second, 5*time.Millisecond)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	p := next(t, tr.subscribe(ctx, 1))
+	assert.True(t, p.Running, "a running import is never evicted")
+	assert.Equal(t, 10, p.Total)
+}
