+// NormalizeMovieLink turns a pasted TMDB movie link into the canonical movie URL
+// the content service stores (https://www.themoviedb.org/movie/603), so an
+// import list holds the same URL the row is later created under. It uses the
+// content service's own parser and URL builder, so the two cannot disagree on
+// what counts as a movie link.
+//
+// Only a TMDB link is accepted. An IMDb link or id parses as a movie reference
+// but names no TMDB id until TMDB resolves it, which is a network call a list
+// build does not make; it is refused like any other string. Every failure wraps
+// domain.ErrInvalidInput.
+func (s *ImportService) NormalizeMovieLink(raw string) (string, error) {
+	tmdbID, imdbID, err := tmdb.ParseMovieInput(raw)
+	if err != nil {
+		return "", fmt.Errorf("%w: %v", domain.ErrInvalidInput, err)
+	}
+	if tmdbID == 0 {
+		return "", fmt.Errorf("%w: %q is an IMDb title; paste its TMDB movie link instead", domain.ErrInvalidInput, imdbID)
+	}
+	return tmdb.CanonicalMovieURL(tmdbID), nil
+}
