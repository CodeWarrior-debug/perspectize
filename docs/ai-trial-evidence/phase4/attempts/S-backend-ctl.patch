+package services_test
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/CodeWarrior-debug/perspectize/backend/internal/core/domain"
+	portservices "github.com/CodeWarrior-debug/perspectize/backend/internal/core/ports/services"
+	"github.com/CodeWarrior-debug/perspectize/backend/internal/core/services"
+)
+
+// tmdbMovieLinks are pasted forms of the TMDB link for movie 603 (The Matrix).
+var tmdbMovieLinks = []string{
+	"https://www.themoviedb.org/movie/603-the-matrix?language=en",
+	"https://www.themoviedb.org/movie/603-the-matrix",
+	"https://www.themoviedb.org/movie/603",
+	"https://www.themoviedb.org/movie/603/",
+	"https://www.themoviedb.org/movie/603/cast",
+	"https://www.themoviedb.org/movie/603?language=en",
+	"https://www.themoviedb.org/movie/603#cast",
+	"http://themoviedb.org/movie/603-the-matrix",
+	"HTTPS://WWW.THEMOVIEDB.ORG/MOVIE/603-the-matrix",
+	"  https://www.themoviedb.org/movie/603-the-matrix\n",
+}
+
+func TestImportService_NormalizeMovieLink_TMDBLinkBecomesTheCanonicalURL(t *testing.T) {
+	svc := newImportService(newFakeImportRepo(), nil, nil, &fakeCreator{})
+
+	for _, raw := range tmdbMovieLinks {
+		t.Run(raw, func(t *testing.T) {
+			got, err := svc.NormalizeMovieLink(raw)
+			require.NoError(t, err)
+			assert.Equal(t, "https://www.themoviedb.org/movie/603", got)
+		})
+	}
+}
+
+func TestImportService_NormalizeMovieLink_KeepsTheMovieID(t *testing.T) {
+	svc := newImportService(newFakeImportRepo(), nil, nil, &fakeCreator{})
+
+	got, err := svc.NormalizeMovieLink("https://www.themoviedb.org/movie/27205-inception?language=fr")
+	require.NoError(t, err)
+	assert.Equal(t, "https://www.themoviedb.org/movie/27205", got)
+}
+
+func TestImportService_NormalizeMovieLink_IsIdempotent(t *testing.T) {
+	svc := newImportService(newFakeImportRepo(), nil, nil, &fakeCreator{})
+
+	once, err := svc.NormalizeMovieLink("https://www.themoviedb.org/movie/603-the-matrix?language=en")
+	require.NoError(t, err)
+	twice, err := svc.NormalizeMovieLink(once)
+	require.NoError(t, err)
+	assert.Equal(t, once, twice)
+}
+
+func TestImportService_NormalizeMovieLink_RefusesAnythingElse(t *testing.T) {
+	svc := newImportService(newFakeImportRepo(), nil, nil, &fakeCreator{})
+
+	cases := map[string]string{
+		"imdb url":            "https://www.imdb.com/title/tt0133093/",
+		"imdb url with query": "https://www.imdb.com/title/tt0133093/?ref_=fn_al_tt_1",
+		"bare imdb id":        "tt0133093",
+		"upper case imdb id":  "TT0133093",
+		"short imdb id":       "tt123",
+		"tmdb tv show":        "https://www.themoviedb.org/tv/1396-breaking-bad",
+		"tmdb person":         "https://www.themoviedb.org/person/525-christopher-nolan",
+		"tmdb movie no id":    "https://www.themoviedb.org/movie/the-matrix",
+		"tmdb movie id zero":  "https://www.themoviedb.org/movie/0",
+		"tmdb movie id glued": "https://www.themoviedb.org/movie/603abc",
+		"youtube video":       "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
+		"web page":            "https://example.com/some/article",
+		"bare number":         "603",
+		"plain text":          "the matrix",
+		"empty":               "",
+		"whitespace":          "   \t\n",
+	}
+	for name, raw := range cases {
+		t.Run(name, func(t *testing.T) {
+			got, err := svc.NormalizeMovieLink(raw)
+			require.Error(t, err)
+			assert.ErrorIs(t, err, domain.ErrInvalidInput)
+			assert.Empty(t, got, "a refused link yields no URL")
+		})
+	}
+}
+
+func TestImportService_NormalizeMovieLink_IMDbRefusalPointsToTMDB(t *testing.T) {
+	svc := newImportService(newFakeImportRepo(), nil, nil, &fakeCreator{})
+
+	_, err := svc.NormalizeMovieLink("https://www.imdb.com/title/tt0133093/")
+	require.Error(t, err)
+	assert.ErrorIs(t, err, domain.ErrInvalidInput)
+	assert.Contains(t, err.Error(), "tt0133093")
+	assert.Contains(t, err.Error(), "TMDB")
+}
+
+// The list URL and the stored URL must be the same string, or the "already in
+// your library" match on an import row misses. Run the same links through the
+// content service's create path and compare what it saves.
+func TestImportService_NormalizeMovieLink_MatchesWhatContentServiceStores(t *testing.T) {
+	svc := newImportService(newFakeImportRepo(), nil, nil, &fakeCreator{})
+
+	for _, raw := range tmdbMovieLinks {
+		t.Run(raw, func(t *testing.T) {
+			mc := &mockMovieClient{getMovieFn: func(context.Context, int) (*portservices.MovieMetadata, error) {
+				return movieMeta(nil), nil
+			}}
+			var stored string
+			repo := &mockContentRepository{getOrCreateByURLFn: func(_ context.Context, c *domain.Content, _ bool) (*domain.Content, bool, error) {
+				require.NotNil(t, c.URL)
+				stored = *c.URL
+				return c, false, nil
+			}}
+			content := services.NewContentService(repo, nil, mc)
+
+			_, err := content.CreateFromMovie(context.Background(), raw, 1)
+			require.NoError(t, err)
+
+			got, err := svc.NormalizeMovieLink(raw)
+			require.NoError(t, err)
+			assert.Equal(t, stored, got)
+		})
+	}
+}
