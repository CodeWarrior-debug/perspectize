+/** The row order a list was last shown in, remembered against the (hashed) query key it was shown for. */
+export interface RowOrderMemo {
+	key: string;
+	ids: string[];
+}
+
+/**
+ * Keeps a refetched list in the order the user is looking at. The server orders by `updatedAt desc`,
+ * so a row the user just edited comes back first and jumps out of view; this puts it back.
+ *
+ * While `key` matches the memo, rows already shown keep their shown order and rows the memo has
+ * not seen lead in server order (new rows lead, as the default sort does). A different `key` (a new
+ * sort, filter, search or page) starts from the server order, and so does a list that is not
+ * `enabled`, which also forgets the memo. A `placeholder` list (the previous key's rows shown while
+ * the new key loads) is returned as given and never recorded; the memo moves on to the new key with
+ * nothing remembered (a placeholder means this key has shown no rows), so the first real rows for it
+ * are shown in server order.
+ *
+ * Pure and idempotent: feeding its own output memo the same rows returns the same order, so the caller
+ * may evaluate it more than once per fetch. ActivityTable keeps the memo in a plain variable.
+ */
+export function keepRowOrder<T extends { id: string | number }>(
+	memo: RowOrderMemo | null,
+	input: { key: string; rows: readonly T[]; placeholder: boolean; enabled: boolean },
+): { rows: readonly T[]; memo: RowOrderMemo | null } {
+	const { key, rows, placeholder, enabled } = input;
+	if (!enabled) return { rows, memo: null };
+	if (placeholder) return { rows, memo: { key, ids: [] } };
+
+	const ids = memo?.key === key ? memo.ids : [];
+	const rank = new Map(ids.map((id, index) => [id, index]));
+	const fresh: T[] = [];
+	const kept: T[] = [];
+	for (const row of rows) (rank.has(String(row.id)) ? kept : fresh).push(row);
+	kept.sort((a, b) => (rank.get(String(a.id)) ?? 0) - (rank.get(String(b.id)) ?? 0));
+
+	const ordered = [...fresh, ...kept];
+	return { rows: ordered, memo: { key, ids: ordered.map((row) => String(row.id)) } };
+}
