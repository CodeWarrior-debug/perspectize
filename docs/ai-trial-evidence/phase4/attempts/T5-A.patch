+/**
+ * keepRowOrder keeps the Library list in the order the user is looking at across refetches of the
+ * same query key (an edited row comes back first from the server, but must not jump), while a new
+ * key, a non-Loaded list or placeholder data never inherits an order.
+ */
+import { describe, it, expect } from 'vitest';
+import { hashKey } from '@tanstack/svelte-query';
+import { activityListRequest, keepRowOrder, type RowOrderMemo } from '$lib/queries/content';
+import { parseGridParams } from '$lib/utils/gridUrlState';
+
+type Row = { id: string; name: string };
+
+const row = (id: string, name = `row ${id}`): Row => ({ id, name });
+const rows = (...ids: string[]) => ids.map((id) => row(id));
+const idsOf = (list: readonly Row[]) => list.map((r) => r.id);
+
+const K1 = 'key-1';
+const K2 = 'key-2';
+
+/** One render of the list: feeds the memo from the previous step back in, like the component does. */
+function show(
+	memo: RowOrderMemo | null,
+	key: string,
+	list: readonly Row[],
+	opts: { placeholder?: boolean; enabled?: boolean } = {},
+) {
+	return keepRowOrder(memo, { key, rows: list, placeholder: false, enabled: true, ...opts });
+}
+
+describe('keepRowOrder', () => {
+	it('shows the first load in server order and remembers it', () => {
+		const first = show(null, K1, rows('a', 'b', 'c'));
+		expect(idsOf(first.rows)).toEqual(['a', 'b', 'c']);
+		expect(first.memo).toEqual({ key: K1, ids: ['a', 'b', 'c'] });
+	});
+
+	it('keeps the shown order when a refetch returns the edited row first', () => {
+		const first = show(null, K1, rows('a', 'b', 'c'));
+		const edited = [row('c', 'row c (edited)'), row('a'), row('b')];
+		const again = show(first.memo, K1, edited);
+		expect(idsOf(again.rows)).toEqual(['a', 'b', 'c']);
+		// The fresh data is what is shown, only the position is kept.
+		expect(again.rows[2]).toBe(edited[0]);
+		expect(again.rows[2].name).toBe('row c (edited)');
+	});
+
+	it('keeps the shown order across several refetches, edit after edit', () => {
+		let step = show(null, K1, rows('a', 'b', 'c', 'd'));
+		step = show(step.memo, K1, rows('d', 'a', 'b', 'c'));
+		step = show(step.memo, K1, rows('b', 'd', 'a', 'c'));
+		step = show(step.memo, K1, rows('c', 'b', 'd', 'a'));
+		expect(idsOf(step.rows)).toEqual(['a', 'b', 'c', 'd']);
+	});
+
+	it('puts new rows first, in server order, ahead of the kept order', () => {
+		const first = show(null, K1, rows('a', 'b', 'c'));
+		// x and y are new; c was edited, so the server also moved it to the front of the old rows.
+		const again = show(first.memo, K1, rows('x', 'y', 'c', 'a', 'b'));
+		expect(idsOf(again.rows)).toEqual(['x', 'y', 'a', 'b', 'c']);
+		// The new rows are now part of the shown order too.
+		const next = show(again.memo, K1, rows('b', 'x', 'y', 'a', 'c'));
+		expect(idsOf(next.rows)).toEqual(['x', 'y', 'a', 'b', 'c']);
+	});
+
+	it('drops a row the server no longer returns and keeps the rest in place', () => {
+		const first = show(null, K1, rows('a', 'b', 'c'));
+		const again = show(first.memo, K1, rows('c', 'a'));
+		expect(idsOf(again.rows)).toEqual(['a', 'c']);
+		expect(again.memo?.ids).toEqual(['a', 'c']);
+	});
+
+	it('does not bring a dropped row back at its old position when it returns (it is new)', () => {
+		const first = show(null, K1, rows('a', 'b', 'c'));
+		const gone = show(first.memo, K1, rows('a', 'c'));
+		const back = show(gone.memo, K1, rows('b', 'a', 'c'));
+		expect(idsOf(back.rows)).toEqual(['b', 'a', 'c']);
+	});
+
+	it('starts from the server order when the key changes (new sort, filter, search or page)', () => {
+		const first = show(null, K1, rows('a', 'b', 'c'));
+		const next = show(first.memo, K2, rows('c', 'a', 'b'));
+		expect(idsOf(next.rows)).toEqual(['c', 'a', 'b']);
+		expect(next.memo).toEqual({ key: K2, ids: ['c', 'a', 'b'] });
+	});
+
+	it('starts from the server order when going back to an earlier key', () => {
+		const one = show(null, K1, rows('a', 'b', 'c'));
+		const two = show(one.memo, K2, rows('x', 'y'));
+		const back = show(two.memo, K1, rows('c', 'a', 'b'));
+		expect(idsOf(back.rows)).toEqual(['c', 'a', 'b']);
+	});
+
+	describe('placeholder data', () => {
+		it('is returned as given, not reordered by the order shown for the previous key', () => {
+			const first = show(null, K1, rows('a', 'b', 'c'));
+			const placeholderRows = rows('c', 'a', 'b');
+			const loading = show(first.memo, K2, placeholderRows, { placeholder: true });
+			expect(loading.rows).toBe(placeholderRows);
+		});
+
+		it('is not recorded: the first real rows for the new key are in server order', () => {
+			const first = show(null, K1, rows('a', 'b', 'c'));
+			const loading = show(first.memo, K2, rows('a', 'b', 'c'), { placeholder: true });
+			expect(loading.memo).toEqual({ key: K2, ids: [] });
+			const real = show(loading.memo, K2, rows('c', 'b', 'a'));
+			expect(idsOf(real.rows)).toEqual(['c', 'b', 'a']);
+		});
+
+		it('does not let the order shown for the old key carry over to the new key', () => {
+			const first = show(null, K1, rows('a', 'b', 'c'));
+			// K1's order is a, b, c; if it carried over, K2's c, b, a would come out as a, b, c.
+			const loading = show(first.memo, K2, rows('a', 'b', 'c'), { placeholder: true });
+			const real = show(loading.memo, K2, rows('c', 'b', 'a'));
+			expect(idsOf(real.rows)).toEqual(['c', 'b', 'a']);
+		});
+
+		it('clears anything remembered for the key it is shown under', () => {
+			const first = show(null, K1, rows('a', 'b', 'c'));
+			const loading = show(first.memo, K1, rows('c', 'b', 'a'), { placeholder: true });
+			expect(loading.memo).toEqual({ key: K1, ids: [] });
+		});
+	});
+
+	describe('when not enabled ("All Items" mode, or no data yet)', () => {
+		it('returns the rows as given and forgets the memo', () => {
+			const first = show(null, K1, rows('a', 'b', 'c'));
+			const input = rows('c', 'a', 'b');
+			const off = show(first.memo, K1, input, { enabled: false });
+			expect(off.rows).toBe(input);
+			expect(off.memo).toBeNull();
+		});
+
+		it('starts from the server order when it is enabled again, even under the same key', () => {
+			const first = show(null, K1, rows('a', 'b', 'c'));
+			const off = show(first.memo, K1, rows('a', 'b', 'c'), { enabled: false });
+			const on = show(off.memo, K1, rows('c', 'a', 'b'));
+			expect(idsOf(on.rows)).toEqual(['c', 'a', 'b']);
+		});
+	});
+
+	it('is idempotent: evaluating the same rows again changes nothing', () => {
+		const first = show(null, K1, rows('a', 'b', 'c'));
+		const edited = rows('c', 'x', 'a', 'b');
+		const once = show(first.memo, K1, edited);
+		const twice = show(once.memo, K1, edited);
+		expect(idsOf(twice.rows)).toEqual(idsOf(once.rows));
+		expect(twice.memo).toEqual(once.memo);
+	});
+
+	it('does not mutate the rows it is given', () => {
+		const first = show(null, K1, rows('a', 'b', 'c'));
+		const input = rows('c', 'a', 'b');
+		show(first.memo, K1, input);
+		expect(idsOf(input)).toEqual(['c', 'a', 'b']);
+	});
+
+	it('handles an empty list and an empty memo', () => {
+		const empty = show(null, K1, []);
+		expect(empty.rows).toEqual([]);
+		expect(empty.memo).toEqual({ key: K1, ids: [] });
+		expect(idsOf(show(empty.memo, K1, rows('a', 'b')).rows)).toEqual(['a', 'b']);
+	});
+
+	it('treats numeric and string ids alike', () => {
+		const first = keepRowOrder(null, {
+			key: K1,
+			rows: [{ id: 1 }, { id: 2 }, { id: 3 }],
+			placeholder: false,
+			enabled: true,
+		});
+		const again = keepRowOrder(first.memo, {
+			key: K1,
+			rows: [{ id: '3' }, { id: '1' }, { id: '2' }],
+			placeholder: false,
+			enabled: true,
+		});
+		expect(again.rows.map((r) => String(r.id))).toEqual(['1', '2', '3']);
+	});
+});
+
+describe('keepRowOrder with the real Activity list key', () => {
+	const keyFor = (qs: string, after: string | null = null) =>
+		hashKey(activityListRequest(parseGridParams(new URLSearchParams(qs)), after).queryKey);
+
+	it('Loaded mode: an unchanged URL keeps the same key, so the order is kept', () => {
+		expect(keyFor('')).toBe(keyFor(''));
+	});
+
+	it('Loaded mode: a client-side sort or column filter does not change the key, so the order is kept under them', () => {
+		expect(keyFor('sort=views.desc')).toBe(keyFor(''));
+		expect(keyFor('f.type=youtube_video&f.views=100..')).toBe(keyFor('f.type=youtube_video'));
+	});
+
+	it('a new search, Type filter or page size changes the key, so the order restarts', () => {
+		const base = keyFor('');
+		expect(keyFor('q=matrix')).not.toBe(base);
+		expect(keyFor('f.type=movie')).not.toBe(base);
+		expect(keyFor('pageSize=25')).not.toBe(base);
+	});
+
+	it('"All Items" mode: a new sort or page changes the key', () => {
+		const base = keyFor('mode=all');
+		expect(keyFor('mode=all&sort=views.desc')).not.toBe(base);
+		expect(keyFor('mode=all', 'cursor:10')).not.toBe(base);
+	});
+
+	it('switching between Loaded and All Items changes the key', () => {
+		expect(keyFor('mode=all')).not.toBe(keyFor(''));
+	});
+});
