@@ -0,0 +1,170 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { hashKey } from '@tanstack/svelte-query';
+import { preloadLazy } from '../helpers/warmUp';
+import { makeClient, mountConsumers, seed, invalidationOutcome } from '../helpers/queryBudget';
+
+const { mockGraphqlRequest } = vi.hoisted(() => ({ mockGraphqlRequest: vi.fn() }));
+
+let capturedQueryOptions: any;
+
+vi.mock('@tanstack/svelte-query', async (importOriginal) => {
+	const actual = await importOriginal<typeof import('@tanstack/svelte-query')>();
+	return {
+		...actual,
+		createQuery: vi.fn((optionsFn: () => any) => {
+			capturedQueryOptions = optionsFn();
+			return { data: undefined, isPending: true };
+		}),
+	};
+});
+
+vi.mock('#lib/queries/client.js', () => ({ graphqlRequest: mockGraphqlRequest }));
+
+const LOVE = { contentId: 5, emoji: '🥰', label: 'Love' };
+
+type Target = { contentId: number; emoji: string; label?: string | null } | null;
+
+async function mountStats(target: Target) {
+	const { useFeelingStats } = await import('#lib/queries/perspectives/useFeelingStats.js');
+	useFeelingStats(() => target);
+	return capturedQueryOptions;
+}
+
+// The tests import these inside their bodies; load them once up front so the first test
+// doesn't pay the module transform, which balloons under full-suite load (#728).
+preloadLazy(
+	() => import('#lib/queries/perspectives/index.js'),
+	() => import('#lib/queries/perspectives/useFeelingStats.js'),
+	() => import('#lib/queries/keys.js'),
+);
+
+describe('useFeelingStats', () => {
+	beforeEach(() => {
+		vi.clearAllMocks();
+		capturedQueryOptions = undefined;
+	});
+
+	it('is disabled when no feeling is picked, so no request is sent', async () => {
+		const options = await mountStats(null);
+		expect(options.enabled).toBe(false);
+		expect(await options.queryFn()).toBeNull();
+		expect(mockGraphqlRequest).not.toHaveBeenCalled();
+	});
+
+	it('is enabled for a feeling', async () => {
+		const options = await mountStats(LOVE);
+		expect(options.enabled).toBe(true);
+	});
+
+	it('sends contentID, emoji and label through the authenticated wrapper and unwraps feelingStats', async () => {
+		mockGraphqlRequest.mockResolvedValue({ feelingStats: { count: 3, totalPerspectives: 12 } });
+		const { GET_FEELING_STATS } = await import('#lib/queries/perspectives/index.js');
+		const options = await mountStats(LOVE);
+		const result = await options.queryFn();
+		expect(mockGraphqlRequest).toHaveBeenCalledWith(GET_FEELING_STATS, {
+			contentID: 5,
+			emoji: '🥰',
+			label: 'Love',
+		});
+		expect(result).toEqual({ count: 3, totalPerspectives: 12 });
+	});
+
+	it.each([
+		['null', null],
+		['undefined', undefined],
+		['empty', ''],
+	])('leaves the label out of the request when it is %s', async (_name, label) => {
+		mockGraphqlRequest.mockResolvedValue({ feelingStats: { count: 1, totalPerspectives: 2 } });
+		const options = await mountStats({ contentId: 5, emoji: '🫠', label });
+		await options.queryFn();
+		const variables = mockGraphqlRequest.mock.calls[0][1];
+		expect(variables.label).toBeUndefined();
+		expect(variables).toMatchObject({ contentID: 5, emoji: '🫠' });
+	});
+
+	it('returns null (not undefined) when the response has no feelingStats', async () => {
+		mockGraphqlRequest.mockResolvedValue({ feelingStats: null });
+		const options = await mountStats(LOVE);
+		expect(await options.queryFn()).toBeNull();
+	});
+
+	it('lets a failed request reject, so the query errors and the caller shows nothing', async () => {
+		mockGraphqlRequest.mockRejectedValue(new Error('boom'));
+		const options = await mountStats(LOVE);
+		await expect(options.queryFn()).rejects.toThrow('boom');
+	});
+
+	it('is cached for a deliberate window', async () => {
+		const { FEELING_STATS_STALE_TIME_MS } = await import('#lib/queries/perspectives/useFeelingStats.js');
+		const options = await mountStats(LOVE);
+		expect(options.staleTime).toBe(FEELING_STATS_STALE_TIME_MS);
+		expect(FEELING_STATS_STALE_TIME_MS).toBeGreaterThan(0);
+	});
+
+	describe('query key', () => {
+		it('changes with every variable the request sends, and is equal for an equal request', async () => {
+			const base = hashKey((await mountStats(LOVE)).queryKey);
+			const same = hashKey((await mountStats({ ...LOVE })).queryKey);
+			const otherContent = hashKey((await mountStats({ ...LOVE, contentId: 6 })).queryKey);
+			const otherEmoji = hashKey((await mountStats({ ...LOVE, emoji: '😄' })).queryKey);
+			const otherLabel = hashKey((await mountStats({ ...LOVE, label: 'Adore' })).queryKey);
+			const noLabel = hashKey((await mountStats({ ...LOVE, label: null })).queryKey);
+
+			expect(same).toBe(base);
+			expect(new Set([base, otherContent, otherEmoji, otherLabel, noLabel]).size).toBe(5);
+		});
+
+		it('treats a missing and an empty label alike, since neither is sent', async () => {
+			const none = hashKey((await mountStats({ ...LOVE, label: null })).queryKey);
+			const empty = hashKey((await mountStats({ ...LOVE, label: '' })).queryKey);
+			const undef = hashKey((await mountStats({ contentId: 5, emoji: '🥰' })).queryKey);
+			expect(empty).toBe(none);
+			expect(undef).toBe(none);
+		});
+	});
+
+	describe('cache contract (real QueryClient)', () => {
+		it('three components asking the same question cost one request', async () => {
+			mockGraphqlRequest.mockResolvedValue({ feelingStats: { count: 3, totalPerspectives: 12 } });
+			const options = await mountStats(LOVE);
+			const client = makeClient();
+			const unmount = await mountConsumers(client, options, 3);
+			expect(mockGraphqlRequest).toHaveBeenCalledTimes(1);
+			unmount();
+		});
+
+		it('a second mount inside staleTime costs no request', async () => {
+			mockGraphqlRequest.mockResolvedValue({ feelingStats: { count: 3, totalPerspectives: 12 } });
+			const options = await mountStats(LOVE);
+			const client = makeClient();
+			(await mountConsumers(client, options, 1))();
+			(await mountConsumers(client, options, 1))();
+			expect(mockGraphqlRequest).toHaveBeenCalledTimes(1);
+		});
+
+		it('is evicted by exactly what a perspective save evicts: that content, not another', async () => {
+			const { queryKeys } = await import('#lib/queries/keys.js');
+			const client = makeClient();
+			const mine = queryKeys.content.feelingStats('5', '🥰', 'Love');
+			const mineOther = queryKeys.content.feelingStats('5', '😄', 'Joyful');
+			const elsewhere = queryKeys.content.feelingStats('6', '🥰', 'Love');
+			for (const key of [mine, mineOther, elsewhere]) seed(client, key, { count: 1, totalPerspectives: 2 });
+
+			// What useCreatePerspective / useUpdatePerspective / useDeletePerspective run on success.
+			await client.invalidateQueries({ queryKey: queryKeys.content.detail('5') });
+
+			const outcome = invalidationOutcome(client, [mine, mineOther, elsewhere]);
+			expect(outcome.invalidated).toEqual([mine, mineOther]);
+			expect(outcome.untouched).toEqual([elsewhere]);
+		});
+
+		it('is not evicted by a content list invalidation', async () => {
+			const { queryKeys } = await import('#lib/queries/keys.js');
+			const client = makeClient();
+			const key = queryKeys.content.feelingStats('5', '🥰', 'Love');
+			seed(client, key, { count: 1, totalPerspectives: 2 });
+			await client.invalidateQueries({ queryKey: queryKeys.content.lists() });
+			expect(invalidationOutcome(client, [key]).untouched).toEqual([key]);
+		});
+	});
+});
