@@ -0,0 +1,49 @@
+import { createQuery } from '@tanstack/svelte-query';
+import { graphqlRequest } from '../client';
+import { GET_FEELING_STATS, type FeelingStats, type FeelingStatsResponse } from './index';
+import { queryKeys } from '../keys';
+
+/**
+ * The figures are context for a pick, not live data: they only move when someone saves a
+ * perspective, and the viewer's own saves evict them (the key sits under `content.detail`,
+ * which every perspective mutation invalidates). Deliberate, not the 60s client default.
+ */
+export const FEELING_STATS_STALE_TIME_MS = 5 * 60 * 1000;
+
+/** One feeling on one content item: what `feelingStats(contentID, emoji, label)` is asked about. */
+export interface FeelingStatsTarget {
+	contentId: number;
+	emoji: string;
+	/** Absent or empty when the feeling has no label; it is then left out of the request. */
+	label?: string | null;
+}
+
+/**
+ * How many of a content item's perspectives carry one feeling (`feelingStats`).
+ *
+ * `getTarget` returning `null` disables the query (nothing picked yet, so no request). Until the
+ * figures arrive, and if the request fails, `data` stays `undefined`: callers render nothing.
+ * Must be called during component init.
+ */
+export function useFeelingStats(getTarget: () => FeelingStatsTarget | null) {
+	return createQuery(() => {
+		// Read the target synchronously, so the key and the request always agree on it.
+		const target = getTarget();
+		const label = target?.label ? target.label : null;
+		return {
+			queryKey: queryKeys.content.feelingStats(String(target?.contentId ?? ''), target?.emoji ?? '', label),
+			queryFn: async (): Promise<FeelingStats | null> => {
+				if (target === null) return null;
+				const res = await graphqlRequest<FeelingStatsResponse>(GET_FEELING_STATS, {
+					contentID: target.contentId,
+					emoji: target.emoji,
+					// undefined, not null: the key is dropped from the request body, not sent as null.
+					label: label ?? undefined,
+				});
+				return res.feelingStats ?? null;
+			},
+			enabled: target !== null,
+			staleTime: FEELING_STATS_STALE_TIME_MS,
+		};
+	});
+}
