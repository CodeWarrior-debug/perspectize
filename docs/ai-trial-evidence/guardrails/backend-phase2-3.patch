@@ -0,0 +1,31 @@
+#!/bin/bash
+# PostToolUse hook (Edit|Write|MultiEdit): runs the "fast" tier of the track that owns the edited file
+# (backend/scripts/check.sh or frontend/scripts/check.sh).
+#
+# Silent on success. On failure it prints the findings to stderr and exits 2, which is how a
+# PostToolUse hook puts text in front of the model (exit 0 never reaches it).
+#
+# The checkout comes from the edited file's own git root, not from CLAUDE_PROJECT_DIR: in a git
+# worktree the project dir can be a different checkout from the one being edited. A track whose
+# check.sh does not exist in that checkout is skipped, so this file is identical on both trial branches.
+
+input=$(cat)
+file=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty')
+[ -n "$file" ] || exit 0
+dir=$(dirname "$file")
+[ -d "$dir" ] || exit 0
+root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || exit 0
+
+case "$file" in
+  "$root"/backend/*)  script="$root/backend/scripts/check.sh" ;;
+  "$root"/frontend/*) script="$root/frontend/scripts/check.sh" ;;
+  *) exit 0 ;;
+esac
+[ -f "$script" ] || exit 0
+
+out=$(bash "$script" fast "$file" 2>&1)
+if [ $? -ne 0 ]; then
+  printf '%s\n' "$out" >&2
+  exit 2
+fi
+exit 0
