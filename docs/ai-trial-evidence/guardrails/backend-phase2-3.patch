+# Architecture rules B1 and B3, checked by go-arch-lint (run through backend/scripts/arch-check.sh).
+#
+#   B1  Core isolation. domain imports nothing from this repo and no third-party package. ports import only
+#       domain. services import domain, ports and pkg, plus the one vendor listed under `canUse`; they never
+#       import an adapter, gorm, pgx, gqlgen, chi or net/http.
+#   B3  Adapter isolation. An adapter imports only domain, ports and (where listed) pkg. Adapters do not import
+#       each other and do not import internal/demo. Only cmd, internal/server and internal/perf may import
+#       concrete adapters.
+#
+# This is an allow-list: a component may import only what its `mayDependOn` names, so a new edge fails until
+# someone decides it belongs. The edges that already break these rules are recorded in arch-baseline.txt.
+#
+# Do not edit this file, or arch-baseline.txt, to make a check pass. A change here needs the owner's approval.
+# Test files and generated code are excluded.
+version: 3
+
+allow:
+  depOnAnyVendor: false # each component names its vendors (anyVendorDeps or canUse)
+
+excludeFiles:
+  - "^.*_test\\.go$"
+  - "^.*/internal/adapters/graphql/generated/.*$"
+  - "^.*/internal/adapters/graphql/model/models_gen\\.go$"
+  - "^.*/tools/archcheck/.*$"
+
+vendors:
+  bluemonday: { in: github.com/microcosm-cc/bluemonday }
+
+components:
+  domain: { in: internal/core/domain }
+  ports: { in: internal/core/ports/** }
+  services: { in: internal/core/services }
+  gql: { in: internal/adapters/graphql/** }
+  auth: { in: internal/adapters/auth }
+  repo-postgres: { in: internal/adapters/repositories/postgres }
+  repo-cached: { in: internal/adapters/repositories/cached }
+  realtime: { in: internal/adapters/realtime }
+  tmdb: { in: internal/adapters/tmdb }
+  youtube: { in: internal/adapters/youtube }
+  webpage: { in: internal/adapters/webpage }
+  wikidata: { in: internal/adapters/wikidata }
+  openlibrary: { in: internal/adapters/openlibrary }
+  web: { in: internal/adapters/web/** }
+  demo: { in: internal/demo }
+  config: { in: internal/config }
+  server: { in: internal/server }
+  perf: { in: internal/perf/** }
+  pkg: { in: pkg/** }
+  cmd: { in: cmd/** }
+
+deps:
+  # domain has no entry on purpose: it may depend on nothing.
+  ports:
+    mayDependOn: [domain]
+  services:
+    mayDependOn: [domain, ports, pkg]
+    canUse: [bluemonday]
+  gql:
+    mayDependOn: [gql, domain, ports, auth, pkg] # a multi-package (**) component must list itself
+    anyVendorDeps: true
+  auth:
+    mayDependOn: [domain, ports]
+    anyVendorDeps: true
+  repo-postgres:
+    mayDependOn: [domain, ports, pkg]
+    anyVendorDeps: true
+  repo-cached:
+    mayDependOn: [domain, ports]
+    anyVendorDeps: true
+  realtime:
+    mayDependOn: [domain, ports]
+    anyVendorDeps: true
+  tmdb:
+    mayDependOn: [domain, ports, pkg]
+    anyVendorDeps: true
+  youtube:
+    mayDependOn: [domain, ports]
+    anyVendorDeps: true
+  webpage:
+    mayDependOn: [domain]
+    anyVendorDeps: true
+  wikidata:
+    mayDependOn: [domain]
+    anyVendorDeps: true
+  openlibrary:
+    mayDependOn: [domain, ports]
+    anyVendorDeps: true
+  web:
+    mayDependOn: [domain]
+    anyVendorDeps: true
+  demo:
+    mayDependOn: [domain, ports]
+    anyVendorDeps: true
+  config:
+    anyVendorDeps: true
+  server:
+    anyProjectDeps: true
+    anyVendorDeps: true
+  perf:
+    anyProjectDeps: true
+    anyVendorDeps: true
+  pkg:
+    mayDependOn: [pkg]
+    anyVendorDeps: true
+  cmd:
+    anyProjectDeps: true
+    anyVendorDeps: true
