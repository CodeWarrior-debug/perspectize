diff --git a/backend/tools/archcheck/main.go b/backend/tools/archcheck/main.go
new file mode 100644
index 00000000..c9f5c884
--- /dev/null
+++ b/backend/tools/archcheck/main.go
@@ -0,0 +1,312 @@
+// Command archcheck enforces the architecture rules go-arch-lint cannot express, because they need
+// type information or the GraphQL schema:
+//
+//	B2  Every GraphQL Mutation and Subscription is guarded. Its schema field carries @auth or @owner, and its
+//	    resolver derives the acting user from the request context (auth.RequireAuth, auth.ForContext or
+//	    auth.UserRowForContext), directly or through a helper in the resolvers package.
+//	B7  Services and repositories take time from an injected clock. A call to time.Now is allowed only inside
+//	    a function named clock or now, the accessor that supplies the wall-clock default.
+//
+// It prints one tab-separated row per finding: rule, file, line, detail. Findings do not change the exit
+// status (0); only a failure to load the code does (2). arch-check.sh compares the rows with the baseline.
+//
+// Test files and generated files are never checked.
+//
+// Usage: go -C backend/tools/archcheck run . -root backend
+package main
+
+import (
+	"flag"
+	"fmt"
+	"go/ast"
+	"go/types"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/vektah/gqlparser/v2"
+	gqlast "github.com/vektah/gqlparser/v2/ast"
+	"golang.org/x/tools/go/packages"
+)
+
+const (
+	modPath      = "github.com/CodeWarrior-debug/perspectize/backend"
+	authPkg      = modPath + "/internal/adapters/auth"
+	resolversPkg = modPath + "/internal/adapters/graphql/resolvers"
+	resolversDir = "internal/adapters/graphql/resolvers"
+)
+
+type file struct {
+	rel    string
+	relDir string
+	ast    *ast.File
+	pkg    *packages.Package
+}
+
+func (f *file) line(n ast.Node) int { return f.pkg.Fset.Position(n.Pos()).Line }
+
+type finding struct {
+	rule, file string
+	line       int
+	detail     string
+}
+
+// calleeFunc resolves a call's callee to the function or method it names, or nil.
+func calleeFunc(info *types.Info, call *ast.CallExpr) *types.Func {
+	var id *ast.Ident
+	switch fn := call.Fun.(type) {
+	case *ast.SelectorExpr:
+		id = fn.Sel
+	case *ast.Ident:
+		id = fn
+	}
+	if id == nil {
+		return nil
+	}
+	f, _ := info.Uses[id].(*types.Func)
+	return f
+}
+
+func recvName(e ast.Expr) string {
+	switch t := e.(type) {
+	case *ast.StarExpr:
+		return recvName(t.X)
+	case *ast.Ident:
+		return t.Name
+	case *ast.IndexExpr:
+		return recvName(t.X)
+	}
+	return "?"
+}
+
+func funcLabel(fd *ast.FuncDecl) string {
+	if fd.Recv != nil && len(fd.Recv.List) > 0 {
+		return recvName(fd.Recv.List[0].Type) + "." + fd.Name.Name
+	}
+	return fd.Name.Name
+}
+
+// ruleTimeNow reports time.Now() calls in services and repositories, outside a clock accessor.
+func ruleTimeNow(files []*file) []finding {
+	var out []finding
+	for _, f := range files {
+		if !strings.HasPrefix(f.relDir, "internal/core/services") && !strings.HasPrefix(f.relDir, "internal/adapters/repositories") {
+			continue
+		}
+		for _, d := range f.ast.Decls {
+			fd, ok := d.(*ast.FuncDecl)
+			if !ok || fd.Body == nil || fd.Name.Name == "clock" || fd.Name.Name == "now" {
+				continue
+			}
+			ast.Inspect(fd.Body, func(n ast.Node) bool {
+				call, ok := n.(*ast.CallExpr)
+				if !ok {
+					return true
+				}
+				if fn := calleeFunc(f.pkg.TypesInfo, call); fn != nil && fn.Pkg() != nil && fn.Pkg().Path() == "time" && fn.Name() == "Now" {
+					out = append(out, finding{"B7", f.rel, f.line(call), "time.Now() in " + funcLabel(fd) + "; take the time from an injected clock"})
+				}
+				return true
+			})
+		}
+	}
+	return out
+}
+
+type resolverKey struct{ recv, name string }
+
+type position struct {
+	file string
+	line int
+}
+
+// resolverActorLookup reports, for each resolver method, whether it reaches an actor lookup. A call to a
+// method of the resolvers package counts when that method reaches one (up to four calls deep).
+func resolverActorLookup(files []*file) (map[resolverKey]bool, map[resolverKey]position) {
+	decls := map[resolverKey]*ast.FuncDecl{}
+	where := map[resolverKey]position{}
+	owner := map[resolverKey]*file{}
+	for _, f := range files {
+		if f.relDir != resolversDir {
+			continue
+		}
+		for _, d := range f.ast.Decls {
+			fd, ok := d.(*ast.FuncDecl)
+			if !ok || fd.Body == nil {
+				continue
+			}
+			k := resolverKey{name: fd.Name.Name}
+			if fd.Recv != nil && len(fd.Recv.List) > 0 {
+				k.recv = recvName(fd.Recv.List[0].Type)
+			}
+			decls[k], owner[k] = fd, f
+			where[k] = position{f.rel, f.line(fd)}
+		}
+	}
+	memo := map[resolverKey]bool{}
+	var reaches func(k resolverKey, depth int) bool
+	reaches = func(k resolverKey, depth int) bool {
+		if v, seen := memo[k]; seen {
+			return v
+		}
+		fd, ok := decls[k]
+		if !ok || depth > 4 {
+			return false
+		}
+		memo[k] = false // guards against recursion
+		found := false
+		ast.Inspect(fd.Body, func(n ast.Node) bool {
+			if found {
+				return false
+			}
+			call, ok := n.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			fn := calleeFunc(owner[k].pkg.TypesInfo, call)
+			if fn == nil || fn.Pkg() == nil {
+				return true
+			}
+			switch {
+			case fn.Pkg().Path() == authPkg && (fn.Name() == "RequireAuth" || fn.Name() == "ForContext" || fn.Name() == "UserRowForContext"):
+				found = true
+			case fn.Pkg().Path() == resolversPkg:
+				ck := resolverKey{name: fn.Name()}
+				if sig, ok := fn.Type().(*types.Signature); ok && sig.Recv() != nil {
+					t := sig.Recv().Type()
+					if p, ok := t.(*types.Pointer); ok {
+						t = p.Elem()
+					}
+					if nt, ok := t.(*types.Named); ok {
+						ck.recv = nt.Obj().Name()
+					}
+				}
+				if ck != k && reaches(ck, depth+1) {
+					found = true
+				}
+			}
+			return !found
+		})
+		memo[k] = found
+		return found
+	}
+	res := map[resolverKey]bool{}
+	for k := range decls {
+		res[k] = reaches(k, 0)
+	}
+	return res, where
+}
+
+// ruleMutationAuth checks every Mutation and Subscription field of the schema.
+func ruleMutationAuth(root string, files []*file) ([]finding, error) {
+	var srcs []*gqlast.Source
+	for _, name := range []string{"schema.graphql", "messaging.graphql"} {
+		b, err := os.ReadFile(filepath.Join(root, name))
+		if err != nil {
+			return nil, err
+		}
+		srcs = append(srcs, &gqlast.Source{Name: name, Input: string(b)})
+	}
+	schema, err := gqlparser.LoadSchema(srcs...)
+	if err != nil {
+		return nil, err
+	}
+	actor, where := resolverActorLookup(files)
+	recvFor := map[string]string{"Mutation": "mutationResolver", "Subscription": "subscriptionResolver"}
+	var out []finding
+	for _, root := range []string{"Mutation", "Subscription"} {
+		def := schema.Types[root]
+		if def == nil {
+			continue
+		}
+		for _, fld := range def.Fields {
+			if strings.HasPrefix(fld.Name, "__") {
+				continue
+			}
+			label := root + "." + fld.Name
+			guarded := false
+			for _, d := range fld.Directives {
+				if d.Name == "auth" || d.Name == "owner" {
+					guarded = true
+				}
+			}
+			var at resolverKey
+			found := false
+			for k := range actor {
+				if k.recv == recvFor[root] && strings.EqualFold(k.name, fld.Name) {
+					at, found = k, true
+				}
+			}
+			file, line := fld.Position.Src.Name, fld.Position.Line
+			if found {
+				file, line = where[at].file, where[at].line
+			}
+			switch {
+			case !guarded:
+				out = append(out, finding{"B2", file, line, label + ": schema field has neither @auth nor @owner"})
+			case !found:
+				out = append(out, finding{"B2", file, line, label + ": no resolver found"})
+			case !actor[at]:
+				out = append(out, finding{"B2", file, line, label + ": resolver never derives the actor (auth.RequireAuth, auth.ForContext)"})
+			}
+		}
+	}
+	return out, nil
+}
+
+func main() {
+	rootFlag := flag.String("root", ".", "path to the backend module root")
+	flag.Parse()
+	root, err := filepath.Abs(*rootFlag)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "archcheck:", err)
+		os.Exit(2)
+	}
+	cfg := &packages.Config{
+		Mode: packages.NeedName | packages.NeedFiles | packages.NeedCompiledGoFiles | packages.NeedImports |
+			packages.NeedTypes | packages.NeedSyntax | packages.NeedTypesInfo,
+		Dir: root,
+	}
+	pkgs, err := packages.Load(cfg, "./internal/core/services", "./internal/adapters/repositories/...", "./"+resolversDir)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "archcheck: load:", err)
+		os.Exit(2)
+	}
+	var files []*file
+	for _, p := range pkgs {
+		if len(p.Errors) > 0 {
+			fmt.Fprintf(os.Stderr, "archcheck: %s does not compile: %v\n", p.ID, p.Errors[0])
+			os.Exit(2)
+		}
+		for _, af := range p.Syntax {
+			abs := p.Fset.Position(af.Pos()).Filename
+			rel := strings.TrimPrefix(abs, root+"/")
+			if strings.HasSuffix(rel, "_test.go") || ast.IsGenerated(af) {
+				continue
+			}
+			files = append(files, &file{rel: rel, relDir: filepath.Dir(rel), ast: af, pkg: p})
+		}
+	}
+
+	findings := ruleTimeNow(files)
+	auth, err := ruleMutationAuth(root, files)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "archcheck: schema:", err)
+		os.Exit(2)
+	}
+	findings = append(findings, auth...)
+	sort.Slice(findings, func(i, j int) bool {
+		a, b := findings[i], findings[j]
+		if a.rule != b.rule {
+			return a.rule < b.rule
+		}
+		if a.file != b.file {
+			return a.file < b.file
+		}
+		return a.line < b.line
+	})
+	for _, f := range findings {
+		fmt.Printf("%s\t%s\t%d\t%s\n", f.rule, f.file, f.line, f.detail)
+	}
+}
