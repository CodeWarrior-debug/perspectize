+++ b/frontend/eslint-rules/arch.js
@@ -0,0 +1,126 @@
+// Architecture rules F1, F2, F5 and F6 as four ESLint rules, each with its own id.
+//
+// They are separate rules, not options of no-restricted-imports, because ESLint's suppression file
+// (eslint-suppressions.json) counts violations per file and rule id. Two rules sharing an id would let
+// someone fix one violation and add another in the same file without the count changing.
+//
+// The rules are wired in eslint.config.js. Do not edit this file, the config or eslint-suppressions.json
+// to make a check pass; a change here needs the owner's approval.
+
+const TYPE_WRAPPERS = new Set(['TSAsExpression', 'TSSatisfiesExpression', 'TSNonNullExpression']);
+
+/** The expression inside any `as const`, `satisfies` or `!` wrapper. */
+function unwrap(node) {
+	let current = node;
+	while (current && TYPE_WRAPPERS.has(current.type)) current = current.expression;
+	return current;
+}
+
+function importedName(specifier) {
+	if (specifier.type === 'ImportNamespaceSpecifier') return '*';
+	if (specifier.type !== 'ImportSpecifier') return 'default';
+	return specifier.imported.type === 'Identifier' ? specifier.imported.name : String(specifier.imported.value);
+}
+
+/**
+ * A rule that reports an import of a module. With `names`, only those exports (or a namespace import)
+ * are reported; without, any import of the module is.
+ *
+ * @param {{ targets: { source: RegExp, names?: Set<string> }[], message: string }} options
+ */
+function restrictImports({ targets, message }) {
+	return {
+		meta: { type: 'problem', schema: [], docs: { description: message } },
+		create(context) {
+			const targetFor = (value) =>
+				typeof value === 'string' ? targets.find((target) => target.source.test(value)) : undefined;
+			return {
+				ImportDeclaration(node) {
+					const target = targetFor(node.source.value);
+					if (!target || node.importKind === 'type') return;
+					if (!target.names) return context.report({ node, message });
+					for (const specifier of node.specifiers) {
+						if (specifier.importKind === 'type') continue;
+						const name = importedName(specifier);
+						if (name === '*' || target.names.has(name)) context.report({ node: specifier, message });
+					}
+				},
+				ExportNamedDeclaration(node) {
+					const target = node.source && targetFor(node.source.value);
+					if (!target || node.exportKind === 'type') return;
+					if (!target.names) return context.report({ node, message });
+					for (const specifier of node.specifiers) {
+						const local = specifier.local;
+						const name = local.type === 'Identifier' ? local.name : String(local.value);
+						if (target.names.has(name)) context.report({ node: specifier, message });
+					}
+				},
+				ExportAllDeclaration(node) {
+					if (node.exportKind !== 'type' && targetFor(node.source.value)) context.report({ node, message });
+				},
+				ImportExpression(node) {
+					if (node.source.type === 'Literal' && targetFor(node.source.value)) context.report({ node, message });
+				},
+			};
+		},
+	};
+}
+
+// TanStack's `QueryClient` methods whose first argument is a query key.
+const KEY_ARGUMENT_METHODS = new Set(['getQueryData', 'setQueryData', 'getQueryState']);
+
+const queryKeyLiteral = {
+	meta: {
+		type: 'problem',
+		schema: [],
+		docs: { description: 'A query key comes from the queryKeys factory, not from an array literal.' },
+	},
+	create(context) {
+		const message =
+			'F6: build this query key with a function from `queryKeys` (lib/queries/keys.ts); add one there if it is missing. Do not write an array literal.';
+		const isArrayLiteral = (node) => unwrap(node)?.type === 'ArrayExpression';
+		return {
+			Property(node) {
+				if (node.computed) return;
+				const name = node.key.type === 'Identifier' ? node.key.name : node.key.value;
+				if (name === 'queryKey' && isArrayLiteral(node.value)) context.report({ node: node.value, message });
+			},
+			CallExpression(node) {
+				const callee = node.callee;
+				if (callee.type !== 'MemberExpression' || callee.computed || callee.property.type !== 'Identifier') return;
+				if (!KEY_ARGUMENT_METHODS.has(callee.property.name)) return;
+				if (node.arguments[0] && isArrayLiteral(node.arguments[0])) {
+					context.report({ node: node.arguments[0], message });
+				}
+			},
+		};
+	},
+};
+
+const TRANSPORT_NAMES = new Set(['graphqlRequest', 'graphqlRequestAnonymous', 'graphqlClient']);
+const QUERY_BUILDERS = new Set(['createQuery', 'createMutation', 'createInfiniteQuery', 'createQueries']);
+
+export default {
+	rules: {
+		'f1-ui-uses-hooks': restrictImports({
+			targets: [{ source: /^@tanstack\/svelte-query$/, names: QUERY_BUILDERS }],
+			message:
+				'F1: UI code calls a useX hook from #lib/queries/<domain>; it does not build a query or mutation with createQuery / createMutation. Add the hook to lib/queries and call that.',
+		}),
+		'f2-ui-no-graphql-transport': restrictImports({
+			targets: [
+				{ source: /(^|\/)queries\/client(\.js|\.ts)?$/, names: TRANSPORT_NAMES },
+				{ source: /^graphql-request$/ },
+				{ source: /^graphql-ws$/ },
+			],
+			message:
+				'F2: UI code never sends a GraphQL request itself. Add a hook to lib/queries/<domain> that owns the request and call that.',
+		}),
+		'f5-clerk-only-in-auth-facade': restrictImports({
+			targets: [{ source: /^svelte-clerk(\/|$)/ }],
+			message:
+				'F5: only the auth facade imports svelte-clerk. Use useAuthState() (#lib/auth/useAuthState) or components/auth/*; a direct import crashes demo mode.',
+		}),
+		'f6-query-keys-from-factory': queryKeyLiteral,
+	},
+};
