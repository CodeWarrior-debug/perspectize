+// Architecture rules F1, F2, F5 and F6 (see eslint-rules/arch.js). Run through scripts/arch-check.sh.
+//
+//   F1  UI code calls a useX hook; it does not build queries with createQuery / createMutation.
+//   F2  UI code never touches the GraphQL transport (graphqlRequest, graphqlClient, graphql-request).
+//   F5  Only the auth facade imports svelte-clerk.
+//   F6  Query keys come from the queryKeys factory, not from array literals.
+//
+// "UI code" is src/lib/components and src/routes. The violations that already exist are recorded in
+// eslint-suppressions.json; only a new one fails.
+//
+// Do not edit this file, eslint-rules/ or eslint-suppressions.json to make a check pass. A change here needs
+// the owner's approval.
+import tsParser from '@typescript-eslint/parser';
+import svelteParser from 'svelte-eslint-parser';
+import arch from './eslint-rules/arch.js';
+
+const SOURCE = ['src/**/*.{ts,svelte}'];
+const UI = ['src/lib/components/**/*.{ts,svelte}', 'src/routes/**/*.{ts,svelte}'];
+
+// The files allowed to import svelte-clerk: the auth hook, the auth components and the root layout's provider.
+const CLERK_FACADE = ['src/lib/auth/useAuthState.ts', 'src/lib/components/auth/**', 'src/routes/+layout.svelte'];
+
+export default [
+	{ ignores: ['**/node_modules/**', '**/.svelte-kit/**', 'build/**', 'coverage/**', '**/*.test.ts'] },
+	{
+		// An `eslint-disable` comment would switch a rule off for a line. Ignore them all.
+		linterOptions: { noInlineConfig: true },
+	},
+	{
+		files: ['**/*.ts'],
+		languageOptions: { parser: tsParser, sourceType: 'module' },
+	},
+	{
+		files: ['**/*.svelte', '**/*.svelte.ts'],
+		languageOptions: {
+			parser: svelteParser,
+			parserOptions: { parser: tsParser, extraFileExtensions: ['.svelte'] },
+			sourceType: 'module',
+		},
+	},
+	{
+		files: SOURCE,
+		ignores: ['src/lib/queries/keys.ts'],
+		plugins: { arch },
+		rules: { 'arch/f6-query-keys-from-factory': 'error' },
+	},
+	{
+		files: SOURCE,
+		ignores: CLERK_FACADE,
+		plugins: { arch },
+		rules: { 'arch/f5-clerk-only-in-auth-facade': 'error' },
+	},
+	{
+		files: UI,
+		plugins: { arch },
+		rules: {
+			'arch/f1-ui-uses-hooks': 'error',
+			'arch/f2-ui-no-graphql-transport': 'error',
+		},
+	},
+];
