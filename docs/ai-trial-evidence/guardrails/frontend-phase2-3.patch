diff --git a/frontend/scripts/arch-check.sh b/frontend/scripts/arch-check.sh
new file mode 100755
index 00000000..ea25110a
--- /dev/null
+++ b/frontend/scripts/arch-check.sh
@@ -0,0 +1,148 @@
+#!/usr/bin/env bash
+# Architecture rules F1, F2, F5 and F6 for the frontend, with a baseline of the violations that already exist.
+# Run from anywhere. Works with macOS's bash 3.2 and BSD tools.
+#
+#   arch-check.sh [check]   run ESLint over src/. Fails on a violation that is not in the baseline, on a baseline
+#                           entry that no longer occurs, and on a baseline that has grown since it was created.
+#   arch-check.sh shrink    remove the baseline entries that no longer occur. It never adds one.
+#   arch-check.sh init      write the first baseline from the current violations. Refuses if one exists.
+#
+# Rules (eslint.config.js, implemented in eslint-rules/arch.js):
+#   F1  UI code calls a useX hook; it does not build queries with createQuery / createMutation
+#   F2  UI code never touches the GraphQL transport (graphqlRequest, graphqlClient, graphql-request)
+#   F5  only the auth facade imports svelte-clerk
+#   F6  query keys come from the queryKeys factory, not from array literals
+#
+# The baseline is eslint-suppressions.json (ESLint's own bulk-suppression file): per file and rule, how many
+# violations are tolerated. It may shrink and never grow. "Never grow" is checked against the commit that added
+# the file, or against ARCH_BASELINE_REF when that is set.
+#
+# Only errors count. ESLint's warnings (for example that an eslint-disable comment has no effect, because inline
+# config is switched off) are not shown.
+
+set -u
+FRONTEND=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
+cd "$FRONTEND" || exit 2
+
+BASELINE=eslint-suppressions.json
+MAX_LINES=${CHECK_MAX_LINES:-40}
+ESLINT=node_modules/.bin/eslint
+
+TMP=$(mktemp -d "${TMPDIR:-/tmp}/arch-check.XXXXXX")
+trap 'rm -rf "$TMP"' EXIT
+
+command -v jq >/dev/null 2>&1 || { echo "arch-check: jq is required" >&2; exit 2; }
+if [ ! -x "$ESLINT" ]; then
+  echo "arch-check: frontend/node_modules is missing. Run: pnpm --dir frontend install --frozen-lockfile --config.engine-strict=false" >&2
+  exit 2
+fi
+
+cap() {
+  awk -v max="$MAX_LINES" 'NR <= max { print } END { if (NR > max) printf "  ... %d more lines\n", NR - max }'
+}
+
+# flatten <suppressions file>: one line per file and rule: file, rule, count. Sorted.
+flatten() {
+  jq -r 'to_entries[] | .key as $f | .value | to_entries[] | [$f, .key, (.value.count | tostring)] | @tsv' "$1" | sort
+}
+
+# lint: runs ESLint. Sets RC (its exit status) and writes $TMP/eslint.json and $TMP/eslint.err.
+lint() {
+  "$ESLINT" src --format json >"$TMP/eslint.json" 2>"$TMP/eslint.err"
+  RC=$?
+  if ! jq -e 'type == "array"' "$TMP/eslint.json" >/dev/null 2>&1; then
+    # A crash before any file was linted: the config or a rule is broken, which is not a finding.
+    if ! grep -q 'suppressions left that do not occur' "$TMP/eslint.err"; then
+      echo "arch-check: ESLint did not produce a report:" >&2
+      head -n 20 "$TMP/eslint.err" >&2
+      exit 2
+    fi
+    echo '[]' >"$TMP/eslint.json"
+  fi
+}
+
+# growth: fail if the working baseline tolerates more than the original did, for any file and rule.
+growth() {
+  local ref=${ARCH_BASELINE_REF:-}
+  if [ -z "$ref" ]; then
+    ref=$(git log --diff-filter=A --format=%H -- "$BASELINE" 2>/dev/null | tail -n 1)
+  fi
+  if [ -z "$ref" ] || ! git show "$ref:./$BASELINE" >"$TMP/ref.json" 2>/dev/null; then
+    NOTE="the baseline is not committed yet, so growth was not checked."
+    return 0
+  fi
+  flatten "$TMP/ref.json" >"$TMP/ref.tsv"
+  flatten "$BASELINE" >"$TMP/cur.tsv"
+  awk -F'\t' '
+    NR == FNR { ref[$1 "\t" $2] = $3; next }
+    { key = $1 "\t" $2; was = (key in ref) ? ref[key] : 0
+      if ($3 + 0 > was + 0) printf "%s %s: %s tolerated, was %s\n", $1, $2, $3, was }
+  ' "$TMP/ref.tsv" "$TMP/cur.tsv" >"$TMP/grown.txt"
+  [ ! -s "$TMP/grown.txt" ]
+}
+
+cmd_check() {
+  local failed=0 new stale
+  NOTE=""
+  if [ ! -f "$BASELINE" ]; then
+    echo "arch-check: $BASELINE is missing. It is committed with the rules; restore it with git." >&2
+    exit 2
+  fi
+  lint
+
+  jq -r --arg root "$FRONTEND/" '
+    .[] | .filePath as $f | .messages[] | select(.severity == 2)
+    | "  \($f | ltrimstr($root)):\(.line // 0)  \(.ruleId // "parse-error")  \(.message)"
+  ' "$TMP/eslint.json" >"$TMP/new.txt"
+  new=$(wc -l <"$TMP/new.txt" | tr -d ' ')
+  stale=0
+  grep -q 'suppressions left that do not occur' "$TMP/eslint.err" && stale=1
+
+  if [ "$new" -gt 0 ]; then
+    failed=1
+    printf 'arch-check: FAILED. %s architecture violation(s) outside the baseline. Fix the code; do not add them to the baseline.\n' "$new"
+    echo '  (A file with baselined violations of a rule lists all of its violations of that rule when it gains one: ESLint cannot tell which is the new one.)'
+    cap <"$TMP/new.txt"
+    echo
+  fi
+  if [ "$stale" -eq 1 ]; then
+    failed=1
+    echo 'arch-check: FAILED. A baseline entry no longer occurs (fixed). Remove it with: bash frontend/scripts/arch-check.sh shrink'
+    echo
+  fi
+  if ! growth; then
+    failed=1
+    printf 'arch-check: FAILED. The baseline tolerates more than it did originally. It may shrink, never grow:\n'
+    sed 's/^/  /' "$TMP/grown.txt" | cap
+    echo
+  fi
+  if [ "$failed" -eq 0 ]; then
+    printf 'arch-check: OK (0 new; %s known violations in the baseline)\n' "$(flatten "$BASELINE" | awk -F'\t' '{ n += $3 } END { print n + 0 }')"
+    [ -z "$NOTE" ] || printf '  %s\n' "$NOTE"
+    return 0
+  fi
+  return 1
+}
+
+cmd_shrink() {
+  [ -f "$BASELINE" ] || { echo "arch-check: $BASELINE is missing" >&2; exit 2; }
+  "$ESLINT" src --prune-suppressions >"$TMP/prune.out" 2>&1 || true
+  printf 'arch-check: baseline now tolerates %s violations\n' "$(flatten "$BASELINE" | awk -F'\t' '{ n += $3 } END { print n + 0 }')"
+}
+
+cmd_init() {
+  if [ -f "$BASELINE" ]; then
+    echo "arch-check: $BASELINE already exists. init only writes the first baseline; use shrink to remove entries." >&2
+    exit 2
+  fi
+  "$ESLINT" src --suppress-all >"$TMP/init.out" 2>&1 || true
+  [ -f "$BASELINE" ] || { echo "arch-check: ESLint wrote no $BASELINE (no violations?)" >&2; exit 2; }
+  printf 'arch-check: wrote %s tolerating %s violations\n' "$BASELINE" "$(flatten "$BASELINE" | awk -F'\t' '{ n += $3 } END { print n + 0 }')"
+}
+
+case "${1:-check}" in
+  check) cmd_check ;;
+  shrink) cmd_shrink ;;
+  init) cmd_init ;;
+  *) echo "usage: arch-check.sh [check | shrink | init]" >&2; exit 2 ;;
+esac
diff --git a/frontend/scripts/check.sh b/frontend/scripts/check.sh
new file mode 100755
index 00000000..779d467f
--- /dev/null
+++ b/frontend/scripts/check.sh
@@ -0,0 +1,194 @@
+#!/usr/bin/env bash
+# Frontend checks in three tiers. Run from anywhere. Works with macOS's bash 3.2 and BSD tools.
+#
+#   check.sh fast <file>...  after editing a file (the PostToolUse hook runs this): prettier on the file,
+#                            then svelte-check for the whole project (types). ~7s.
+#   check.sh step            after each logical step: prettier on every changed file, the architecture rules
+#                            (arch-check.sh), svelte-check, and the unit tests related to the changed files.
+#   check.sh full            before you push: prettier on changed files, the architecture rules, svelte-check
+#                            with a fresh generated cache, the whole unit suite (286 files, 4,118 tests).
+#
+# "Changed" means committed since CHECK_BASE (default origin/main), uncommitted, or untracked.
+# Prints a few lines on success. On failure prints the findings (capped at CHECK_MAX_LINES per
+# section) and exits 1.
+
+set -u
+FRONTEND=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
+cd "$FRONTEND" || exit 2
+
+MAX_LINES=${CHECK_MAX_LINES:-40}
+BASE=${CHECK_BASE:-origin/main}
+now() { perl -MTime::HiRes=time -e 'printf "%.3f", time'; }
+START=$(now)
+REPORT=()
+TESTLINE=""
+ARCHLINE=""
+NOTE=""
+
+if [ ! -x node_modules/.bin/svelte-check ]; then
+  echo "check: frontend/node_modules is missing. Run: pnpm --dir frontend install --frozen-lockfile --config.engine-strict=false" >&2
+  exit 2
+fi
+
+# One check at a time per checkout: svelte-kit sync and svelte-check both write .svelte-kit, and the hook
+# can fire for several edits at once. (mkdir is the portable lock; flock is missing on macOS.)
+LOCK="${TMPDIR:-/tmp}/perspectize-fe-check-$(printf '%s' "$FRONTEND" | cksum | cut -d' ' -f1).lock"
+for _ in $(seq 1 240); do
+  mkdir "$LOCK" 2>/dev/null && break
+  sleep 0.5
+done
+trap 'rmdir "$LOCK" 2>/dev/null' EXIT
+
+cap() {
+  awk -v max="$MAX_LINES" 'NR <= max { print } END { if (NR > max) printf "... %d more lines; run the command yourself for all of it\n", NR - max }'
+}
+add_section() { REPORT+=("$1"$'\n'"$(printf '%s\n' "$2" | cap)"); }
+
+finish() {
+  local tier=$1 elapsed
+  elapsed=$(printf '%.1f' "$(echo "$(now) - $START" | bc)")
+  if [ ${#REPORT[@]} -eq 0 ]; then
+    printf 'check %s: OK (%ss)\n' "$tier" "$elapsed"
+    [ -n "$ARCHLINE" ] && printf '  %s\n' "$ARCHLINE"
+    [ -n "$TESTLINE" ] && printf '  %s\n' "$TESTLINE"
+    [ -n "$NOTE" ] && printf '  %s\n' "$NOTE"
+    return 0
+  fi
+  printf 'check %s: FAILED (%ss)\n\n' "$tier" "$elapsed"
+  printf '%s\n\n' "${REPORT[@]}"
+  [ -n "$NOTE" ] && printf '%s\n' "$NOTE"
+  return 1
+}
+
+# rel_path <path>: path relative to frontend/, empty if outside it.
+rel_path() {
+  case "$1" in "$FRONTEND"/*) printf '%s' "${1#"$FRONTEND"/}" ;; /*) ;; *) printf '%s' "$1" ;; esac
+}
+
+is_formattable() {
+  case "$1" in node_modules/*|.svelte-kit/*|build/*|coverage/*|static/*|reports/*) return 1 ;; esac
+  case "$1" in *.ts|*.js|*.mjs|*.svelte|*.css|*.json) return 0 ;; *) return 1 ;; esac
+}
+
+is_typechecked() {
+  case "$1" in src/*|tests/*) case "$1" in *.ts|*.js|*.svelte) return 0 ;; esac ;; esac
+  return 1
+}
+
+# changed_files: paths relative to frontend/: committed since $BASE, uncommitted, untracked.
+changed_files() {
+  if git rev-parse --verify -q "$BASE" >/dev/null; then
+    git diff --relative --name-only --diff-filter=ACMR "$BASE"...HEAD -- .
+  else
+    NOTE="$BASE not found: only uncommitted and untracked changes were considered."
+  fi
+  git diff --relative --name-only --diff-filter=ACMR HEAD -- .
+  git ls-files --others --exclude-standard -- .
+}
+
+# collect_changed: fills the global arrays CHANGED_FMT (prettier) and CHANGED_TYPED (type-checked / tested).
+collect_changed() {
+  local f
+  CHANGED_FMT=()
+  CHANGED_TYPED=()
+  while IFS= read -r f; do
+    [ -n "$f" ] && [ -f "$f" ] || continue
+    is_formattable "$f" && CHANGED_FMT+=("$f")
+    is_typechecked "$f" && CHANGED_TYPED+=("$f")
+  done < <(changed_files | sort -u)
+}
+
+prettier_check() {
+  [ $# -gt 0 ] || return 0
+  local out
+  if ! out=$(pnpm exec prettier --check --ignore-unknown --log-level warn "$@" 2>&1); then
+    add_section "prettier: not formatted (fix: pnpm --dir frontend exec prettier --write $*)" "$out"
+  fi
+}
+
+# arch_check: the architecture rules, with the baseline of violations that already exist.
+arch_check() {
+  local out
+  if out=$(bash "$FRONTEND/scripts/arch-check.sh" 2>&1); then
+    ARCHLINE=$(printf '%s\n' "$out" | sed -n '1p')
+  else
+    add_section "arch-check (architecture rules F1, F2, F5, F6)" "$out"
+  fi
+}
+
+# typecheck [edited file]...: svelte-check over the whole project. Errors only; warnings do not fail.
+typecheck() {
+  local out errors others
+  out=$(pnpm run check --output machine 2>&1)
+  errors=$(printf '%s\n' "$out" | sed -n 's/^[0-9]* ERROR "\([^"]*\)" \([0-9]*:[0-9]*\) "\(.*\)"$/\1:\2 \3/p')
+  if [ -n "$errors" ]; then
+    add_section "svelte-check: type errors (pnpm --dir frontend run check)" "$errors"
+    if [ $# -gt 0 ]; then
+      others=$(printf '%s\n' "$errors" | sed 's/:[0-9]*:[0-9]* .*//' | sort -u | grep -vxF -f <(printf '%s\n' "$@"))
+      [ -z "$others" ] || NOTE="Some errors are in files you did not edit just now ($(printf '%s' "$others" | tr '\n' ' ')). That is normal mid-change: finish the change, then run frontend/scripts/check.sh step."
+    fi
+  elif ! printf '%s\n' "$out" | grep -q ' COMPLETED '; then
+    add_section "svelte-check did not complete" "$(printf '%s\n' "$out" | tail -n 20)"
+  fi
+}
+
+# run_vitest <vitest args>...: summarise the dot reporter's output.
+run_vitest() {
+  local out rc failures
+  out=$(pnpm exec vitest "$@" --reporter=dot 2>&1)
+  rc=$?
+  local files tests
+  files=$(printf '%s\n' "$out" | sed -n -E 's/^ *Test Files +//p')
+  tests=$(printf '%s\n' "$out" | sed -n -E 's/^ *Tests +//p')
+  [ -z "$tests" ] || TESTLINE="test files: $files; tests: $tests"
+  if [ $rc -ne 0 ]; then
+    failures=$(printf '%s\n' "$out" | sed -n '/FAIL/,/^ *Test Files/{/^ *Test Files/!p;}')
+    [ -n "$failures" ] || failures=$(printf '%s\n' "$out" | tail -n 30)
+    add_section "vitest (${TESTLINE:-no summary})" "$failures"
+  fi
+}
+
+tier_fast() {
+  local fmt=() types=() f rel
+  for f in "$@"; do
+    rel=$(rel_path "$f")
+    [ -n "$rel" ] && [ -f "$rel" ] || continue
+    is_formattable "$rel" && fmt+=("$rel")
+    is_typechecked "$rel" && types+=("$rel")
+  done
+  [ ${#fmt[@]} -gt 0 ] || return 0
+  prettier_check "${fmt[@]}"
+  [ ${#types[@]} -eq 0 ] || typecheck "${types[@]}"
+  finish fast
+}
+
+tier_step() {
+  collect_changed
+  [ ${#CHANGED_FMT[@]} -eq 0 ] || prettier_check "${CHANGED_FMT[@]}"
+  arch_check
+  rm -rf .svelte-kit/.svelte-check
+  typecheck
+  if [ ${#CHANGED_TYPED[@]} -gt 0 ]; then
+    run_vitest related --run --project unit --passWithNoTests "${CHANGED_TYPED[@]}"
+  else
+    TESTLINE="tests: none related to the changed files"
+  fi
+  finish step
+}
+
+tier_full() {
+  collect_changed
+  [ ${#CHANGED_FMT[@]} -eq 0 ] || prettier_check "${CHANGED_FMT[@]}"
+  arch_check
+  rm -rf .svelte-kit/.svelte-check
+  typecheck
+  run_vitest run --project unit
+  finish full
+}
+
+case "${1:-}" in
+  fast) shift; tier_fast ${1+"$@"} ;;
+  step) tier_step ;;
+  full) tier_full ;;
+  *) echo "usage: check.sh fast <file>... | step | full" >&2; exit 2 ;;
+esac
diff --git a/frontend/src/CLAUDE.md b/frontend/src/CLAUDE.md
new file mode 100644
index 00000000..d25c30b9
--- /dev/null
+++ b/frontend/src/CLAUDE.md
@@ -0,0 +1,97 @@
+# Frontend source
+
+Loaded when you work under `frontend/src/`. It adds to `frontend/CLAUDE.md`; it does not repeat it. Tests live in `frontend/tests/` (`unit`, `components`, `browser`, `helpers`), outside this folder: read this file before writing one.
+
+## Check your work
+
+Run these from the repo root. Each prints a few lines on success and only the findings on failure.
+
+| When | Command | Cost |
+|---|---|---|
+| A hook runs it after every edit of a `.ts`, `.js` or `.svelte` file | `bash frontend/scripts/check.sh fast <file>` | about 7s |
+| After each logical step | `bash frontend/scripts/check.sh step` | 23s for a leaf utility, 42s for a file most of the app imports, plus about 6s for the architecture rules |
+| Before you push | `bash frontend/scripts/check.sh full` | about 2 minutes (286 test files, 4,118 tests) |
+
+- `fast` is prettier on the file plus `svelte-check` for the whole project. An error in a file you did not just edit is normal in the middle of a change; finish the change, then run `step`.
+- `step` runs prettier on every changed file, the architecture rules (see below), `svelte-check`, and the unit tests related to the changed files (`vitest related`). It does not run component tests that do not import your file; `full` does.
+- It runs the `unit` project only. The browser tests (`tests/browser`) run in CI, not here, and nothing here looks at a rendered page. Say so when your change is visual.
+- Do not report "tests pass" without running `step` or `full` and quoting its summary line.
+- If `frontend/node_modules` is missing, the script says how to install it. A stale `.svelte-kit/.svelte-check` can fail the check on a file that no longer exists; `step` and `full` clear it.
+
+## The loop
+
+Work in small steps and let the check say when a step is done.
+
+1. Make one logical change.
+2. Run `bash frontend/scripts/check.sh step` and read all of its output, not only the last line.
+3. Red: fix the code the failure names. An `arch-check` failure gives the file, the line and the rule (F1, F2, F5 or F6): call a `useX` hook instead of `createQuery`, take the key from `queryKeys`, go through the auth facade. If the same check fails twice for the same reason, re-read the rule before trying another route. When it lists several violations of one rule in a file that already had one, the new one is in your diff (`git diff`).
+4. Green: take the next step. After you fix a violation that was in `frontend/eslint-suppressions.json`, run `bash frontend/scripts/arch-check.sh shrink` so the baseline gets smaller.
+5. Before you report, run `full` and put both its summary line and the `arch-check:` line in the report.
+
+If the ticket cannot be done without breaking a rule or adding an exemption, stop at that step and say so in the report. Do not edit `frontend/eslint-suppressions.json`, `frontend/eslint.config.js` or `frontend/eslint-rules/` to get past it.
+
+## Names are part of the contract
+
+Tests written against a different implementation fail on names, not on logic. In the baseline, 6 of 10 attempts failed first on a name, path, prop or test hook the ticket never gave, and 2 on exact copy text.
+
+- Use every name the ticket gives, exactly: module path, exports, methods on a returned object, props, event handlers, `data-testid` / `data-icon` values, accessible names and visible text.
+- A test finds an element by role and name, label, text, or a `data-*` attribute. If the ticket gives none of these for something a test must reach, copy the nearest neighbour's pattern, and list what you chose at the end of your report.
+- A ticket's quoted text is exact: same case, same punctuation, same link text.
+- Put a new unit-testable helper where the ticket says. If it says nothing, put it in the folder of its nearest sibling (`lib/utils/` for pure helpers) and export it by a name that says what it returns.
+- Where the ticket leaves a behaviour open, pick the reading closest to its own words, say which at the top of your report, and cover it with a test.
+
+## Where things go
+
+- **Queries and mutations:** `lib/queries/<domain>/index.ts` holds the `gql` documents and response types; each hook is its own file, `use<Verb><Noun>.ts`, next to it (`perspectives/useDeletePerspective.ts`). Hooks are not re-exported from `index.ts`; callers import the hook file by path.
+- **Mutation hooks own the toast and the cache eviction.** They return the `createMutation` result and the caller reads `mutate` and `isPending`. Copy `useDeletePerspective.ts`: optimistic patch only for rows of one shape, a rollback in `onError`, and `invalidateQueries` on the exact keys that changed.
+- **Query keys come from `queryKeys`** (`lib/queries/keys.ts`; rule F6). If the key you need is not there, add a function to the factory; do not write a literal array. Every variable `queryFn` sends belongs in the key.
+- **Every `createQuery` sets `staleTime` on purpose.** The client default is 60 s (`client.ts`), not 0 as `frontend/CLAUDE.md` says.
+- **Auth** goes through `lib/auth` and `components/auth/*`. Only five files import `svelte-clerk` (rule F5): `lib/auth/useAuthState.ts`, the three files in `components/auth/` and `routes/+layout.svelte`. Do not add a sixth.
+- **GraphQL transport** (`graphqlRequest`, `graphqlRequestAnonymous`, `graphqlClient`) is called from `lib/queries`, and still from three files in `lib/services`. Components and routes never call it (rule F2).
+- **Imports:** `#lib/...` with the suffix the neighbours use (`.js`, `.svelte`, `.svelte.js`; 696 of 711 do). A hook file in `lib/queries` imports `client`, `keys` and its own `index` relatively (`'../client'`, `'../keys'`, `'./index'`), as `useDeletePerspective.ts` does.
+- **shadcn:** import from the barrel `#lib/components/shadcn`, never a file inside it. The folder is generated.
+- **Runes:** a module that uses runes is named `*.svelte.ts`. Svelte 5 syntax only.
+- **Grid columns:** one entry in `COLUMNS` in `lib/utils/grid-config.ts` (see `frontend/CLAUDE.md`). Pure grid logic goes in `lib/utils/` so jsdom can test it.
+
+## Tests
+
+- Reach source through `#lib/...` with the same suffixes.
+- A component test mocks every `useX` hook the component calls and renders without a `QueryClient`; an unmocked hook throws. Adding a hook to a component breaks its test until you mock it there. Mock by module path: `vi.mock('#lib/queries/perspectives/useDeletePerspective.js', ...)`.
+- Cache behaviour is tested with a real `QueryClient` and `tests/helpers/queryBudget.ts` (`tests/unit/query-cache-contract.test.ts` shows the shape): same data mounted three times costs one fetch, a second mount inside `staleTime` costs none, a mutation invalidates what changed and leaves the rest.
+- A test that passes alone and fails in the full run is cold-start cost: see `tests/helpers/warmUp.ts`; do not add a retry or a timeout.
+- AG Grid does not render in jsdom. Test the config and helpers; say so in your report.
+
+## Architecture rules
+
+`bash frontend/scripts/arch-check.sh` runs ESLint with four rules, and `check.sh step` and `full` run it. "UI code" is `src/lib/components` and `src/routes`.
+
+- **F1:** UI code calls a `useX` hook. It does not import `createQuery`, `createMutation`, `createInfiniteQuery` or `createQueries`.
+- **F2:** UI code never imports `graphqlRequest`, `graphqlRequestAnonymous`, `graphqlClient`, `graphql-request` or `graphql-ws`.
+- **F5:** only `lib/auth/useAuthState.ts`, `components/auth/*` and `routes/+layout.svelte` import `svelte-clerk`.
+- **F6:** no array literal as a `queryKey`, or as the key argument of `getQueryData`, `setQueryData` or `getQueryState`. Use `queryKeys`.
+
+What already breaks them is in `frontend/eslint-suppressions.json` (34 violations; the groups are summarised in the next section). Only a new one fails.
+
+**Never edit `frontend/eslint-suppressions.json`, `frontend/eslint.config.js` or `frontend/eslint-rules/` to make a check pass, and do not add an `eslint-disable` comment: inline config is switched off, so it does nothing.** The baseline may shrink, never grow. After you fix a baselined violation, run `bash frontend/scripts/arch-check.sh shrink`. The check also fails if the baseline tolerates more than it did originally. A new rule, an exemption or a changed allowance needs the owner's approval: stop and ask.
+
+When a file that already has a baselined violation of a rule gains another, the check lists all of that file's violations of that rule, not only the new one.
+
+## These already break the layer rules
+
+They are not precedent. Do not copy them and do not add to them.
+
+- **Components that build queries or call the cache directly** (F1: 17 UI files import `createQuery` or `createMutation`, 16 components and one route; 8 call `useQueryClient`, which no rule covers). Add a `useX` hook in `lib/queries` and call that.
+- **Components and routes that call the GraphQL transport** (F2: 12 files, all of them also in the group above; three files in `lib/services` call it too, which F2 does not cover). Same fix.
+- **Inline query keys** (F6): `useMe.svelte.ts`, `AuthUserSync.svelte`, `useMarkOnboardingSeen.ts`, `OnboardingCoach.svelte`, `OnboardingShell.svelte`. The factory has no `me` key.
+- **`isLoading`** in 9 reads in 6 files. Branch on `isPending`.
+- **gql documents in services:** `lib/services/tmdbApi.ts` and `lib/queries/content/claims.ts`.
+- **`lib/queries` and `lib/messaging` import each other**, and `lib/utils` imports `lib/queries` for types. A new import in either direction makes it worse.
+- **Raw colours:** `activityItemCellRenderer.ts` has two literals the pre-commit guard does not see. Use theme tokens.
+
+## Docs that are out of date
+
+Do not follow these over the code: the `staleTime` default (above), and "import the domain, not its guts" in `frontend/CLAUDE.md` (hooks are not exported from the domain `index.ts`, so the rule cannot be followed as written; import the hook by its file).
+
+## Writing a ticket for this code
+
+`docs/ticket-template-frontend.md`.
