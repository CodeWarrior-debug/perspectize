+// percentLikedSQL is the expected PERCENT_LIKED expression: both counts come through the
+// cast-guarded form, so a hidden or non-numeric count makes the rate unknown (NULL).
+func percentLikedSQL() string {
+	views := "(CASE WHEN (response->'items'->0->'statistics'->>'viewCount') ~ '^[0-9]+$' " +
+		"THEN (response->'items'->0->'statistics'->>'viewCount')::BIGINT ELSE NULL END)"
+	likes := "(CASE WHEN (response->'items'->0->'statistics'->>'likeCount') ~ '^[0-9]+$' " +
+		"THEN (response->'items'->0->'statistics'->>'likeCount')::BIGINT ELSE NULL END)"
+	return "CASE " +
+		"WHEN " + views + " IS NULL " +
+		"  OR " + likes + " IS NULL " +
+		"  OR " + views + " = 0 " +
+		"THEN NULL " +
+		"ELSE " + likes + "::FLOAT8 " +
+		"     / NULLIF(" + views + ", 0) " +
+		"END"
