+// statCountExpr returns a SQL expression that reads one count from the stored YouTube
+// statistics (key is e.g. "viewCount" or "likeCount") as a BIGINT. YouTube can store an
+// empty string for a count it hides (likes), and a bare ::BIGINT cast of that fails the
+// whole query, so an empty or non-numeric value evaluates to NULL (unknown) instead.
+// Every sort and filter over a statistics count goes through this one expression.
+//
+// key is interpolated into the SQL text: pass only a constant, never request input.
+func statCountExpr(key string) string {
+	text := "(response->'items'->0->'statistics'->>'" + key + "')"
+	return "CASE WHEN " + text + " ~ '^[0-9]+$' THEN " + text + "::BIGINT ELSE NULL END"
+}
