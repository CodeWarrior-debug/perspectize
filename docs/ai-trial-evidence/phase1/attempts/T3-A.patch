+	cancel()
+	require.Eventually(t, func() bool { return h.subscriberCount("watched") == 0 }, time.Second, 5*time.Millisecond)
+
+	assert.True(t, h.hasKey("watched"), "it went idle last, so it is the newest idle key")
+	assert.False(t, h.hasKey(keys[0]), "the longest-idle key made room for it")
+	assert.Equal(t, maxIdleHubKeys, h.keyCount())
+}
