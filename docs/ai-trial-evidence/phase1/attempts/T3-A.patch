+// settleIdleLocked brings the key's place in the idle order in line with its
+// entry after a change to its state or subscribers. A key that just went idle
+// joins the back of the order and may push the longest-idle key out; one that
+// stays idle keeps its place; one that is active or subscribed leaves the order.
+func (h *latestHub[K, V, S]) settleIdleLocked(key K, e *hubEntry[V, S], active bool) {
+	idle := len(e.subs) == 0 && !active
+	switch {
+	case idle && e.idle == nil:
+		e.idle = h.idleOrder.PushBack(key)
+		h.evictIdleLocked()
+	case !idle && e.idle != nil:
+		h.idleOrder.Remove(e.idle)
+		e.idle = nil
+	}
+}
+
+// evictIdleLocked forgets idle keys, longest idle first, until at most maxIdle
+// remain. Only idle keys are in the order, so a running or subscribed key is
+// never touched.
+func (h *latestHub[K, V, S]) evictIdleLocked() {
+	for h.idleOrder.Len() > h.maxIdle {
+		oldest := h.idleOrder.Front()
+		h.idleOrder.Remove(oldest)
+		delete(h.entries, oldest.Value.(K))
+	}
