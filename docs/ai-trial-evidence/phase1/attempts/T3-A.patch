+// goIdle gives each key a distinct, inactive state and leaves it idle (no
+// subscriber, nothing running), one after the other.
+func goIdle(h *latestHub[string, hubCounter, hubSnap], keys ...string) {
+	for i, key := range keys {
+		h.update(key, setCounter(i+1, false, keep))
+	}
+}
+
+func TestHub_IdleKeysAreCapped(t *testing.T) {
+	h := newTestHub(time.Hour, time.Now)
+
+	goIdle(h, idleKeyNames("job", 4*maxIdleHubKeys)...)
+
+	assert.Equal(t, maxIdleHubKeys, h.keyCount(), "only the newest %d idle keys are kept", maxIdleHubKeys)
+}
+
+func TestHub_OverTheLimitEvictsTheKeyIdleLongest(t *testing.T) {
+	h := newTestHub(time.Hour, time.Now)
+	keys := idleKeyNames("job", maxIdleHubKeys+1)
+
+	goIdle(h, keys[:maxIdleHubKeys]...)
+	require.True(t, h.hasKey(keys[0]), "at the limit nothing is evicted")
+	goIdle(h, keys[maxIdleHubKeys]) // one more than the limit
+
+	assert.False(t, h.hasKey(keys[0]), "the key that went idle longest ago is evicted")
+	for _, key := range keys[1:] {
+		assert.True(t, h.hasKey(key), "key %q should survive", key)
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	assert.Equal(t, 0, recvHub(t, h.subscribe(ctx, keys[0])).N, "an evicted key starts again from a fresh state")
+	assert.Equal(t, 2, recvHub(t, h.subscribe(ctx, keys[1])).N, "a kept key keeps its state")
+}
+
+func TestHub_EvictionFollowsWhenAKeyWentIdleNotWhenItWasCreated(t *testing.T) {
+	h := newTestHub(10*time.Millisecond, time.Now)
+	keys := idleKeyNames("job", maxIdleHubKeys+1)
+
+	goIdle(h, keys[0], keys[1])
+	h.update(keys[0], setCounter(7, true, keep))  // keys[0] runs again ...
+	h.update(keys[0], setCounter(7, false, keep)) // ... and goes idle after keys[1] did
+	goIdle(h, keys[2:]...)
+
+	assert.False(t, h.hasKey(keys[1]), "keys[1] has been idle longest")
+	assert.True(t, h.hasKey(keys[0]), "keys[0] went idle later than keys[1]")
+}
+
+func TestHub_RunningKeyIsNeverEvicted(t *testing.T) {
+	h := newTestHub(10*time.Millisecond, time.Now)
+	h.update("running", setCounter(5, true, keep))
+
+	goIdle(h, idleKeyNames("job", 2*maxIdleHubKeys)...)
+
+	assert.True(t, h.hasKey("running"))
+	assert.Equal(t, maxIdleHubKeys+1, h.keyCount(), "a running key is not counted against the idle limit")
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	assert.Equal(t, 5, recvHub(t, h.subscribe(ctx, "running")).N, "its state is intact")
+
+	h.update("running", setCounter(5, false, keep)) // let the ticker stop
+	require.Eventually(t, func() bool { return !h.isTicking("running") }, time.Second, 5*time.Millisecond)
+}
+
+func TestHub_SubscribedKeyIsNeverEvicted(t *testing.T) {
+	h := newTestHub(time.Hour, time.Now)
+	h.update("watched", setCounter(5, false, keep))
+	ctx, cancel := context.WithCancel(context.Background())
+	ch := h.subscribe(ctx, "watched")
+	recvHub(t, ch)
+
+	goIdle(h, idleKeyNames("job", 2*maxIdleHubKeys)...)
+
+	assert.True(t, h.hasKey("watched"))
+	assert.Equal(t, maxIdleHubKeys+1, h.keyCount(), "a subscribed key is not counted against the idle limit")
+	h.update("watched", setCounter(6, false, publishNow))
+	assert.Equal(t, 6, recvHub(t, ch).N, "the subscriber still gets its key's updates")
+
+	cancel()
+	require.Eventually(t, func() bool { return h.subscriberCount("watched") == 0 }, time.Second, 5*time.Millisecond)
+	assert.True(t, h.hasKey("watched"), "a key whose last subscriber left is idle, not evicted on the spot")
+	assert.Equal(t, maxIdleHubKeys, h.keyCount(), "it now counts as an idle key, so the longest-idle key made room")
+}
+
+func TestHub_KeyJoinsTheIdleOrderWhenItsLastSubscriberLeaves(t *testing.T) {
+	h := newTestHub(time.Hour, time.Now)
+	h.update("watched", setCounter(5, false, keep))
+	ctx, cancel := context.WithCancel(context.Background())
+	recvHub(t, h.subscribe(ctx, "watched"))
+	keys := idleKeyNames("job", maxIdleHubKeys)
+	goIdle(h, keys...) // idle keys fill the limit while "watched" is subscribed
