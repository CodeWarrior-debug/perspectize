+++ b/frontend/tests/unit/otherTypeOptions.test.ts
@@ -0,0 +1,114 @@
+import { describe, it, expect } from 'vitest';
+import {
+	ALL_SEARCH_SCOPES,
+	MOVIE_SEARCH_SCOPES,
+	otherTypeOptionsWhenOne,
+	parseGridParams,
+	searchScopesAfterFilterChange,
+	serializeGridParams,
+} from '$lib/utils/gridUrlState';
+import { CONTENT_TYPE_OPTIONS } from '$lib/utils/grid-config';
+
+const MOVIE_VIEW_SCOPES = [...ALL_SEARCH_SCOPES, ...MOVIE_SEARCH_SCOPES];
+
+const values = (filters: Record<string, string>) => otherTypeOptionsWhenOne(filters).map((o) => o.value);
+
+describe('otherTypeOptionsWhenOne', () => {
+	it('offers every other type, in the Type filter order, while exactly one type is shown', () => {
+		for (const solo of CONTENT_TYPE_OPTIONS) {
+			expect(otherTypeOptionsWhenOne({ type: solo.value })).toEqual(
+				CONTENT_TYPE_OPTIONS.filter((o) => o.value !== solo.value),
+			);
+		}
+	});
+
+	it('carries the display label with each value', () => {
+		expect(otherTypeOptionsWhenOne({ type: 'youtube_video' })).toContainEqual({ value: 'movie', label: 'Movie' });
+		expect(otherTypeOptionsWhenOne({ type: 'youtube_video' })).toContainEqual({ value: 'web_page', label: 'Webpage' });
+	});
+
+	it('never offers the type already shown', () => {
+		expect(values({ type: 'movie' })).not.toContain('movie');
+		expect(values({ type: 'movie' })).toHaveLength(CONTENT_TYPE_OPTIONS.length - 1);
+	});
+
+	it('offers nothing when there is no type filter', () => {
+		expect(otherTypeOptionsWhenOne({})).toEqual([]);
+		expect(otherTypeOptionsWhenOne({ type: '' })).toEqual([]);
+		expect(otherTypeOptionsWhenOne({ views: '1000..' })).toEqual([]);
+	});
+
+	it('offers nothing when two or more types are shown', () => {
+		expect(otherTypeOptionsWhenOne({ type: 'movie,book' })).toEqual([]);
+		expect(otherTypeOptionsWhenOne({ type: 'youtube_video,claim,movie' })).toEqual([]);
+	});
+
+	it('counts distinct types, so a repeated type still counts as one', () => {
+		expect(values({ type: 'movie,movie' })).toEqual(
+			CONTENT_TYPE_OPTIONS.map((o) => o.value).filter((v) => v !== 'movie'),
+		);
+	});
+
+	it('reads the URL value the way the type filter does: case, spaces and blanks', () => {
+		const others = CONTENT_TYPE_OPTIONS.map((o) => o.value).filter((v) => v !== 'movie');
+		expect(values({ type: 'Movie' })).toEqual(others);
+		expect(values({ type: ' movie , ' })).toEqual(others);
+	});
+
+	it('treats the pre-rename "youtube" value as YouTube Video', () => {
+		expect(values({ type: 'youtube' })).not.toContain('youtube_video');
+		expect(values({ type: 'youtube' })).toHaveLength(CONTENT_TYPE_OPTIONS.length - 1);
+		expect(values({ type: 'youtube,youtube_video' })).toHaveLength(CONTENT_TYPE_OPTIONS.length - 1);
+	});
+
+	it('ignores unknown values, as the server query does', () => {
+		// Only an unknown type: the query sends no type filter, so every type is shown.
+		expect(otherTypeOptionsWhenOne({ type: 'podcast' })).toEqual([]);
+		// One known type beside an unknown one: the query asks for just that type.
+		expect(values({ type: 'movie,podcast' })).not.toContain('movie');
+		expect(values({ type: 'movie,podcast' })).toHaveLength(CONTENT_TYPE_OPTIONS.length - 1);
+		// Two known types beside an unknown one is still several.
+		expect(otherTypeOptionsWhenOne({ type: 'movie,book,podcast' })).toEqual([]);
+	});
+
+	it('does not depend on the other filters', () => {
+		expect(values({ type: 'book', author: 'tolkien', views: '10..' })).toEqual(values({ type: 'book' }));
+	});
+});
+
+describe('searchScopesAfterFilterChange (search scopes carried through a type switch)', () => {
+	const from = (query: string) => parseGridParams(new URLSearchParams(query));
+
+	it('keeps the defaults of the new type: Cast and Director join in for Movie', () => {
+		expect(searchScopesAfterFilterChange(from('f.type=book'), { type: 'movie' })).toEqual(MOVIE_VIEW_SCOPES);
+	});
+
+	it('drops Cast and Director again when leaving Movie on the defaults', () => {
+		expect(searchScopesAfterFilterChange(from('f.type=movie'), { type: 'book' })).toEqual(ALL_SEARCH_SCOPES);
+	});
+
+	it('keeps the picks the user made that the new type still offers', () => {
+		expect(searchScopesAfterFilterChange(from('f.type=book&qf=title,tags'), { type: 'movie' })).toEqual([
+			'title',
+			'tags',
+		]);
+		expect(searchScopesAfterFilterChange(from('f.type=movie&qf=title,cast'), { type: 'book' })).toEqual(['title']);
+	});
+
+	it('falls back to the new defaults when none of the picks are still offered', () => {
+		expect(searchScopesAfterFilterChange(from('f.type=movie&qf=cast,director'), { type: 'book' })).toEqual(
+			ALL_SEARCH_SCOPES,
+		);
+	});
+
+	it('leaves no `qf` in the URL after a switch on the defaults', () => {
+		const state = from('f.type=movie');
+		const filters = { type: 'book' };
+		const search = serializeGridParams({
+			...state,
+			filters,
+			qFields: searchScopesAfterFilterChange(state, filters),
+		});
+		expect(search).not.toContain('qf=');
+	});
+});
