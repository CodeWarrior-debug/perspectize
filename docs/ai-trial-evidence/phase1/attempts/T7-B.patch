+/**
+ * The lowercase content types a `f.type` URL value names, minus unknown values (a stale or
+ * hand-edited URL), since the server rejects anything outside its ContentType enum.
+ */
+function knownTypes(value: string): string[] {
+	const known = new Set(CONTENT_TYPE_OPTIONS.map((o) => o.value));
+	return parseSetValue(value).filter((v) => known.has(v));
+}
+
+/**
+ * The other content types, offered as one-click switches while exactly one type is shown. Empty
+ * when the type filter names none or several, since there is then no single current type to
+ * switch away from. Counts the types the way the server query does (unknown values dropped).
+ */
+export function otherTypeOptionsWhenOne(filters: Record<string, string>): readonly { value: string; label: string }[] {
+	const types = knownTypes(filters.type ?? '');
+	return types.length === 1 ? CONTENT_TYPE_OPTIONS.filter((o) => o.value !== types[0]) : [];
+}
