+<script lang="ts">
+	/**
+	 * TypePills: one-click switches to other content types, shown while the Library lists a
+	 * single type. Renders nothing when there is nothing to offer. The parent owns what a
+	 * switch does to the URL (see `otherTypeOptionsWhenOne` for which types to pass in).
+	 */
+	let {
+		options,
+		onSelect,
+	}: {
+		options: readonly { value: string; label: string }[];
+		/** Receives the option's `value` (lowercase, as used in `f.type=`), not its label. */
+		onSelect: (value: string) => void;
+	} = $props();
+</script>
+
+{#if options.length > 0}
+	<div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Switch content type">
+		<span class="text-muted-foreground text-xs" aria-hidden="true">Switch to</span>
+		{#each options as option (option.value)}
+			<button
+				type="button"
+				onclick={() => onSelect(option.value)}
+				class="border-border bg-background text-foreground hover:bg-accent rounded-full border px-3 py-1 text-xs transition-colors"
+			>
+				{option.label}
+			</button>
+		{/each}
+	</div>
+{/if}
