@@ -0,0 +1,47 @@
+import { describe, it, expect, vi } from 'vitest';
+import { render, screen, fireEvent } from '@testing-library/svelte';
+import TypePills from '$lib/components/TypePills.svelte';
+
+const OPTIONS = [
+	{ value: 'movie', label: 'Movie' },
+	{ value: 'web_page', label: 'Webpage' },
+	{ value: 'youtube_video', label: 'YouTube Video' },
+];
+
+describe('TypePills', () => {
+	it('renders one button per option, labelled with the type name', () => {
+		render(TypePills, { props: { options: OPTIONS, onSelect: vi.fn() } });
+		const group = screen.getByRole('group', { name: 'Switch content type' });
+		expect(group).toBeInTheDocument();
+		expect(screen.getAllByRole('button').map((b) => b.textContent?.trim())).toEqual([
+			'Movie',
+			'Webpage',
+			'YouTube Video',
+		]);
+	});
+
+	it('renders nothing when there is nothing to offer', () => {
+		const { container } = render(TypePills, { props: { options: [], onSelect: vi.fn() } });
+		expect(screen.queryByRole('group')).toBeNull();
+		expect(screen.queryAllByRole('button')).toHaveLength(0);
+		expect(container.textContent?.trim()).toBe('');
+	});
+
+	it('hands up the option value, not the label, on click', async () => {
+		const onSelect = vi.fn();
+		render(TypePills, { props: { options: OPTIONS, onSelect } });
+
+		await fireEvent.click(screen.getByRole('button', { name: 'Webpage' }));
+
+		expect(onSelect).toHaveBeenCalledTimes(1);
+		expect(onSelect).toHaveBeenCalledWith('web_page');
+	});
+
+	it('is a plain action button, not a toggle (the shown type is simply absent)', () => {
+		render(TypePills, { props: { options: OPTIONS, onSelect: vi.fn() } });
+		for (const button of screen.getAllByRole('button')) {
+			expect(button).toHaveAttribute('type', 'button');
+			expect(button).not.toHaveAttribute('aria-pressed');
+		}
+	});
+});
diff --git a/frontend/tests/unit/otherTypeOptions.test.ts b/frontend/tests/unit/otherTypeOptions.test.ts
