+/**
+ * The search scopes to carry when the URL filters change from `from.filters` to `filters`. Scopes
+ * still at their defaults stay at the defaults of the new filters (Cast/Director come and go with
+ * the Movie filter); otherwise the user's picks that are still offered, or the new defaults if none are.
+ */
+export function searchScopesAfterFilterChange(from: GridParams, filters: Record<string, string>): SearchScopeKey[] {
+	const offered = searchScopesFor(filters);
+	if (sameScopes(from.qFields, searchScopesFor(from.filters))) return offered;
+	const kept = offered.filter((s) => from.qFields.includes(s));
+	return kept.length > 0 ? kept : offered;
+}
