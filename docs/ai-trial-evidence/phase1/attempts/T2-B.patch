+// TestGormContentRepository_List_LikeCountSortGuardsBigintCast pins that every place the
+// LIKE_COUNT sort expression lands in the SQL (select list, ORDER BY, cursor WHERE)
+// carries the digits-only guard. A bare ::BIGINT on a stored "" makes Postgres reject
+// the whole list.
+func TestGormContentRepository_List_LikeCountSortGuardsBigintCast(t *testing.T) {
+	ctx := context.Background()
+	guard := regexp.QuoteMeta(`CASE WHEN (response->'items'->0->'statistics'->>'likeCount') ~ '^[0-9]{1,18}$' ` +
+		`THEN (response->'items'->0->'statistics'->>'likeCount')::BIGINT END`)
+
+	for _, order := range []struct {
+		name string
+		by   domain.SortOrder
+		sql  string
+	}{
+		{"descending", domain.SortOrderDesc, "DESC"},
+		{"ascending", domain.SortOrderAsc, "ASC"},
+	} {
+		t.Run(order.name, func(t *testing.T) {
+			db, mock := newMockDB(t)
+			repo := NewGormContentRepository(db)
+			first := 1
+			params := domain.ContentListParams{First: &first, SortBy: domain.ContentSortByLikeCount, SortOrder: order.by}
+
+			// Page 1: the select list and the ORDER BY both use the guarded expression. The
+			// last row's like_count is NULL (a hidden-likes video), so its cursor carries null.
+			mock.ExpectQuery(`SELECT content\.\*, \(` + guard + `\) AS like_count FROM "content" .*` +
+				`ORDER BY COALESCE\(` + guard + `, '0'\) ` + order.sql).
+				WillReturnRows(computedRows("like_count", nil))
+			page1, err := repo.List(ctx, params)
+			require.NoError(t, err)
+			require.NotNil(t, page1.EndCursor)
+
+			// Page 2: the cursor comparison uses the same guarded expression and binds the
+			// unknown-sort value 0 for the NULL row.
+			params.After = page1.EndCursor
+			mock.ExpectQuery(`WHERE content\.privacy = \$1 AND .*COALESCE\(`+guard+`, '0'\)`).
+				WithArgs("public", derefArg{int64(0)}, derefArg{int64(161)}, 2).
+				WillReturnRows(computedRows("like_count", nil))
+			_, err = repo.List(ctx, params)
+			require.NoError(t, err)
+			assertAllExpectationsMet(t, mock)
+		})
+	}
+}
