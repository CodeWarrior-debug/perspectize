diff --git a/backend/internal/adapters/repositories/postgres/gorm_content_sort_integration_test.go b/backend/internal/adapters/repositories/postgres/gorm_content_sort_integration_test.go
new file mode 100644
index 00000000..a82394c8
--- /dev/null
+++ b/backend/internal/adapters/repositories/postgres/gorm_content_sort_integration_test.go
@@ -0,0 +1,104 @@
+package postgres
+
+// Integration test for the LIKE_COUNT content sort against a real Postgres.
+//
+// It runs only when DATABASE_URL points at the LOCAL throwaway database (host
+// localhost or 127.0.0.1, database name "testdb"); see openLocalUserTodoTestDB. Any
+// other URL, including the shared Neon database, makes it skip.
+//
+//	DATABASE_URL="postgres://postgres:postgres@localhost:5432/testdb?sslmode=disable" \
+//	  go test -p 1 ./internal/adapters/repositories/postgres/ -run LikeCountSortIntegration -v
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/CodeWarrior-debug/perspectize/backend/internal/core/domain"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestGormContentRepository_LikeCountSortIntegration lists content sorted by LIKE_COUNT
+// when some rows store a likeCount that is not a number: "" (what YouTube stores for
+// hidden likes), other text, or no key at all. Postgres rejects a bare ::BIGINT cast on
+// "" and would fail the whole list; those rows must sort as unknown (0) and the list,
+// including its cursor pages, must work.
+func TestGormContentRepository_LikeCountSortIntegration(t *testing.T) {
+	db := openLocalUserTodoTestDB(t)
+	ctx := context.Background()
+	repo := NewGormContentRepository(db)
+
+	salt := time.Now().UnixNano()
+	var userID int
+	require.NoError(t, db.Raw("INSERT INTO users (username) VALUES (?) RETURNING id",
+		fmt.Sprintf("ls-%06x", salt&0xFFFFFF)).Scan(&userID).Error)
+
+	// Insertion order sets the ids, which break ties between rows that share a sort value.
+	prefix := fmt.Sprintf("likesort-%x", salt)
+	rows := []struct {
+		suffix   string
+		response string
+	}{
+		{"empty", `{"items":[{"statistics":{"viewCount":"10","likeCount":""}}]}`},
+		{"text", `{"items":[{"statistics":{"viewCount":"10","likeCount":"abc"}}]}`},
+		{"spaced", `{"items":[{"statistics":{"viewCount":"10","likeCount":"12 "}}]}`},
+		{"missing", `{"items":[{"statistics":{"viewCount":"10"}}]}`},
+		{"five", `{"items":[{"statistics":{"viewCount":"10","likeCount":"5"}}]}`},
+		{"threehundred", `{"items":[{"statistics":{"viewCount":"10","likeCount":"300"}}]}`},
+		{"thousand", `{"items":[{"statistics":{"viewCount":"10","likeCount":"1000"}}]}`},
+	}
+	ids := make([]int, 0, len(rows))
+	for _, r := range rows {
+		var id int
+		require.NoError(t, db.Raw(
+			"INSERT INTO content (name, content_type, added_by_user_id, response) VALUES (?, 'youtube_video', ?, ?::jsonb) RETURNING id",
+			prefix+"-"+r.suffix, userID, r.response).Scan(&id).Error)
+		ids = append(ids, id)
+	}
+	t.Cleanup(func() {
+		db.Exec("DELETE FROM content WHERE id IN ?", ids)
+		db.Exec("DELETE FROM users WHERE id = ?", userID)
+	})
+
+	// listAll walks every page of size pageSize and returns the row names in order.
+	listAll := func(t *testing.T, order domain.SortOrder, pageSize int) []string {
+		t.Helper()
+		search := prefix
+		params := domain.ContentListParams{
+			First:     &pageSize,
+			SortBy:    domain.ContentSortByLikeCount,
+			SortOrder: order,
+			Filter:    &domain.ContentFilter{Search: &search},
+		}
+		var names []string
+		for page := 0; page < len(rows)+2; page++ {
+			got, err := repo.List(ctx, params)
+			require.NoError(t, err, "a non-numeric likeCount must not fail the list")
+			for _, item := range got.Items {
+				names = append(names, item.Name[len(prefix)+1:])
+			}
+			if !got.HasNext {
+				return names
+			}
+			params.After = got.EndCursor
+		}
+		t.Fatalf("pagination did not finish; collected %v", names)
+		return nil
+	}
+
+	// Unknown likes count as 0, so they sort below every real count (descending) or above
+	// it (ascending), ties broken by id in the requested direction.
+	wantDesc := []string{"thousand", "threehundred", "five", "missing", "spaced", "text", "empty"}
+	wantAsc := []string{"empty", "text", "spaced", "missing", "five", "threehundred", "thousand"}
+
+	for _, pageSize := range []int{len(rows), 2, 1} {
+		t.Run(fmt.Sprintf("descending, page size %d", pageSize), func(t *testing.T) {
+			assert.Equal(t, wantDesc, listAll(t, domain.SortOrderDesc, pageSize))
+		})
+		t.Run(fmt.Sprintf("ascending, page size %d", pageSize), func(t *testing.T) {
+			assert.Equal(t, wantAsc, listAll(t, domain.SortOrderAsc, pageSize))
+		})
+	}
+}
