+
+	// The BSB stores a few verses with empty text (their content sits in a footnote). They keep
+	// their verse number and get an inline marker; we never synthesize text for them.
+	function isOmitted(v: VerseText): boolean {
+		return !v.text || v.text.trim() === '';
+	}
+
+	// A passage made only of omitted verses has nothing to render, so it is replaced by an
+	// explanation and an outbound link in the default Bible Gateway version.
+	const allOmitted = $derived(verses.length > 0 && verses.every(isOmitted));
+	const omittedRange = $derived(allOmitted ? verseIdsToRange(startVerseId, endVerseId) : null);
+	const omittedLink = $derived(omittedRange ? gatewayLink(omittedRange, DEFAULT_VERSION).url : null);
 </script>
 
