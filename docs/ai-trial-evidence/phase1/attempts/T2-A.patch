+// likeCountText is the stored YouTube statistics.likeCount, still text.
+const likeCountText = "(response->'items'->0->'statistics'->>'likeCount')"
+
+// likeCountSortExpr is the LIKE_COUNT sort key. YouTube stores likeCount as a string and
+// it can be empty (hidden likes), which a bare ::BIGINT cast rejects, failing the whole
+// list. Only a plain digit string is cast; anything else yields NULL, which the rule's
+// NULLReplacement sorts as 0 (the same "unknown" the GraphQL likeCount field shows for an
+// empty value). Postgres evaluates a CASE branch only for rows that match its WHEN, so
+// the cast never sees a non-numeric value. The 18-digit cap keeps the cast inside BIGINT.
+const likeCountSortExpr = "CASE WHEN " + likeCountText + " ~ '^[0-9]{1,18}$' " +
+	"THEN " + likeCountText + "::BIGINT END"
+
