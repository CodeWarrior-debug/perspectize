+// TestList_LikeCountSortNeverCastsUnguarded pins the hidden-likes failure: YouTube can
+// store statistics.likeCount as "", and Postgres rejects "" cast to BIGINT, which failed
+// the whole list ("failed to list content"). Every place the sort expression appears (the
+// selected cursor column, ORDER BY, and page 2's keyset WHERE) must put the cast behind
+// the all-digits guard, so a non-numeric value becomes NULL and sorts as 0.
+func TestList_LikeCountSortNeverCastsUnguarded(t *testing.T) {
+	const (
+		bareCast = `(response->'items'->0->'statistics'->>'likeCount')::BIGINT`
+		guarded  = `CASE WHEN (response->'items'->0->'statistics'->>'likeCount') ~ '^[0-9]{1,18}$' THEN ` + bareCast + ` END`
+	)
+	for _, order := range []domain.SortOrder{domain.SortOrderAsc, domain.SortOrderDesc} {
+		t.Run(string(order), func(t *testing.T) {
+			ctx := context.Background()
+			db, mock := newMockDB(t)
+			repo := NewGormContentRepository(db)
+			first := 1
+			params := domain.ContentListParams{First: &first, SortBy: domain.ContentSortByLikeCount, SortOrder: order}
+
+			mock.ExpectQuery(`SELECT content\.\*, \(.+\) AS like_count`).WillReturnRows(computedRows("like_count", int64(0)))
+			c := querycount.Attach(t, db)
+			page1, err := repo.List(ctx, params)
+			require.NoError(t, err)
+			require.NotNil(t, page1.EndCursor)
+
+			params.After = page1.EndCursor
+			mock.ExpectQuery(`WHERE content\.privacy = \$1 AND .*COALESCE`).
+				WillReturnRows(computedRows("like_count", int64(0)))
+			_, err = repo.List(ctx, params)
+			require.NoError(t, err)
+			assertAllExpectationsMet(t, mock)
+
+			stmts := c.Statements()
+			require.Len(t, stmts, 2)
+			for i, stmt := range stmts {
+				assert.Contains(t, stmt, "("+guarded+") AS like_count", "statement %d: selected cursor column", i+1)
+				assert.Contains(t, stmt, "ORDER BY COALESCE("+guarded+", ", "statement %d: ORDER BY", i+1)
+				assert.Equal(t, strings.Count(stmt, guarded), strings.Count(stmt, bareCast),
+					"statement %d: every BIGINT cast of likeCount must sit inside the digit guard", i+1)
+			}
+			assert.Contains(t, stmts[1], "WHERE content.privacy = $1 AND (COALESCE("+guarded+", ",
+				"page 2 keyset comparison must use the guarded expression")
+		})
+	}
+}
