+/**
+ * A reactive stand-in for SvelteKit's `page` from `$app/state`: assigning `livePage.url` after render
+ * re-derives everything that reads `page.url`, the way a navigation does. `.svelte.ts` so `$state` works.
+ * Test-only; tests that never change the URL after render use `mockPageState` from `tests/setup.ts`.
+ */
+export const livePage = $state({
+	url: new URL('http://localhost/'),
+	params: {},
+	route: { id: '/' },
+	status: 200,
+	error: null,
+	data: {},
+	form: null,
+});
diff --git a/frontend/tests/unit/activity-list-displayed-order.test.ts b/frontend/tests/unit/activity-list-displayed-order.test.ts
new file mode 100644
index 00000000..f626d3a4
--- /dev/null
+++ b/frontend/tests/unit/activity-list-displayed-order.test.ts
@@ -0,0 +1,187 @@
+/**
+ * DisplayedOrder keeps the Library list where the user left it while one query key refetches
+ * (an edited row comes back first from the server and must not jump out of view). A new key,
+ * leaving Loaded mode, and placeholder data all fall back to the server order.
+ */
+import { describe, it, expect } from 'vitest';
+import { hashKey } from '@tanstack/svelte-query';
+import { activityListRequest, DisplayedOrder } from '$lib/queries/content';
+import { parseGridParams } from '$lib/utils/gridUrlState';
+
+interface Row {
+	id: string;
+	name: string;
+}
+const row = (id: string, name = `row ${id}`): Row => ({ id, name });
+const ids = (rows: readonly Row[]) => rows.map((r) => r.id);
+
+/** One fetch the way ActivityTable sees it: arrange the response, then record what is shown. */
+function show(order: DisplayedOrder, key: string | null, items: Row[], placeholder = false) {
+	const shown = order.arrange(key, items, placeholder);
+	order.record(key, shown, placeholder);
+	return shown;
+}
+
+describe('DisplayedOrder: one key, refetched', () => {
+	it('shows the first response in server order', () => {
+		const order = new DisplayedOrder();
+		expect(ids(show(order, 'a', [row('1'), row('2'), row('3')]))).toEqual(['1', '2', '3']);
+	});
+
+	it('keeps an edited row in place when the server returns it first', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3')]);
+		const shown = show(order, 'a', [row('3', 'edited'), row('1'), row('2')]);
+		expect(ids(shown)).toEqual(['1', '2', '3']);
+		// The kept row still carries the fresh data from the refetch.
+		expect(shown[2].name).toBe('edited');
+	});
+
+	it('keeps the order across several refetches', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3')]);
+		show(order, 'a', [row('2'), row('1'), row('3')]);
+		expect(ids(show(order, 'a', [row('3'), row('2'), row('1')]))).toEqual(['1', '2', '3']);
+	});
+
+	it('puts new rows first, in server order, and keeps the rest where they were', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3')]);
+		const shown = show(order, 'a', [row('5'), row('4'), row('3'), row('1'), row('2')]);
+		expect(ids(shown)).toEqual(['5', '4', '1', '2', '3']);
+	});
+
+	it('remembers a new row at the front for the next refetch', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2')]);
+		show(order, 'a', [row('9'), row('1'), row('2')]);
+		expect(ids(show(order, 'a', [row('2'), row('9'), row('1')]))).toEqual(['9', '1', '2']);
+	});
+
+	it('drops rows the response no longer has and leaves no gap', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3'), row('4')]);
+		expect(ids(show(order, 'a', [row('4'), row('3'), row('1')]))).toEqual(['1', '3', '4']);
+	});
+
+	it('does not bring a dropped row back at its old place when it returns later', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3')]);
+		show(order, 'a', [row('1'), row('3')]);
+		// 2 came back: it is new again, so it leads.
+		expect(ids(show(order, 'a', [row('2'), row('1'), row('3')]))).toEqual(['2', '1', '3']);
+	});
+
+	it('compares ids as strings, so 1 and "1" are the same row', () => {
+		const order = new DisplayedOrder();
+		order.record('a', [{ id: 1 }, { id: 2 }], false);
+		expect(order.arrange('a', [{ id: '2' }, { id: '1' }], false).map((r) => r.id)).toEqual(['1', '2']);
+	});
+
+	it('handles an empty response and recovers when rows arrive', () => {
+		const order = new DisplayedOrder();
+		expect(show(order, 'a', [])).toEqual([]);
+		expect(ids(show(order, 'a', [row('2'), row('1')]))).toEqual(['2', '1']);
+	});
+
+	it('arrange alone never changes what is remembered', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2')]);
+		order.arrange('a', [row('2'), row('1')], false);
+		expect(ids(order.arrange('a', [row('2'), row('1')], false))).toEqual(['1', '2']);
+	});
+});
+
+describe('DisplayedOrder: a new key starts from the server order', () => {
+	it('uses the server order for another key', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3')]);
+		expect(ids(show(order, 'b', [row('3'), row('2'), row('1')]))).toEqual(['3', '2', '1']);
+	});
+
+	it('keeps the new key order after the key changed', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3')]);
+		show(order, 'b', [row('3'), row('2'), row('1')]);
+		expect(ids(show(order, 'b', [row('1'), row('3'), row('2')]))).toEqual(['3', '2', '1']);
+	});
+
+	it('forgets the first key: coming back to it starts from the server order again', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3')]);
+		show(order, 'a', [row('3'), row('1'), row('2')]);
+		show(order, 'b', [row('2'), row('3'), row('1')]);
+		expect(ids(show(order, 'a', [row('3'), row('1'), row('2')]))).toEqual(['3', '1', '2']);
+	});
+
+	it('forgets the order after leaving Loaded mode (null key) and returning', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3')]);
+		expect(ids(show(order, null, [row('3'), row('2'), row('1')]))).toEqual(['3', '2', '1']);
+		expect(ids(show(order, 'a', [row('3'), row('2'), row('1')]))).toEqual(['3', '2', '1']);
