diff --git a/frontend/src/lib/queries/content/displayedOrder.ts b/frontend/src/lib/queries/content/displayedOrder.ts
new file mode 100644
index 00000000..35793549
--- /dev/null
+++ b/frontend/src/lib/queries/content/displayedOrder.ts
@@ -0,0 +1,51 @@
+/**
+ * Keeps the Library list in the order the user is looking at while the same query refetches.
+ *
+ * The server returns Loaded-mode rows by updatedAt desc, so editing a row bumps it to the top of the
+ * next response and the row the user just touched jumps out of view. `DisplayedOrder` remembers the
+ * order last shown for one query key and re-applies it to the next response of that key:
+ *
+ *  - rows already shown keep their place (with their fresh data);
+ *  - rows that were not shown before lead, in server order, matching the default sort;
+ *  - rows the response no longer has drop out.
+ *
+ * A different key (another sort, filter, search or page, or leaving Loaded mode) starts over from the
+ * server order. Placeholder data (the previous key's rows shown while the new key loads) is neither
+ * reordered nor remembered.
+ *
+ * Pure: no runes, no network. `arrange` only reads and `record` only writes, so ActivityTable can call
+ * `arrange` from a `$derived` and `record` from an `$effect`, which runs once the query result for the
+ * current key has settled.
+ */
+export interface OrderedRow {
+	id: string | number;
+}
+
+export class DisplayedOrder {
+	#key: string | null = null;
+	#ids: readonly string[] | null = null;
+
+	/**
+	 * `items` (server order) in the remembered order for `key`, or untouched when there is nothing to
+	 * keep. `key` is null when this view keeps the server order (not Loaded mode).
+	 */
+	arrange<T extends OrderedRow>(key: string | null, items: readonly T[], placeholder: boolean): readonly T[] {
+		if (key === null || placeholder || key !== this.#key || this.#ids === null) return items;
+		const place = new Map(this.#ids.map((id, index) => [id, index] as const));
+		const fresh: T[] = [];
+		const kept: T[] = [];
+		for (const item of items) (place.has(String(item.id)) ? kept : fresh).push(item);
+		kept.sort((a, b) => place.get(String(a.id))! - place.get(String(b.id))!);
+		return [...fresh, ...kept];
+	}
+
+	/** Remember what is displayed for `key`. A new key forgets the old order first, even for placeholder data. */
+	record<T extends OrderedRow>(key: string | null, shown: readonly T[], placeholder: boolean): void {
+		if (key !== this.#key) {
+			this.#key = key;
+			this.#ids = null;
+		}
+		if (key === null || placeholder) return;
+		this.#ids = shown.map((item) => String(item.id));
+	}
+}
