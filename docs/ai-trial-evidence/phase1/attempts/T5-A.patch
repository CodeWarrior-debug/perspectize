diff --git a/frontend/tests/components/ActivityTable.displayedOrder.test.ts b/frontend/tests/components/ActivityTable.displayedOrder.test.ts
new file mode 100644
index 00000000..76a016e7
--- /dev/null
+++ b/frontend/tests/components/ActivityTable.displayedOrder.test.ts
@@ -0,0 +1,245 @@
+/**
+ * ActivityTable keeps the Library list in the order the user sees while the same query refetches,
+ * so an edited row (which the server returns first, by updatedAt desc) does not jump out of view.
+ *
+ * AG Grid does not render in jsdom, so these run on the mobile card list, which reads the same
+ * rowData the grid does. A real QueryClient drives real refetches; the page URL is reactive
+ * (tests/helpers/livePage.svelte.ts) so a search change re-keys the query like a navigation would.
+ */
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import { render, waitFor } from '@testing-library/svelte';
+import { QueryClient } from '@tanstack/svelte-query';
+import TestWrapper from '../helpers/TestWrapper.svelte';
+import { livePage } from '../helpers/livePage.svelte';
+import { queryKeys } from '$lib/queries/keys';
+
+const { mockRequest, clerkState } = vi.hoisted(() => ({
+	mockRequest: vi.fn(),
+	clerkState: { isLoaded: false, auth: { userId: null as string | null } },
+}));
+
+vi.mock('ag-grid-svelte5', () => ({
+	default: vi.fn(() => ({ $$: {}, $set: vi.fn(), $on: vi.fn(), $destroy: vi.fn() })),
+}));
+vi.mock('$lib/queries/client', () => ({ graphqlRequest: mockRequest }));
+vi.mock('svelte-clerk', () => ({ useClerkContext: () => clerkState }));
+vi.mock('$app/state', async () => {
+	const { livePage } = await import('../helpers/livePage.svelte');
+	return { page: livePage, updated: { current: false, check: vi.fn(async () => false) } };
+});
+
+import ActivityTable from '$lib/components/ActivityTable.svelte';
+import { preloadLazy, warmUp } from '../helpers/warmUp';
+
+const pageInfo = { hasNextPage: false, hasPreviousPage: false, startCursor: null, endCursor: null };
+
+function video(id: string, name = `Video ${id}`) {
+	return {
+		id,
+		name,
+		url: `https://youtube.com/watch?v=v${id}`,
+		contentType: 'YOUTUBE_VIDEO',
+		length: 300,
+		lengthUnits: 'seconds',
+		viewCount: 1500,
+		likeCount: 100,
+		channelTitle: 'Test Channel',
+		publishedAt: '2024-01-15T00:00:00Z',
+		tags: ['test'],
+		description: 'A test video',
+		createdAt: '2024-01-20',
+		updatedAt: '2024-01-25',
+	};
+}
+
+/** What the server would answer next: the rows in the order it sorts them. */
+let serverRows: ReturnType<typeof video>[] = [];
+
+function respond(query: unknown) {
+	if (!String(query).includes('ListContent')) return { content: { items: [], pageInfo, totalCount: 0 } };
+	return { content: { items: serverRows, pageInfo, totalCount: serverRows.length } };
+}
+
+function cardOrder(container: HTMLElement): string[] {
+	return Array.from(container.querySelectorAll('[data-testid^="card-thumb-"]')).map((el) =>
+		(el.getAttribute('data-testid') ?? '').replace('card-thumb-', ''),
+	);
+}
+
+function cardTitles(container: HTMLElement): string[] {
+	return Array.from(container.querySelectorAll('button[title="View content data + details"] > div:first-child')).map(
+		(el) => el.textContent?.trim() ?? '',
+	);
+}
+
+let queryClient: QueryClient;
+// The setup.ts matchMedia mock is not configurable, so put the original function back by reassignment.
+const originalMatchMedia = window.matchMedia;
+
+/** Below 860px the grid is replaced by the card list (see the media query in useCardMode). */
+function useCardViewport() {
+	window.matchMedia = vi.fn(
+		(query: string) =>
+			({
+				matches: query.includes('max-width: 859px'),
+				media: query,
+				onchange: null,
+				addListener: vi.fn(),
+				removeListener: vi.fn(),
+				addEventListener: vi.fn(),
+				removeEventListener: vi.fn(),
+				dispatchEvent: vi.fn(),
+			}) as unknown as MediaQueryList,
+	);
+}
+
+function renderTable() {
+	return render(TestWrapper, { props: { queryClient, component: ActivityTable, props: {} } });
+}
+
+/** The server now answers `rows`; refetch the Library list the way a saved edit does. */
+async function refetchWith(rows: ReturnType<typeof video>[]) {
+	serverRows = rows;
+	await queryClient.invalidateQueries({ queryKey: queryKeys.content.lists() });
+}
+
+preloadLazy(() => import('$lib/components/PerspectivePopover.svelte'));
+warmUp(() => {
+	queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+	mockRequest.mockImplementation(async (query: unknown) => respond(query));
+	useCardViewport();
+	try {
+		return renderTable();
+	} finally {
+		window.matchMedia = originalMatchMedia;
+	}
+});
+
+describe('ActivityTable: displayed order while the list refetches (Loaded mode)', () => {
+	beforeEach(() => {
+		vi.clearAllMocks();
+		useCardViewport();
+		clerkState.isLoaded = false;
+		clerkState.auth.userId = null;
+		livePage.url = new URL('http://localhost/');
+		serverRows = [video('1'), video('2'), video('3'), video('4')];
+		mockRequest.mockImplementation(async (query: unknown) => respond(query));
+		queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+	});
+
+	afterEach(() => {
+		window.matchMedia = originalMatchMedia;
+	});
+
+	it('starts in the server order', async () => {
+		const { container } = renderTable();
+		await waitFor(() => expect(cardOrder(container)).toEqual(['1', '2', '3', '4']));
+	});
+
+	it('keeps an edited row where it was when the server returns it first', async () => {
+		const { container } = renderTable();
+		await waitFor(() => expect(cardOrder(container)).toEqual(['1', '2', '3', '4']));
+		const listCalls = () => mockRequest.mock.calls.filter(([q]) => String(q).includes('ListContent')).length;
+		const before = listCalls();
+
+		await refetchWith([video('3', 'Video 3 (edited)'), video('1'), video('2'), video('4')]);
+
+		await waitFor(() => expect(cardTitles(container)).toContain('Video 3 (edited)'));
+		expect(listCalls()).toBe(before + 1);
+		expect(cardOrder(container)).toEqual(['1', '2', '3', '4']);
+	});
+
+	it('keeps the order through more than one refetch', async () => {
+		const { container } = renderTable();
+		await waitFor(() => expect(cardOrder(container)).toEqual(['1', '2', '3', '4']));
+
+		await refetchWith([video('4', 'Video 4 (edited)'), video('1'), video('2'), video('3')]);
+		await waitFor(() => expect(cardTitles(container)).toContain('Video 4 (edited)'));
+		await refetchWith([video('2', 'Video 2 (edited)'), video('4', 'Video 4 (edited)'), video('1'), video('3')]);
+		await waitFor(() => expect(cardTitles(container)).toContain('Video 2 (edited)'));
+
+		expect(cardOrder(container)).toEqual(['1', '2', '3', '4']);
+	});
+
+	it('puts a new row first and keeps the others where they were', async () => {
+		const { container } = renderTable();
+		await waitFor(() => expect(cardOrder(container)).toEqual(['1', '2', '3', '4']));
+
+		await refetchWith([video('9'), video('3', 'Video 3 (edited)'), video('1'), video('2'), video('4')]);
+
+		await waitFor(() => expect(cardOrder(container)).toEqual(['9', '1', '2', '3', '4']));
+	});
+
+	it('drops a row the server no longer returns without moving the rest', async () => {
+		const { container } = renderTable();
+		await waitFor(() => expect(cardOrder(container)).toEqual(['1', '2', '3', '4']));
+
+		await refetchWith([video('4'), video('3'), video('1')]);
+
+		await waitFor(() => expect(cardOrder(container)).toEqual(['1', '3', '4']));
+	});
+
+	it('starts from the server order when the search changes', async () => {
+		const { container } = renderTable();
+		await waitFor(() => expect(cardOrder(container)).toEqual(['1', '2', '3', '4']));
+		await refetchWith([video('3', 'Video 3 (edited)'), video('1'), video('2'), video('4')]);
+		await waitFor(() => expect(cardTitles(container)).toContain('Video 3 (edited)'));
+		expect(cardOrder(container)).toEqual(['1', '2', '3', '4']);
+
+		// A new search is a new key: its rows come back in the server order, not the one on screen.
+		serverRows = [video('4'), video('3', 'Video 3 (edited)'), video('2'), video('1')];
+		livePage.url = new URL('http://localhost/?q=video');
+
+		await waitFor(() => expect(cardOrder(container)).toEqual(['4', '3', '2', '1']));
+	});
+
+	it('starts from the server order when the Type filter changes', async () => {
+		const { container } = renderTable();
+		await waitFor(() => expect(cardOrder(container)).toEqual(['1', '2', '3', '4']));
+		await refetchWith([video('2', 'Video 2 (edited)'), video('1'), video('3'), video('4')]);
+		await waitFor(() => expect(cardTitles(container)).toContain('Video 2 (edited)'));
+
+		// `f=none` clears the default YouTube Type filter: a different request, so a different key.
+		serverRows = [video('4'), video('2'), video('3'), video('1')];
+		livePage.url = new URL('http://localhost/?f=none');
+
+		await waitFor(() => expect(cardOrder(container)).toEqual(['4', '2', '3', '1']));
+	});
+
+	it('neither orders nor records the placeholder rows while the next key loads', async () => {
+		const { container } = renderTable();
+		await waitFor(() => expect(cardOrder(container)).toEqual(['1', '2', '3', '4']));
+		await refetchWith([video('3', 'Video 3 (edited)'), video('1'), video('2'), video('4')]);
+		await waitFor(() => expect(cardTitles(container)).toContain('Video 3 (edited)'));
+
+		// Hold the next key's response so the placeholder (previous rows) stays on screen.
+		let release: (value: unknown) => void = () => {};
+		const gate = new Promise((resolve) => (release = resolve));
+		mockRequest.mockImplementation(async (query: unknown) => {
+			if (String(query).includes('ListContent')) await gate;
+			return respond(query);
+		});
+		serverRows = [video('2'), video('4'), video('1'), video('3')];
+		livePage.url = new URL('http://localhost/?q=video');
+
+		// While loading, the previous key's rows are the placeholder: shown as that response came from
+		// the server (3 first), not in the order kept for the previous key (1 2 3 4)...
+		await waitFor(() => expect(mockRequest.mock.calls.some(([, v]) => v?.filter?.search === 'video')).toBe(true));
+		expect(cardOrder(container)).toEqual(['3', '1', '2', '4']);
+
+		// ...and the real response is then shown in the order the server sent, not one recorded from the placeholder
+		// (that would put 3 1 2 4 back on top of it).
+		release(undefined);
+		await waitFor(() => expect(cardOrder(container)).toEqual(['2', '4', '1', '3']));
+	});
+
+	it('does not keep the order in "All Items" mode (server sort and page decide)', async () => {
+		livePage.url = new URL('http://localhost/?mode=all');
+		const { container } = renderTable();
+		await waitFor(() => expect(cardOrder(container)).toEqual(['1', '2', '3', '4']));
+
+		await refetchWith([video('3', 'Video 3 (edited)'), video('1'), video('2'), video('4')]);
+
+		await waitFor(() => expect(cardOrder(container)).toEqual(['3', '1', '2', '4']));
+	});
+});
