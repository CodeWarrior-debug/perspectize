+describe('DisplayedOrder: placeholder data is neither applied nor recorded', () => {
+	it('does not apply the remembered order to placeholder rows', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3')]);
+		// Same key still, but the rows are a placeholder: leave them as given.
+		expect(ids(order.arrange('a', [row('3'), row('2'), row('1')], true))).toEqual(['3', '2', '1']);
+	});
+
+	it('does not record the placeholder rows for the new key', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3')]);
+		// Key b is loading and shows a's rows as a placeholder.
+		show(order, 'b', [row('1'), row('2'), row('3')], true);
+		// b's real response comes in another order and must be shown as sent.
+		expect(ids(show(order, 'b', [row('3'), row('1'), row('2')]))).toEqual(['3', '1', '2']);
+	});
+
+	it('does not carry a stale order back to the first key when the switch was only a placeholder', () => {
+		const order = new DisplayedOrder();
+		show(order, 'a', [row('1'), row('2'), row('3')]);
+		show(order, 'a', [row('3'), row('1'), row('2')]); // refetch, kept as 1 2 3
+		show(order, 'b', [row('1'), row('2'), row('3')], true); // placeholder for b, key changed
+		// Back on a before b ever loaded: the key did change in between, so a starts over.
+		expect(ids(show(order, 'a', [row('3'), row('1'), row('2')]))).toEqual(['3', '1', '2']);
+	});
+
+	it('keeps a placeholder first response in the order it was given', () => {
+		const order = new DisplayedOrder();
+		expect(ids(show(order, 'a', [row('2'), row('1')], true))).toEqual(['2', '1']);
+		expect(ids(show(order, 'a', [row('1'), row('2')]))).toEqual(['1', '2']);
+	});
+});
