+// FailQueued changes only the named rows of the named job that are still queued.
+func TestImportJobIntegration_FailQueuedIsScopedToJobRowsAndStatus(t *testing.T) {
+	f := newImportJobFixture(t)
+	ctx := context.Background()
+	job := f.newJob(t)
+	other := f.newJob(t)
+	require.NoError(t, f.repo.UpsertItems(ctx, []*domain.ImportItemWithDetails{f.videoItem(job, 1), f.videoItem(job, 2), f.videoItem(job, 3)}))
+	require.NoError(t, f.repo.UpsertItems(ctx, []*domain.ImportItemWithDetails{f.videoItem(other, 4)}))
+	items, err := f.repo.ListItems(ctx, job.ID)
+	require.NoError(t, err)
+	otherItems, err := f.repo.ListItems(ctx, other.ID)
+	require.NoError(t, err)
+	named, notNamed, imported, otherJob := items[0].ID, items[1].ID, items[2].ID, otherItems[0].ID
+
+	_, err = f.repo.MarkQueued(ctx, job.ID, []int{named, notNamed, imported})
+	require.NoError(t, err)
+	_, err = f.repo.MarkQueued(ctx, other.ID, []int{otherJob})
+	require.NoError(t, err)
+	require.NoError(t, f.repo.RecordOutcome(ctx, imported, domain.ImportItemStatusImported, nil, nil))
+
+	c := querycount.Attach(t, f.db)
+	failed, err := f.repo.FailQueued(ctx, job.ID, []int{named, imported, otherJob}, "cut short")
+	require.NoError(t, err)
+	c.AssertExactly(t, 1)
+	assert.Equal(t, 1, failed, "an imported row, a row of another job and an unnamed row are not changed")
+
+	listed, err := f.repo.ListItems(ctx, job.ID)
+	require.NoError(t, err)
+	byID := map[int]*domain.ImportItem{}
+	for _, it := range listed {
+		byID[it.ID] = it
+	}
+	assert.Equal(t, domain.ImportItemStatusFailed, *byID[named].ImportStatus)
+	require.NotNil(t, byID[named].ImportError)
+	assert.Equal(t, "cut short", *byID[named].ImportError)
+	assert.Equal(t, domain.ImportItemStatusQueued, *byID[notNamed].ImportStatus)
+	assert.Equal(t, domain.ImportItemStatusImported, *byID[imported].ImportStatus)
+	otherListed, err := f.repo.ListItems(ctx, other.ID)
+	require.NoError(t, err)
+	assert.Equal(t, domain.ImportItemStatusQueued, *otherListed[0].ImportStatus)
+
+	c.Reset()
+	none, err := f.repo.FailQueued(ctx, job.ID, nil, "cut short")
+	require.NoError(t, err)
+	assert.Zero(t, none)
+	c.AssertExactly(t, 0)
+
+	// The failed row can be queued again.
+	requeued, err := f.repo.MarkQueued(ctx, job.ID, []int{named})
+	require.NoError(t, err)
+	assert.Equal(t, []int{named}, requeued)
+}
