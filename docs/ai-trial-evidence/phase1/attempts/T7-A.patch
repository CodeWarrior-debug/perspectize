+// ---------------------------------------------------------------------------
+// otherTypeSwitches / switchTypeFilter (Library one-click type switching)
+// ---------------------------------------------------------------------------
+
+describe('otherTypeSwitches', () => {
+	const values = (filters: Record<string, string>) => otherTypeSwitches(filters)?.map((o) => o.value);
+
+	it('offers every other type, in filter order, when one type is shown', () => {
+		const everyType = CONTENT_TYPE_OPTIONS.map((o) => o.value);
+		expect(values({ type: 'movie' })).toEqual(everyType.filter((v) => v !== 'movie'));
+	});
+
+	it('carries the label the Type filter uses', () => {
+		expect(otherTypeSwitches({ type: 'youtube_video' })).toContainEqual({ value: 'web_page', label: 'Webpage' });
+	});
+
+	it('never offers the type already shown', () => {
+		for (const { value } of CONTENT_TYPE_OPTIONS) {
+			expect(values({ type: value })).not.toContain(value);
+		}
+	});
+
+	it('offers a switch from the default Library filter', () => {
+		expect(otherTypeSwitches(GRID_DEFAULTS.filters)).not.toBeNull();
+	});
+
+	it('offers nothing when no type filter is set', () => {
+		expect(otherTypeSwitches({})).toBeNull();
+		expect(otherTypeSwitches({ type: '' })).toBeNull();
+		expect(otherTypeSwitches({ user: 'ann' })).toBeNull();
+	});
+
+	it('offers nothing when several types are shown', () => {
+		expect(otherTypeSwitches({ type: 'movie,book' })).toBeNull();
+	});
+
+	it('treats the legacy `youtube` alias as the YouTube type', () => {
+		expect(values({ type: 'youtube' })).not.toContain('youtube_video');
+		expect(values({ type: 'youtube' })).toContain('movie');
+	});
+
+	it('counts one type repeated, in any case or spacing, as one type', () => {
+		expect(values({ type: 'Movie, movie' })).not.toContain('movie');
+		expect(values({ type: 'Movie, movie' })).toContain('book');
+	});
+
+	it('ignores unknown values, as the server request does', () => {
+		expect(otherTypeSwitches({ type: 'bogus' })).toBeNull();
+		expect(values({ type: 'bogus,book' })).not.toContain('book');
+		expect(values({ type: 'bogus,book' })).toContain('movie');
+	});
+});
