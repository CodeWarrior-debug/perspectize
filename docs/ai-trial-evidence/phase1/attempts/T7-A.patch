 	return a.length === b.length && a.every((s) => b.includes(s));
 }
 
+// ---------------------------------------------------------------------------
+// One-click type switching (Library page)
+// ---------------------------------------------------------------------------
+
+/**
+ * The type filters worth offering as one-click switches: every content type except the one shown,
+ * in CONTENT_TYPE_OPTIONS order, but only while the `f.type` URL value names exactly one known type.
+ * Returns null when it names none or several (the table already mixes types, and the column
+ * callout nudges the user to pick one). Unknown values count for nothing, as in
+ * `urlParamsToGraphQLFilter`, so `f.type=bogus` shows every type and offers no switch.
+ */
+export function otherTypeSwitches(filters: Record<string, string>): { value: string; label: string }[] | null {
+	const known = new Set(CONTENT_TYPE_OPTIONS.map((o) => o.value));
+	const shown = parseSetValue(filters.type ?? '').filter((v) => known.has(v));
+	if (shown.length !== 1) return null;
+	return CONTENT_TYPE_OPTIONS.filter((o) => o.value !== shown[0]);
+}
+
+/**
+ * `params` narrowed to the single content type `type` (a CONTENT_TYPE_OPTIONS value), back on page 1.
+ * Every other filter and the sort stay. The search scopes follow the type: an untouched selection
+ * moves to the new type's defaults (Cast/Director join or leave with Movie) and a customised one
+ * keeps what the new type still offers, so the URL never carries a hidden scope.
+ */
+export function switchTypeFilter(params: GridParams, type: string): GridParams {
+	const filters = { ...params.filters, type };
+	const offered = searchScopesFor(filters);
+	const untouched = sameScopes(params.qFields, searchScopesFor(params.filters));
+	const kept = params.qFields.filter((s) => offered.includes(s));
+	return { ...params, filters, page: 1, qFields: untouched || kept.length === 0 ? offered : kept };
+}
+
