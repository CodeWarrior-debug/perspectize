 	return `${book.name} ${range.startChapter}:${range.startVerse}-${range.endChapter}:${range.endVerse}`;
 }
 
+/**
+ * The BSB stores a verse it leaves out of its main text (the content sits in a footnote)
+ * with empty text, so an empty string means "omitted", not "not loaded".
+ */
+export function isOmittedVerse(verse: { text: string }): boolean {
+	return verse.text.trim() === '';
+}
+
+/** True when there is at least one verse and every one of them is omitted (nothing to read inline). */
+export function isOmittedPassage(verses: ReadonlyArray<{ text: string }>): boolean {
+	return verses.length > 0 && verses.every((v) => isOmittedVerse(v));
+}
