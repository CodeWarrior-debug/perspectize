@@ -0,0 +1,227 @@
+/**
+ * Row order memory for the Activity list. An edit bumps a row's updatedAt, so the refetch of the
+ * same list returns it first; the memory re-applies the order shown last for the same query key
+ * so the row stays where the user is looking. New rows still lead; a new key starts from the
+ * server order; placeholder rows are neither applied nor recorded.
+ */
+import { describe, it, expect, vi } from 'vitest';
+import { hashKey, keepPreviousData, QueryObserver } from '@tanstack/svelte-query';
+import { createRowOrderMemory, keepRowOrder } from '$lib/utils/rowOrder';
+import { activityListRequest } from '$lib/queries/content';
+import { parseGridParams } from '$lib/utils/gridUrlState';
+import { makeClient } from '../helpers/queryBudget';
+
+const row = (id: string, extra: Record<string, unknown> = {}) => ({ id, ...extra });
+const idsOf = (rows: { id: string | number }[]) => rows.map((r) => String(r.id));
+const rows = (...ids: string[]) => ids.map((id) => row(id));
+/** Polls until `condition` holds (query results settle on a later tick). */
+const settled = (condition: () => boolean) => vi.waitFor(() => expect(condition()).toBe(true));
+
+describe('keepRowOrder', () => {
+	it('puts known rows in the remembered order, whatever order the server sent', () => {
+		expect(idsOf(keepRowOrder(rows('c', 'a', 'b'), ['a', 'b', 'c']))).toEqual(['a', 'b', 'c']);
+	});
+
+	it('leads with rows it has not seen, in the order they arrived', () => {
+		expect(idsOf(keepRowOrder(rows('n2', 'n1', 'b', 'a'), ['a', 'b']))).toEqual(['n2', 'n1', 'a', 'b']);
+	});
+
+	it('drops remembered ids that have no row any more, without leaving a gap', () => {
+		expect(idsOf(keepRowOrder(rows('c', 'a'), ['a', 'gone', 'c']))).toEqual(['a', 'c']);
+	});
+
+	it('returns the server order when nothing is remembered', () => {
+		expect(idsOf(keepRowOrder(rows('b', 'a', 'c'), []))).toEqual(['b', 'a', 'c']);
+	});
+
+	it('returns an empty list for no rows', () => {
+		expect(keepRowOrder([], ['a', 'b'])).toEqual([]);
+	});
+
+	it('compares ids as strings, so a numeric id matches its remembered string', () => {
+		const result = keepRowOrder([{ id: 2 }, { id: 1 }], ['1', '2']);
+		expect(result.map((r) => r.id)).toEqual([1, 2]);
+	});
+
+	it('keeps the row objects themselves (fresh data, not the remembered rows)', () => {
+		const edited = row('a', { title: 'edited' });
+		const result = keepRowOrder([edited, row('b')], ['b', 'a']);
+		expect(result[1]).toBe(edited);
+	});
+
+	it('keeps arrival order for a repeated id', () => {
+		const first = row('a', { n: 1 });
+		const second = row('a', { n: 2 });
+		expect(keepRowOrder([first, row('b'), second], ['b', 'a'])).toEqual([row('b'), first, second]);
+	});
+
+	it('does not mutate its inputs and returns a new array', () => {
+		const input = rows('b', 'a');
+		const ids = ['a', 'b'];
+		const result = keepRowOrder(input, ids);
+		expect(result).not.toBe(input);
+		expect(idsOf(input)).toEqual(['b', 'a']);
+		expect(ids).toEqual(['a', 'b']);
+	});
+});
+
+describe('createRowOrderMemory', () => {
+	it('starts from the server order on the first call for a key', () => {
+		const memory = createRowOrderMemory();
+		expect(idsOf(memory.arrange('k', rows('c', 'b', 'a')))).toEqual(['c', 'b', 'a']);
+	});
+
+	it('keeps the displayed order when an edited row comes back first on a refetch', () => {
+		const memory = createRowOrderMemory();
+		memory.arrange('k', rows('a', 'b', 'c', 'd'));
+		// The user edits "c": the server now sorts it first.
+		expect(idsOf(memory.arrange('k', rows('c', 'a', 'b', 'd')))).toEqual(['a', 'b', 'c', 'd']);
+	});
+
+	it('shows the edited values at the old position', () => {
+		const memory = createRowOrderMemory();
+		memory.arrange('k', rows('a', 'b', 'c'));
+		const refetched = [row('c', { rating: 9 }), row('a'), row('b')];
+		expect(memory.arrange('k', refetched)[2]).toEqual(row('c', { rating: 9 }));
+	});
+
+	it('keeps holding the order across successive refetches of the same key', () => {
+		const memory = createRowOrderMemory();
+		memory.arrange('k', rows('a', 'b', 'c'));
+		memory.arrange('k', rows('b', 'a', 'c'));
+		expect(idsOf(memory.arrange('k', rows('c', 'b', 'a')))).toEqual(['a', 'b', 'c']);
+	});
+
+	it('is idempotent: the same rows again give the same order', () => {
+		const memory = createRowOrderMemory();
+		memory.arrange('k', rows('a', 'b', 'c'));
+		const refetched = rows('c', 'a', 'b');
+		const once = idsOf(memory.arrange('k', refetched));
+		expect(idsOf(memory.arrange('k', refetched))).toEqual(once);
+	});
+
+	it('leads with a new row and keeps the rest where they were', () => {
+		const memory = createRowOrderMemory();
+		memory.arrange('k', rows('a', 'b', 'c'));
+		expect(idsOf(memory.arrange('k', rows('new', 'c', 'a', 'b')))).toEqual(['new', 'a', 'b', 'c']);
+		// the new row is now part of the remembered order, not "new" again
+		expect(idsOf(memory.arrange('k', rows('c', 'new', 'a', 'b')))).toEqual(['new', 'a', 'b', 'c']);
+	});
+
+	it('forgets a deleted row, so a row that reappears is new and leads', () => {
+		const memory = createRowOrderMemory();
+		memory.arrange('k', rows('a', 'b', 'c'));
+		memory.arrange('k', rows('a', 'c'));
+		expect(idsOf(memory.arrange('k', rows('a', 'b', 'c')))).toEqual(['b', 'a', 'c']);
+	});
+
+	it('starts from the server order when the key changes', () => {
+		const memory = createRowOrderMemory();
+		memory.arrange('page-1', rows('a', 'b', 'c'));
+		expect(idsOf(memory.arrange('page-2', rows('c', 'a', 'b')))).toEqual(['c', 'a', 'b']);
+	});
+
+	it('does not bring an earlier key back: returning to it starts from the server order', () => {
+		const memory = createRowOrderMemory();
+		memory.arrange('one', rows('a', 'b', 'c'));
+		memory.arrange('two', rows('x', 'y'));
+		expect(idsOf(memory.arrange('one', rows('c', 'a', 'b')))).toEqual(['c', 'a', 'b']);
+	});
+
+	describe('placeholder rows', () => {
+		it('are returned untouched and not re-ordered', () => {
+			const memory = createRowOrderMemory();
+			memory.arrange('page-1', rows('a', 'b', 'c'));
+			const placeholder = rows('c', 'b', 'a');
+			expect(memory.arrange('page-2', placeholder, true)).toBe(placeholder);
+		});
+
+		it('are not recorded: the loaded rows for that key start from the server order', () => {
+			const memory = createRowOrderMemory();
+			memory.arrange('page-1', rows('a', 'b', 'c'));
+			memory.arrange('page-2', rows('c', 'b', 'a'), true);
+			expect(idsOf(memory.arrange('page-2', rows('x', 'y', 'z')))).toEqual(['x', 'y', 'z']);
+		});
+
+		it('do not disturb the order held for the key still in view', () => {
+			const memory = createRowOrderMemory();
+			memory.arrange('page-1', rows('a', 'b', 'c'));
+			memory.arrange('page-2', rows('p', 'q'), true);
+			expect(idsOf(memory.arrange('page-1', rows('c', 'a', 'b')))).toEqual(['a', 'b', 'c']);
+		});
+
+		it('are not applied even when the key matches what is held', () => {
+			const memory = createRowOrderMemory();
+			memory.arrange('k', rows('a', 'b', 'c'));
+			expect(idsOf(memory.arrange('k', rows('c', 'b', 'a'), true))).toEqual(['c', 'b', 'a']);
+		});
+	});
+
+	describe('reset', () => {
+		it('forgets the held order, so the next call starts from the server order', () => {
+			const memory = createRowOrderMemory();
+			memory.arrange('k', rows('a', 'b', 'c'));
+			memory.reset();
+			expect(idsOf(memory.arrange('k', rows('c', 'a', 'b')))).toEqual(['c', 'a', 'b']);
+		});
+	});
+
+	it('keeps separate memories independent', () => {
+		const first = createRowOrderMemory();
+		const second = createRowOrderMemory();
+		first.arrange('k', rows('a', 'b'));
+		expect(idsOf(second.arrange('k', rows('b', 'a')))).toEqual(['b', 'a']);
+	});
+});
+
+describe('with a real query: how ActivityTable feeds the memory', () => {
+	const request = (qs: string) => activityListRequest(parseGridParams(new URLSearchParams(qs)), null);
+	const keyOf = (qs: string) => hashKey(request(qs).queryKey);
+
+	/** What ActivityTable does on each render: key hash + isPlaceholderData from the live result. */
+	function shown(
+		memory: ReturnType<typeof createRowOrderMemory>,
+		observer: { getCurrentResult(): { data?: { items: { id: string }[] }; isPlaceholderData: boolean } },
+		qs: string,
+	) {
+		const result = observer.getCurrentResult();
+		return idsOf(memory.arrange(keyOf(qs), result.data?.items ?? [], result.isPlaceholderData));
+	}
+
+	it('holds the order across an invalidate-and-refetch, and resets on a new key (placeholder skipped)', async () => {
+		const client = makeClient();
+		const server: Record<string, string[]> = {
+			'': ['a', 'b', 'c'],
+			'q=zzz': ['z2', 'z1'],
+		};
+		const options = (qs: string) => ({
+			queryKey: request(qs).queryKey,
+			queryFn: async () => ({ items: (server[qs] ?? []).map((id) => ({ id })) }),
+			placeholderData: keepPreviousData,
+		});
+
+		const observer = new QueryObserver(client, options(''));
+		const unsubscribe = observer.subscribe(() => {});
+		const memory = createRowOrderMemory();
+
+		await settled(() => !observer.getCurrentResult().isPending);
+		expect(shown(memory, observer, '')).toEqual(['a', 'b', 'c']);
+
+		// The user edits "c"; the server now returns it first and the list refetches.
+		server[''] = ['c', 'a', 'b'];
+		await client.invalidateQueries({ queryKey: request('').queryKey });
+		await settled(() => observer.getCurrentResult().data?.items[0].id === 'c');
+		expect(shown(memory, observer, '')).toEqual(['a', 'b', 'c']);
+
+		// A new search switches the key: the previous rows are placeholder, so they are left alone.
+		observer.setOptions(options('q=zzz'));
+		const loading = observer.getCurrentResult();
+		expect(loading.isPlaceholderData).toBe(true);
+		expect(shown(memory, observer, 'q=zzz')).toEqual(['c', 'a', 'b']);
+
+		// Loaded: the new key starts from the server order.
+		await settled(() => !observer.getCurrentResult().isPlaceholderData);
+		expect(shown(memory, observer, 'q=zzz')).toEqual(['z2', 'z1']);
+		unsubscribe();
+	});
+});
