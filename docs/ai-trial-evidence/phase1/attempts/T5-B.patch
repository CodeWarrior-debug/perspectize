@@ -0,0 +1,73 @@
+/**
+ * Keeps a list's displayed row order steady across refetches of the same query.
+ *
+ * The Library list comes back ordered by the server (default updatedAt desc), so editing a row
+ * bumps its updatedAt and the refetch returns it first: the row jumps out of view and the user
+ * loses their place. The memory below remembers the order last shown for a query key and re-applies
+ * it to later data for that key. Rows the memory has not seen lead (they are the newest, which is
+ * where the default sort puts them); rows that are gone drop out.
+ *
+ * Pure: no runes and no query client, so it unit-tests without a component.
+ */
+
+/** Anything with an id: GraphQL ids are strings, grid rows may carry numbers. Ids compare as strings. */
+export type RowWithId = { id: string | number };
+
+/**
+ * `rows` rearranged to follow `ids` (the order shown last time).
+ *
+ * - A row whose id is in `ids` keeps its place relative to the others in `ids`.
+ * - A row whose id is not in `ids` is new: it goes first, in the order it arrived.
+ * - An id with no matching row is ignored.
+ *
+ * Returns a new array; `rows` is never mutated.
+ */
+export function keepRowOrder<T extends RowWithId>(rows: T[], ids: string[]): T[] {
+	const rank = new Map<string, number>();
+	ids.forEach((id, index) => {
+		if (!rank.has(id)) rank.set(id, index);
+	});
+
+	const fresh: T[] = [];
+	const known: T[] = [];
+	for (const row of rows) (rank.has(String(row.id)) ? known : fresh).push(row);
+
+	// Array.prototype.sort is stable, so duplicate ids (and ties) keep their arrival order.
+	known.sort((a, b) => rank.get(String(a.id))! - rank.get(String(b.id))!);
+	return [...fresh, ...known];
+}
+
+export interface RowOrderMemory {
+	/**
+	 * `rows` in the order to display for the query `key`, recording that order for the next call.
+	 *
+	 * The memory holds one key: a call with a different key starts from the order the server
+	 * sent (a new sort, filter, search or page) and replaces what was held. Calling again with the
+	 * same key and rows returns the same order, so it is safe to call from a `$derived`.
+	 *
+	 * `placeholder` marks rows that belong to a previous key (keepPreviousData while the new key
+	 * loads): they are returned untouched and neither read from nor written to the memory.
+	 */
+	arrange<T extends RowWithId>(key: string, rows: T[], placeholder?: boolean): T[];
+	/** Forgets the recorded order, so the next call starts from the server order. */
+	reset(): void;
+}
+
+export function createRowOrderMemory(): RowOrderMemory {
+	let heldKey: string | null = null;
+	let heldIds: string[] = [];
+
+	return {
+		arrange(key, rows, placeholder = false) {
+			if (placeholder) return rows;
+			const arranged = keepRowOrder(rows, key === heldKey ? heldIds : []);
+			heldKey = key;
+			heldIds = arranged.map((row) => String(row.id));
+			return arranged;
+		},
+		reset() {
+			heldKey = null;
+			heldIds = [];
+		},
+	};
+}
diff --git a/frontend/tests/unit/rowOrder.test.ts b/frontend/tests/unit/rowOrder.test.ts
