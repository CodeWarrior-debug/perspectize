+func TestGormImportJobRepository_FailQueuedItems_WrapsDatabaseError(t *testing.T) {
+	db, mock := newMockDB(t)
+	repo := NewGormImportJobRepository(db)
+
+	boom := errors.New("connection reset")
+	mock.ExpectExec(`UPDATE "import_job_items"`).WillReturnError(boom)
+
+	failed, err := repo.FailQueuedItems(context.Background(), 7, []int{11}, "cut short")
