+// FailQueuedItems mirrors the SQL: only the named rows of the job that are still
+// queued change. Each call is kept so a test can count the statements.
+func (r *fakeImportRepo) FailQueuedItems(_ context.Context, jobID int, ids []int, detail string) (int, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.failQueuedCalls = append(r.failQueuedCalls, failQueuedCall{jobID: jobID, ids: append([]int(nil), ids...), detail: detail})
+	n := 0
+	for _, id := range ids {
+		it, ok := r.items[id]
+		if !ok || it.Item.JobID != jobID {
+			continue
+		}
+		if st := it.Item.ImportStatus; st != nil && *st == domain.ImportItemStatusQueued {
+			failed := domain.ImportItemStatusFailed
+			it.Item.ImportStatus, it.Item.ImportError = &failed, &detail
+			n++
+		}
+	}
+	return n, nil
+}
