+// status, and it reports how many rows that changed. These run on go-sqlmock, so
+// they check the statement without a database.
+func TestGormImportJobRepository_FailQueuedItems_OneScopedUpdate(t *testing.T) {
+	db, mock := newMockDB(t)
+	repo := NewGormImportJobRepository(db)
+	c := querycount.Attach(t, db)
+
+	mock.ExpectExec(`UPDATE "import_job_items" SET "import_error"=\$1,"import_status"=\$2,"updated_at"=\$3 WHERE job_id = \$4 AND id = ANY\(CAST\(\$5 AS bigint\[\]\)\) AND import_status = 'queued'`).
